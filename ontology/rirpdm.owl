  </rdf:Description>
  <rdf:Description rdf:nodeID="n1d0daad76aea4869b9e80e485ed3dbf8b111">
    <rdf:first rdf:resource="http://www.example.org/rirpdm#Revenues"/>
    <rdf:rest rdf:nodeID="n1d0daad76aea4869b9e80e485ed3dbf8b112"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdm#resultsInProject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">resultsInProject</rdfs:label>
    <rdfs:comment xml:lang="en">The transition from a Proposal to the resulting selected RI; carries ex ante to ex post.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.example.org/rirpdm#Proposal"/>
    <rdfs:range rdf:nodeID="n1d0daad76aea4869b9e80e485ed3dbf8b131"/>
    <rirpdm:status>New</rirpdm:status>
    <dcterms:source>ESFRI Roadmap 2026</dcterms:source>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/cerif/frapo/Grant">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Grant</rdfs:label>
    <rdfs:comment xml:lang="en">A sum of money awarded by a funding agency to support a specific project or activity.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://purl.org/cerif/frapo/Funding"/>
    <skos:exactMatch rdf:resource="https://w3id.org/cerif/vocab/ActivityFundingTypes#Grant"/>
    <rirpdm:status>Adopted</rirpdm:status>
    <dcterms:source>FRAPO</dcterms:source>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1d0daad76aea4869b9e80e485ed3dbf8b101">
    <rdf:first rdf:resource="http://www.example.org/rirpdm#IncomeFromCommercialActivities"/>
    <rdf:rest rdf:nodeID="n1d0daad76aea4869b9e80e485ed3dbf8b102"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdm#RFO">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Research Funding Organisation (RFO)</rdfs:label>
    <rdfs:comment xml:lang="en">Legal entity that can take binding decisions to financially support an RI.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/org#Organization"/>
    <rdfs:subClassOf rdf:resource="http://purl.org/cerif/frapo/FundingAgency"/>
    <rirpdm:status>Extended</rirpdm:status>
    <dcterms:source>ESFRI Roadmap 2026</dcterms:source>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdm#hasLeadEntity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">hasLeadEntity</rdfs:label>
    <rdfs:comment xml:lang="en">The agent leading the research infrastructure.</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.example.org/rirpdm#involvesAgent"/>
    <rdfs:domain rdf:resource="http://www.example.org/rirpdm#ResearchInfrastructure"/>
    <rdfs:range rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
    <rirpdm:status>New</rirpdm:status>
    <dcterms:source>ESFRI Roadmap 2026</dcterms:source>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1d0daad76aea4869b9e80e485ed3dbf8b151">
    <rdf:first rdf:resource="http://www.example.org/rirpdm#isSupportedBy"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdm#hasCentralHub">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">hasCentralHub</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a distributed RI to its Central Hub, the truly international organisation that must guarantee effective operation, attribute optimal personnel capacity and coordinating power, and mediate across different scientific cultures. (ESFRI Roadmap 2026, p.15-16)</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.example.org/rirpdm#DistributedRI"/>
    <rdfs:range rdf:resource="http://www.example.org/rirpdm#CentralHub"/>
    <rirpdm:status>New</rirpdm:status>
    <dcterms:source>ESFRI Roadmap 2026</dcterms:source>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdm#NumberOfPubliclyAvailableDataSetsUsedExternally">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.example.org/rirpdm#KPI"/>
    <rdfs:label xml:lang="en">Number of publicly available data sets used externally</rdfs:label>
    <rdfs:comment xml:lang="en">Number of data sets produced as a consequence of access to the RI that are subsequently accessed by other users.</rdfs:comment>
    <rirpdm:forObjective rdf:resource="http://www.example.org/rirpdm#OptimisingDataUse"/>
    <rirpdm:unitOfMeasure>Number of data users</rirpdm:unitOfMeasure>
    <rirpdm:status>New</rirpdm:status>
    <dcterms:source>ESFRI WG Monitoring Report 2019, Annex 5 KPI 14</dcterms:source>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdm#producesResearchOutput">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">producesResearchOutput</rdfs:label>
    <rdfs:comment xml:lang="en">A research output produced by the research infrastructure.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.example.org/rirpdm#ResearchInfrastructure"/>
    <rdfs:range rdf:resource="http://www.example.org/rirpdm#ResearchOutput"/>
    <rirpdm:status>New</rirpdm:status>
    <dcterms:source>EU Reg 2021 Art 2(22); Annex I(1)(c)</dcterms:source>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdm#dataManagementSystem">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">dataManagementSystem</rdfs:label>
    <rdfs:comment xml:lang="en">The RI's system for metadata, storage, retrieval and data reduction/analysis.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.example.org/rirpdm#ResearchInfrastructure"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rirpdm:status>New</rirpdm:status>
    <dcterms:source>ESFRI Roadmap 2026</dcterms:source>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdm#ResearchOutput">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Research Output</rdfs:label>
    <rdfs:comment xml:lang="en">Results of an action accessible as scientific publications, data, software, algorithms, protocols, etc.</rdfs:comment>
    <rirpdm:status>New</rirpdm:status>
    <dcterms:source>EU Reg 2021 Art 2(22)</dcterms:source>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdm#ScientificDimension">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Scientific Dimension</rdfs:label>
    <rdfs:comment xml:lang="en">One of the six dimensions along which a Scientific Case is assessed.</rdfs:comment>
    <owl:equivalentClass rdf:nodeID="n1d0daad76aea4869b9e80e485ed3dbf8b15"/>
    <rirpdm:status>New</rirpdm:status>
    <dcterms:source>ESFRI Roadmap 2026</dcterms:source>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1d0daad76aea4869b9e80e485ed3dbf8b73">
    <rdf:first rdf:resource="http://www.example.org/rirpdm#NumberOfPublications"/>
    <rdf:rest rdf:nodeID="n1d0daad76aea4869b9e80e485ed3dbf8b74"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdm#authorOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">authorOf</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a researcher to a scientific publication they authored.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.example.org/rirpdm#Researcher"/>
    <rdfs:range rdf:resource="http://www.example.org/rirpdm#ScientificPublication"/>
    <owl:inverseOf rdf:resource="http://www.example.org/rirpdm#hasAuthor"/>
    <rirpdm:status>Extended</rirpdm:status>
    <dcterms:source>VIVO</dcterms:source>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1d0daad76aea4869b9e80e485ed3dbf8b160">
    <rdf:first rdf:resource="http://purl.org/spar/fabio/hasDOI"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1d0daad76aea4869b9e80e485ed3dbf8b118">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://www.example.org/rirpdm#hasNode"/>
    <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</owl:minCardinality>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdm#ProvisionOfScientificAdvice">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.example.org/rirpdm#KPIObjective"/>
    <rdfs:label xml:lang="en">Provision of Scientific Advice</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdm#NumberOfNonESFRIMembers">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.example.org/rirpdm#KPI"/>
    <rdfs:label xml:lang="en">Number of members of the RI from non-ESFRI countries</rdfs:label>
    <rdfs:comment xml:lang="en">Number of organisations/countries with a formal engagement based in a non-ESFRI member country.</rdfs:comment>
    <rirpdm:forObjective rdf:resource="http://www.example.org/rirpdm#FacilitatingInternationalCooperation"/>
    <rirpdm:unitOfMeasure>Number</rirpdm:unitOfMeasure>
    <rirpdm:status>New</rirpdm:status>
    <dcterms:source>ESFRI WG Monitoring Report 2019, Annex 5 KPI 19</dcterms:source>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdm#Revenues">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.example.org/rirpdm#KPI"/>
    <rdfs:label xml:lang="en">Revenues</rdfs:label>
    <rdfs:comment xml:lang="en">Sources of revenue (member contributions, third-party contributions, project funding, commercial revenue, other) and their contributions to investment and operational costs.</rdfs:comment>
    <rirpdm:forObjective rdf:resource="http://www.example.org/rirpdm#OptimisingManagement"/>
    <rirpdm:unitOfMeasure>Amount in national currency</rirpdm:unitOfMeasure>
    <rirpdm:status>New</rirpdm:status>
    <dcterms:source>ESFRI WG Monitoring Report 2019, Annex 5 KPI 20</dcterms:source>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdm#Operation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.example.org/rirpdm#LifecyclePhase"/>
    <rdfs:label xml:lang="en">Operation</rdfs:label>
    <skos:exactMatch rdf:resource="https://w3id.org/cerif/vocab/ResearchInfrastructureStatuses#InOperation"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdm#hasObserver">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">hasObserver</rdfs:label>
    <rdfs:comment xml:lang="en">An agent observing the research infrastructure.</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.example.org/rirpdm#involvesAgent"/>
    <rdfs:domain rdf:resource="http://www.example.org/rirpdm#ResearchInfrastructure"/>
    <rdfs:range rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
    <rirpdm:status>New</rirpdm:status>
    <dcterms:source>ESFRI Roadmap 2026</dcterms:source>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdm#indirectlyExposedTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">indirectlyExposedTo</rdfs:label>
    <rdfs:comment xml:lang="en">An RI is indirectly exposed to a funding source through a collaborating partner RI's funding chain. Inferred via property chain: involvesAgent o collaboratesWith o participatesIn o isSupportedBy.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.example.org/rirpdm#ResearchInfrastructure"/>
    <rdfs:range rdf:nodeID="n1d0daad76aea4869b9e80e485ed3dbf8b152"/>
    <owl:propertyChainAxiom rdf:nodeID="n1d0daad76aea4869b9e80e485ed3dbf8b156"/>
    <rirpdm:status>New</rirpdm:status>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1d0daad76aea4869b9e80e485ed3dbf8b126">
    <rdf:first rdf:resource="http://www.example.org/rirpdm#Proposal"/>
    <rdf:rest rdf:nodeID="n1d0daad76aea4869b9e80e485ed3dbf8b127"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdm#NumberOfMasterAndPhDStudentsUsingRI">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.example.org/rirpdm#KPI"/>
    <rdfs:label xml:lang="en">Number of master and PhD students using the RI</rdfs:label>
    <rdfs:comment xml:lang="en">Number of master and PhD students who have performed some of their studies at or using the services of the RI in a particular year regardless of whether they are funded/hosted by the RI or access it as a user.</rdfs:comment>
    <rirpdm:forObjective rdf:resource="http://www.example.org/rirpdm#DeliveryOfEducationAndTraining"/>
    <rirpdm:unitOfMeasure>Number</rirpdm:unitOfMeasure>
    <rirpdm:status>New</rirpdm:status>
    <dcterms:source>ESFRI WG Monitoring Report 2019, Annex 5 KPI 5</dcterms:source>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdm#CentralHub">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Central Hub</rdfs:label>
    <rdfs:comment xml:lang="en">The coordinating international organisation of a distributed RI that mediates between the nodes.</rdfs:comment>
    <rirpdm:status>New</rirpdm:status>
    <dcterms:source>ESFRI Roadmap 2026</dcterms:source>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/cerif/frapo/hasGrantNumber">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">has grant number</rdfs:label>
    <rirpdm:status>Adopted</rirpdm:status>
    <dcterms:source>FRAPO</dcterms:source>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:title xml:lang="en">Research Infrastructure and Research Publications Data Model (RIRPDM)</dcterms:title>
    <dcterms:description xml:lang="en">OWL 2 ontology for knowledge representation and reasoning over scientific research infrastructure and publications.</dcterms:description>
    <owl:versionInfo>0.1.0</owl:versionInfo>
    <dcterms:creator>Julian Paulussen</dcterms:creator>
    <rdfs:comment xml:lang="en">Imports of fabio and cito are resolved via catalog-v001.xml to locally patched copies (ontology/fabio.owl, ontology/cito.owl): upstream published files assert untyped dcterms:created/modified literals on their own ontology IRI, violating the xsd:dateTime range they themselves declare, which makes the raw remote files OWL-inconsistent (owl:Thing SubClassOf owl:Nothing). Only those two literals were retyped; no domain classes/properties/axioms were altered.</rdfs:comment>
    <owl:imports rdf:resource="http://xmlns.com/foaf/0.1/"/>
    <owl:imports rdf:resource="http://www.w3.org/2004/02/skos/core#"/>
    <owl:imports rdf:resource="http://www.w3.org/ns/org#"/>
    <owl:imports rdf:resource="http://purl.org/spar/fabio"/>
    <owl:imports rdf:resource="http://purl.org/spar/cito"/>
    <owl:imports rdf:resource="http://purl.org/cerif/frapo/"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/spar/fabio/JournalArticle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Journal Article</rdfs:label>
    <rdfs:comment xml:lang="en">A research article published in a journal issue.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.example.org/rirpdm#ScientificPublication"/>
    <skos:exactMatch rdf:resource="https://w3id.org/cerif/vocab/OutputTypes#JournalArticle"/>
    <rdfs:seeAlso rdf:resource="https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0001209"/>
    <rirpdm:status>Adopted</rirpdm:status>
    <dcterms:source>FaBiO</dcterms:source>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1d0daad76aea4869b9e80e485ed3dbf8b91">
    <rdf:first rdf:resource="http://www.example.org/rirpdm#ExtentOfResourcesMadeAvailable"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdm#NumberOfUsersServed">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.example.org/rirpdm#KPI"/>
    <rdfs:label xml:lang="en">Number of users served</rdfs:label>
    <rdfs:comment xml:lang="en">For access to facilities: number of granted proposals/accepted users. For resource RIs: number of downloads/studies or service provisions.</rdfs:comment>
    <rirpdm:forObjective rdf:resource="http://www.example.org/rirpdm#EnablingScientificExcellence"/>
    <rirpdm:unitOfMeasure>Number</rirpdm:unitOfMeasure>
    <rirpdm:status>New</rirpdm:status>
