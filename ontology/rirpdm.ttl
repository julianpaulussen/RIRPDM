@prefix rirpdm:  <http://www.example.org/rirpdm#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix org:     <http://www.w3.org/ns/org#> .
@prefix frapo:   <http://purl.org/cerif/frapo/> .
@prefix fabio:   <http://purl.org/spar/fabio/> .
@prefix cito:    <http://purl.org/spar/cito/> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix nfdicore: <https://nfdi.fiz-karlsruhe.de/ontology/> .
@prefix vivo:     <http://vivoweb.org/ontology/core#> .
@prefix cerif:    <https://w3id.org/cerif/vocab/> .
@prefix obo:      <http://purl.obolibrary.org/obo/> .
@base <http://www.example.org/rirpdm> .

#################################################################
#    Ontology
#################################################################

<http://www.example.org/rirpdm> a owl:Ontology ;
    dcterms:title "Research Infrastructure and Research Publications Data Model (RIRPDM)"@en ;
    dcterms:description "OWL 2 ontology for knowledge representation and reasoning over scientific research infrastructure and publications."@en ;
    owl:versionInfo "0.1.0" ;
    dcterms:creator "Julian Paulussen" .

#################################################################
#    Annotation properties
#################################################################

rirpdm:status a owl:AnnotationProperty ;
    rdfs:label "status"@en ;
    rdfs:comment "Editorial status of the term: New, Extended, or Adopted."@en .

#################################################################
#    Reused external classes
#################################################################

foaf:Agent a owl:Class ;
    rdfs:label "Agent"@en ;
    rdfs:seeAlso nfdicore:NFDI_0000102 ;
    rirpdm:status "Adopted" ;
    dcterms:source "FOAF" .

foaf:Person a owl:Class ;
    rdfs:label "Person"@en ;
    rdfs:subClassOf foaf:Agent ;
    rirpdm:status "Adopted" ;
    dcterms:source "FOAF" .

rirpdm:Researcher a owl:Class ;
    rdfs:label "Researcher"@en ;
    rdfs:comment "An agent who conducts scientific research, typically as a participant in a research infrastructure."@en ;
    rdfs:subClassOf foaf:Person ;
    rdfs:seeAlso vivo:ResearcherRole ;
    rdfs:seeAlso nfdicore:NFDI_0000004 ;
    rirpdm:status "Extended" ;
    dcterms:source "VIVO" .

org:Organization a owl:Class ;
    rdfs:label "Organization"@en ;
    rdfs:subClassOf foaf:Agent ;
    rdfs:seeAlso obo:OBI_0000245 ;
    rirpdm:status "Adopted" ;
    dcterms:source "W3C ORG" .

frapo:Project a owl:Class ;
    rdfs:label "Project"@en ;
    rdfs:comment "An activity undertaken to achieve defined objectives, optionally funded by one or more sources."@en ;
    rdfs:seeAlso nfdicore:NFDI_0000002 ;
    rirpdm:status "Adopted" ;
    dcterms:source "FRAPO" .

frapo:Funding a owl:Class ;
    rdfs:label "Funding"@en ;
    rdfs:comment "Financial support provided to undertake research or operate an infrastructure."@en ;
    rdfs:seeAlso nfdicore:NFDI_0001051 ;
    rirpdm:status "Adopted" ;
    dcterms:source "FRAPO" .

frapo:Grant a owl:Class ;
    rdfs:label "Grant"@en ;
    rdfs:comment "A sum of money awarded by a funding agency to support a specific project or activity."@en ;
    rdfs:subClassOf frapo:Funding ;
    skos:exactMatch <https://w3id.org/cerif/vocab/ActivityFundingTypes#Grant> ;
    rirpdm:status "Adopted" ;
    dcterms:source "FRAPO" .

frapo:FundingAgency a owl:Class ;
    rdfs:label "Funding Agency"@en ;
    rdfs:comment "An organisation that provides funding for research projects or infrastructures."@en ;
    rdfs:subClassOf org:Organization ;
    rdfs:seeAlso nfdicore:NFDI_0000139 ;
    rirpdm:status "Adopted" ;
    dcterms:source "FRAPO" .

frapo:FundingProgramme a owl:Class ;
    rdfs:label "Funding Programme"@en ;
    rdfs:comment "A structured scheme under which a funding agency awards grants."@en ;
    rirpdm:status "Adopted" ;
    dcterms:source "FRAPO" .

frapo:Budget a owl:Class ;
    rdfs:label "Budget"@en ;
    rdfs:comment "A planned allocation of financial resources for a project or infrastructure."@en ;
    rirpdm:status "Adopted" ;
    dcterms:source "FRAPO" .

frapo:Expenditure a owl:Class ;
    rdfs:label "Expenditure"@en ;
    rdfs:comment "Money actually spent against a budget."@en ;
    rirpdm:status "Adopted" ;
    dcterms:source "FRAPO" .

#################################################################
#    Research Infrastructure hierarchy
#################################################################

rirpdm:ResearchInfrastructure a owl:Class ;
    rdfs:label "Research Infrastructure"@en ;
    rdfs:comment "A facility (or set of resources/services) enabling research and innovation."@en ;
    skos:exactMatch <https://w3id.org/cerif/vocab/ResearchInfrastructure#ResearchInfrastructure> ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" , "EU Regulation 2021 Art 2" .

rirpdm:SingleSitedRI a owl:Class ;
    rdfs:label "Single-sited RI"@en ;
    rdfs:comment "An RI concentrated geographically at one site (or a few complementary sites) designed for user access. (ESFRI Roadmap 2026, p.15)"@en ;
    rdfs:subClassOf rirpdm:ResearchInfrastructure ;
    skos:exactMatch <https://w3id.org/cerif/vocab/ResearchInfrastructureTypes#SingleLocation> ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

rirpdm:DistributedRI a owl:Class ;
    rdfs:label "Distributed RI"@en ;
    rdfs:subClassOf rirpdm:ResearchInfrastructure ;
    skos:exactMatch <https://w3id.org/cerif/vocab/ResearchInfrastructureTypes#Distributed> ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

rirpdm:VirtualRI a owl:Class ;
    rdfs:label "Virtual RI"@en ;
    rdfs:subClassOf rirpdm:ResearchInfrastructure ;
    skos:exactMatch <https://w3id.org/cerif/vocab/ResearchInfrastructureTypes#Virtual> ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

# [] is doing the work of declaring the three RI types as mutually disjoint, without needing to repeat the disjointWith axiom for each pair.
[] a owl:AllDisjointClasses ;
    owl:members ( rirpdm:SingleSitedRI rirpdm:DistributedRI rirpdm:VirtualRI ) .

rirpdm:CentralHub a owl:Class ;
    rdfs:label "Central Hub"@en ;
    rdfs:comment "The coordinating international organisation of a distributed RI that mediates between the nodes."@en ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

rirpdm:NationalNode a owl:Class ;
    rdfs:label "National Node"@en ;
    rdfs:comment "A national/institutional component of a distributed RI whose RI-dedicated capacity and resources are identified, coordinated and managed by the Central Hub."@en ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

#################################################################
#    ESFRI Roadmap status classes
#################################################################

rirpdm:ESFRIProject a owl:Class ;
    rdfs:label "ESFRI Project"@en ;
    rdfs:comment "A selected RI in its Preparation Phase, expected to reach Implementation within ten years."@en ;
    rdfs:subClassOf rirpdm:ResearchInfrastructure ;
    owl:disjointWith rirpdm:ESFRILandmark ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

rirpdm:ESFRILandmark a owl:Class ;
    rdfs:label "ESFRI Landmark"@en ;
    rdfs:comment "An implemented (or near-implemented) RI established as a major asset of the European Research Area, periodically monitored."@en ;
    rdfs:subClassOf rirpdm:ResearchInfrastructure ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

#################################################################
#    Proposals
#################################################################

rirpdm:Proposal a owl:Class ;
    rdfs:label "Proposal"@en ;
    rdfs:comment "Abstract parent for candidate submissions to the Roadmap."@en ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

rirpdm:NewProposal a owl:Class ;
    rdfs:label "New Proposal"@en ;
    rdfs:comment "A candidate RI project submitted for selection onto the Roadmap."@en ;
    rdfs:subClassOf rirpdm:Proposal ;
    owl:disjointWith rirpdm:MajorUpgrade ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

rirpdm:MajorUpgrade a owl:Class ;
    rdfs:label "Major Upgrade"@en ;
    rdfs:comment "A transformative (not routine) upgrade to an operational RI."@en ;
    rdfs:subClassOf rirpdm:Proposal ;
    rdfs:seeAlso <https://w3id.org/cerif/vocab/ResearchInfrastructureStatuses#BeingUpgraded> ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

#################################################################
#    Lifecycle Phase (enumerated)
#################################################################

rirpdm:LifecyclePhase a owl:Class ;
    rdfs:label "Lifecycle Phase"@en ;
    rdfs:comment "Reference to understand the needs and targets of RIs at a given time and at various levels."@en ;
    owl:equivalentClass [ a owl:Class ;
        owl:oneOf ( rirpdm:Concept rirpdm:Design rirpdm:Preparation
                    rirpdm:Implementation rirpdm:Operation rirpdm:Termination ) ] ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

# Declaring individuals for each lifecycle phase, because a RI can only be in one phase at a time 
rirpdm:Concept        a owl:NamedIndividual , rirpdm:LifecyclePhase ; rdfs:label "Concept"@en .
rirpdm:Design         a owl:NamedIndividual , rirpdm:LifecyclePhase ; rdfs:label "Design"@en .
rirpdm:Preparation    a owl:NamedIndividual , rirpdm:LifecyclePhase ; rdfs:label "Preparation"@en .
rirpdm:Implementation a owl:NamedIndividual , rirpdm:LifecyclePhase ; rdfs:label "Implementation"@en ; skos:closeMatch <https://w3id.org/cerif/vocab/ResearchInfrastructureStatuses#UnderConstruction> .
rirpdm:Operation      a owl:NamedIndividual , rirpdm:LifecyclePhase ; rdfs:label "Operation"@en ; skos:exactMatch <https://w3id.org/cerif/vocab/ResearchInfrastructureStatuses#InOperation> .
rirpdm:Termination    a owl:NamedIndividual , rirpdm:LifecyclePhase ; rdfs:label "Termination"@en .

#################################################################
#    Scientific Case  (per-proposal/per-RI assessment object)
#    The six scientific dimensions are modelled separately as the
#    enumerated class ScientificDimension; an Evaluation links a
#    case to a dimension, score and lifecycle phase.
#################################################################

rirpdm:ScientificCase a owl:Class ;
    rdfs:label "Scientific Case"@en ;
    rdfs:comment "The six-dimension assessment of an RI's scientific merit, attached to a Proposal or Research Infrastructure."@en ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

rirpdm:ScientificDimension a owl:Class ;
    rdfs:label "Scientific Dimension"@en ;
    rdfs:comment "One of the six dimensions along which a Scientific Case is assessed."@en ;
    owl:equivalentClass [ a owl:Class ;
        owl:oneOf ( rirpdm:ScientificExcellence rirpdm:PanEuropeanRelevance
                    rirpdm:SocioEconomicImpact rirpdm:UserStrategyAndAccessPolicy
                    rirpdm:ENeedsAndData rirpdm:EnvironmentalConsiderations ) ] ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

rirpdm:ScientificExcellence        a owl:NamedIndividual , rirpdm:ScientificDimension ; rdfs:label "Scientific Excellence"@en .
rirpdm:PanEuropeanRelevance        a owl:NamedIndividual , rirpdm:ScientificDimension ; rdfs:label "Pan-European Relevance"@en .
rirpdm:SocioEconomicImpact         a owl:NamedIndividual , rirpdm:ScientificDimension ; rdfs:label "Socio-Economic Impact"@en .
rirpdm:UserStrategyAndAccessPolicy a owl:NamedIndividual , rirpdm:ScientificDimension ; rdfs:label "User Strategy & Access Policy"@en .
rirpdm:ENeedsAndData               a owl:NamedIndividual , rirpdm:ScientificDimension ; rdfs:label "E-Needs & Data"@en .
rirpdm:EnvironmentalConsiderations a owl:NamedIndividual , rirpdm:ScientificDimension ; rdfs:label "Environmental Considerations"@en .

#################################################################
#    Implementation Case  (per-proposal/per-RI assessment object)
#    The five implementation dimensions are the enumerated class
#    ImplementationDimension.
#################################################################

rirpdm:ImplementationCase a owl:Class ;
    rdfs:label "Implementation Case"@en ;
    rdfs:comment "The five-dimension assessment of an RI's feasibility and delivery, attached to a Proposal or Research Infrastructure."@en ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

rirpdm:ImplementationDimension a owl:Class ;
    rdfs:label "Implementation Dimension"@en ;
    rdfs:comment "One of the five dimensions along which an Implementation Case is assessed."@en ;
    owl:equivalentClass [ a owl:Class ;
        owl:oneOf ( rirpdm:StakeholderCommitment rirpdm:PreparatoryWorkAndPlanning
                    rirpdm:GovernanceManagementAndHR rirpdm:Finances rirpdm:Risks ) ] ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

rirpdm:StakeholderCommitment      a owl:NamedIndividual , rirpdm:ImplementationDimension ; rdfs:label "Stakeholder Commitment"@en .
rirpdm:PreparatoryWorkAndPlanning a owl:NamedIndividual , rirpdm:ImplementationDimension ; rdfs:label "Preparatory Work & Planning"@en .
rirpdm:GovernanceManagementAndHR  a owl:NamedIndividual , rirpdm:ImplementationDimension ; rdfs:label "Governance Management & HR"@en .
rirpdm:Finances                   a owl:NamedIndividual , rirpdm:ImplementationDimension ; rdfs:label "Finances"@en .
rirpdm:Risks                      a owl:NamedIndividual , rirpdm:ImplementationDimension ; rdfs:label "Risks"@en .

#################################################################
#    Evaluation & Score
#################################################################

rirpdm:Evaluation a owl:Class ;
    rdfs:label "Evaluation"@en ;
    rdfs:comment "An assessment of a case dimension, producing a score at a given lifecycle phase."@en ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

rirpdm:Score a owl:Class ;
    rdfs:label "Score"@en ;
    rdfs:comment "Grading attributed to a dimension."@en ;
    owl:equivalentClass [ a owl:Class ;
        owl:oneOf ( rirpdm:VeryHigh rirpdm:High rirpdm:Medium rirpdm:Low ) ] ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

rirpdm:VeryHigh a owl:NamedIndividual , rirpdm:Score ; rdfs:label "Very High"@en .
rirpdm:High     a owl:NamedIndividual , rirpdm:Score ; rdfs:label "High"@en .
rirpdm:Medium   a owl:NamedIndividual , rirpdm:Score ; rdfs:label "Medium"@en .
rirpdm:Low      a owl:NamedIndividual , rirpdm:Score ; rdfs:label "Low"@en .

#################################################################
#    Research Output
#################################################################

rirpdm:ResearchOutput a owl:Class ;
    rdfs:label "Research Output"@en ;
    rdfs:comment "Results of an action accessible as scientific publications, data, software, algorithms, protocols, etc."@en ;
    rirpdm:status "New" ;
    dcterms:source "EU Reg 2021 Art 2(22)" .

rirpdm:ScientificPublication a owl:Class ;
    rdfs:label "Scientific Publication"@en ;
    rdfs:comment "A peer-reviewed publication output to which open access applies."@en ;
    rdfs:subClassOf rirpdm:ResearchOutput , fabio:Expression ;
    owl:disjointWith rirpdm:ResearchData ;
    rdfs:seeAlso obo:IAO_0000311 ;
    rirpdm:status "New" ;
    dcterms:source "EU Reg 2021 Art 2(22), Art 14(1)(a), Art 39(3)" .

rirpdm:ResearchData a owl:Class ;
    rdfs:label "Research Data"@en ;
    rdfs:comment "Data, including those underlying scientific publications, managed per FAIR principles."@en ;
    rdfs:subClassOf rirpdm:ResearchOutput ;
    rdfs:seeAlso obo:IAO_0000027 ;
    rirpdm:status "New" ;
    dcterms:source "EU Reg 2021 Art 14(1)(b), Art 39(4)" .

#    Publication types (FaBiO) ────────────────────────────────────

fabio:Expression a owl:Class ;
    rdfs:label "Expression"@en ;
    rdfs:comment "A FaBiO/FRBR expression — the intellectual realisation of a work, the bibliographic superclass of all publication types."@en ;
    rirpdm:status "Adopted" ;
    dcterms:source "FaBiO" .

fabio:JournalArticle a owl:Class ;
    rdfs:label "Journal Article"@en ;
    rdfs:comment "A research article published in a journal issue."@en ;
    rdfs:subClassOf rirpdm:ScientificPublication ;
    skos:exactMatch <https://w3id.org/cerif/vocab/OutputTypes#JournalArticle> ;
    rdfs:seeAlso nfdicore:NFDI_0001209 ;
    rirpdm:status "Adopted" ;
    dcterms:source "FaBiO" .

fabio:ConferencePaper a owl:Class ;
    rdfs:label "Conference Paper"@en ;
    rdfs:comment "A paper presented at a conference and published in its proceedings."@en ;
    rdfs:subClassOf rirpdm:ScientificPublication ;
    skos:exactMatch <https://w3id.org/cerif/vocab/OutputTypes#ConferenceProceedingsArticle> ;
    rdfs:seeAlso nfdicore:NFDI_0001105 ;
    rirpdm:status "Adopted" ;
    dcterms:source "FaBiO" .

fabio:Thesis a owl:Class ;
    rdfs:label "Thesis"@en ;
    rdfs:comment "A document submitted in support of an academic degree."@en ;
    rdfs:subClassOf rirpdm:ScientificPublication ;
    skos:closeMatch <https://w3id.org/cerif/vocab/OutputTypes#PhDThesis> ;
    rirpdm:status "Adopted" ;
    dcterms:source "FaBiO" .

fabio:ReportDocument a owl:Class ;
    rdfs:label "Report"@en ;
    rdfs:comment "A technical or research report."@en ;
    rdfs:subClassOf rirpdm:ScientificPublication ;
    skos:exactMatch <https://w3id.org/cerif/vocab/OutputTypes#Report> ;
    rirpdm:status "Adopted" ;
    dcterms:source "FaBiO" .

fabio:Dataset a owl:Class ;
    rdfs:label "Dataset"@en ;
    rdfs:comment "A published, citable collection of research data."@en ;
    rdfs:subClassOf rirpdm:ResearchData ;
    rdfs:seeAlso nfdicore:NFDI_0001203 ;
    rirpdm:status "Adopted" ;
    dcterms:source "FaBiO" .

#    Publication venues (FaBiO) ────────────────────────────────────

fabio:Journal a owl:Class ;
    rdfs:label "Journal"@en ;
    rdfs:comment "A periodical publishing scholarly articles."@en ;
    rirpdm:status "Adopted" ;
    dcterms:source "FaBiO" .

fabio:AcademicProceedings a owl:Class ;
    rdfs:label "Conference Proceedings"@en ;
    rdfs:comment "The published collection of papers from a conference."@en ;
    rdfs:seeAlso nfdicore:NFDI_0010020 ;
    rirpdm:status "Adopted" ;
    dcterms:source "FaBiO" .

#################################################################
#    Organisations
#################################################################

rirpdm:ResearchInstitution a owl:Class ;
    rdfs:label "Research Institution"@en ;
    rdfs:comment "Organization that participates as a partner in an RI Consortium."@en ;
    rdfs:subClassOf org:Organization ;
    rirpdm:status "Extended" ;
    dcterms:source "ESFRI Roadmap 2026" .

rirpdm:RPO a owl:Class ;
    rdfs:label "Research Performing Organisation (RPO)"@en ;
    rdfs:comment "Legal entity from a MS/AC/third country that performs research and can take binding decisions to support an RI."@en ;
    rdfs:subClassOf org:Organization ;
    rirpdm:status "Extended" ;
    dcterms:source "ESFRI Roadmap 2026" .

rirpdm:RFO a owl:Class ;
    rdfs:label "Research Funding Organisation (RFO)"@en ;
    rdfs:comment "Legal entity that can take binding decisions to financially support an RI."@en ;
    rdfs:subClassOf org:Organization , frapo:FundingAgency ;
    rirpdm:status "Extended" ;
    dcterms:source "ESFRI Roadmap 2026" .

rirpdm:RIConsortium a owl:Class ;
    rdfs:label "RI Consortium"@en ;
    rdfs:subClassOf org:Organization ;
    rdfs:seeAlso nfdicore:NFDI_0001039 ;
    rirpdm:status "Extended" ;
    dcterms:source "ESFRI Roadmap 2026" .

#################################################################
#    Countries
#################################################################

rirpdm:Country a owl:Class ;
    rdfs:label "Country"@en ;
    rdfs:comment "A nation eligible to participate in an RI."@en ;
    rdfs:subClassOf foaf:Agent ;
    rirpdm:status "Extended" ;
    dcterms:source "ESFRI Roadmap 2026" .

rirpdm:MemberState a owl:Class ;
    rdfs:label "Member State"@en ;
    rdfs:comment "Member state of the European Union."@en ;
    rdfs:subClassOf rirpdm:Country ;
    rirpdm:status "Extended" ;
    dcterms:source "ESFRI Roadmap 2026" .

rirpdm:AssociatedCountry a owl:Class ;
    rdfs:label "Associated Country"@en ;
    rdfs:comment "Country associated to the Framework Programme (FP)."@en ;
    rdfs:subClassOf rirpdm:Country ;
    rirpdm:status "Extended" ;
    dcterms:source "ESFRI Roadmap 2026" .

rirpdm:ThirdCountry a owl:Class ;
    rdfs:label "Third Country"@en ;
    rdfs:comment "Country outside Member State / Associated Country."@en ;
    rdfs:subClassOf rirpdm:Country ;
    rirpdm:status "Extended" ;
    dcterms:source "ESFRI Roadmap 2026" .

[] a owl:AllDisjointClasses ;
    owl:members ( rirpdm:MemberState rirpdm:AssociatedCountry rirpdm:ThirdCountry ) .

#################################################################
#    Data properties
#################################################################

rirpdm:uniqueName a owl:DatatypeProperty ;
    rdfs:label "uniqueName"@en ;
    rdfs:comment "The RI's unique specific name."@en ;
    rdfs:domain rirpdm:ResearchInfrastructure ;
    rdfs:range xsd:string ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

rirpdm:legalStatus a owl:DatatypeProperty ;
    rdfs:label "legalStatus"@en ;
    rdfs:comment "The legal status of the RI."@en ;
    rdfs:domain rirpdm:ResearchInfrastructure ;
    rdfs:range xsd:string ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

rirpdm:governanceStructure a owl:DatatypeProperty ;
    rdfs:label "governanceStructure"@en ;
    rdfs:comment "The RI's governance structure with defined responsibilities, reporting lines and advisory/supervisory bodies."@en ;
    rdfs:domain rirpdm:ResearchInfrastructure ;
    rdfs:range xsd:string ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

rirpdm:serviceOffer a owl:DatatypeProperty ;
    rdfs:label "serviceOffer"@en ;
    rdfs:comment "Service offer to the user community."@en ;
    rdfs:domain rirpdm:ResearchInfrastructure ;
    rdfs:range xsd:string ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

rirpdm:accessPolicy a owl:DatatypeProperty ;
    rdfs:label "accessPolicy"@en ;
    rdfs:comment "Policy governing external user access."@en ;
    rdfs:domain rirpdm:ResearchInfrastructure ;
    rdfs:range xsd:string ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

rirpdm:accessPoint a owl:DatatypeProperty ;
    rdfs:label "accessPoint"@en ;
    rdfs:comment "The RI's entry point for external users to submit access proposals."@en ;
    rdfs:domain rirpdm:ResearchInfrastructure ;
    rdfs:range xsd:string ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

rirpdm:userProgramme a owl:DatatypeProperty ;
    rdfs:label "userProgramme"@en ;
    rdfs:comment "A user programme using a relevant fraction of the RI's total capacity."@en ;
    rdfs:domain rirpdm:ResearchInfrastructure ;
    rdfs:range xsd:string ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

rirpdm:dataManagementSystem a owl:DatatypeProperty ;
    rdfs:label "dataManagementSystem"@en ;
    rdfs:comment "The RI's system for metadata, storage, retrieval and data reduction/analysis."@en ;
    rdfs:domain rirpdm:ResearchInfrastructure ;
    rdfs:range xsd:string ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

rirpdm:hasKPI a owl:DatatypeProperty ;
    rdfs:label "hasKPI"@en ;
    rdfs:comment "Measurable KPIs covering scientific-service excellence and sustainability."@en ;
    rdfs:domain rirpdm:ResearchInfrastructure ;
    rdfs:range xsd:string ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

rirpdm:humanResourcesPolicy a owl:DatatypeProperty ;
    rdfs:label "humanResourcesPolicy"@en ;
    rdfs:comment "HR policy ensuring competences via equal-opportunity hiring, secondments, education and training."@en ;
    rdfs:domain rirpdm:ResearchInfrastructure ;
    rdfs:range xsd:string ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

rirpdm:userSupportStructure a owl:DatatypeProperty ;
    rdfs:label "userSupportStructure"@en ;
    rdfs:comment "A single-sited RI's structure (office, ancillary laboratories, accommodation, logistics, etc.) to support user access."@en ;
    rdfs:domain rirpdm:SingleSitedRI ;
    rdfs:range xsd:string ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

rirpdm:longTermSitePlanning a owl:DatatypeProperty ;
    rdfs:label "longTermSitePlanning"@en ;
    rdfs:comment "Long-term plan for the site across its lifecycle."@en ;
    rdfs:domain rirpdm:SingleSitedRI ;
    rdfs:range xsd:string ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

rirpdm:jointInvestmentStrategy a owl:DatatypeProperty ;
    rdfs:label "jointInvestmentStrategy"@en ;
    rdfs:comment "Joint investment strategy aimed to strengthen nodes and shared facilities."@en ;
    rdfs:domain rirpdm:DistributedRI ;
    rdfs:range xsd:string ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

rirpdm:totalInvestmentCosts a owl:DatatypeProperty ;
    rdfs:label "totalInvestmentCosts"@en ;
    rdfs:comment "Sum of all lifecycle investments to fully implement a RI."@en ;
    rdfs:domain rirpdm:ResearchInfrastructure ;
    rdfs:range xsd:decimal ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

rirpdm:designCosts a owl:DatatypeProperty ;
    rdfs:label "designCosts"@en ;
    rdfs:comment "Costs of conceptual design, technical design, feasibility study and proposal drafting."@en ;
    rdfs:domain rirpdm:ResearchInfrastructure ;
    rdfs:range xsd:decimal ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

rirpdm:preparationCosts a owl:DatatypeProperty ;
    rdfs:label "preparationCosts"@en ;
    rdfs:comment "Real/estimated costs of the Preparation Phase."@en ;
    rdfs:domain rirpdm:ResearchInfrastructure ;
    rdfs:range xsd:decimal ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

rirpdm:implementationCosts a owl:DatatypeProperty ;
    rdfs:label "implementationCosts"@en ;
    rdfs:comment "Real or estimated costs for the Implementation Phase of an RI."@en ;
    rdfs:domain rirpdm:ResearchInfrastructure ;
    rdfs:range xsd:decimal ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

rirpdm:terminationCosts a owl:DatatypeProperty ;
    rdfs:label "terminationCosts"@en ;
    rdfs:comment "Decommissioning and environmental-mitigation costs at end of a lifecycle of an RI."@en ;
    rdfs:domain rirpdm:ResearchInfrastructure ;
    rdfs:range xsd:decimal ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

rirpdm:averageAnnualOperationCosts a owl:DatatypeProperty ;
    rdfs:label "averageAnnualOperationCosts"@en ;
    rdfs:comment "Annual cost of running the RI, operating access and delivering services."@en ;
    rdfs:domain rirpdm:ResearchInfrastructure ;
    rdfs:range xsd:decimal ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

rirpdm:providesOpenAccess a owl:DatatypeProperty ;
    rdfs:label "providesOpenAccess"@en ;
    rdfs:comment "Whether open access is ensured for the output (publications and underlying data)."@en ;
    rdfs:domain rirpdm:ResearchOutput ;
    rdfs:range xsd:boolean ;
    rirpdm:status "New" ;
    dcterms:source "EU Reg 2021 Art 14(1)(a), Art 39(3)" .

rirpdm:ensuresLongTermPreservation a owl:DatatypeProperty ;
    rdfs:label "ensuresLongTermPreservation"@en ;
    rdfs:comment "Whether long-term preservation of the data is ensured."@en ;
    rdfs:domain rirpdm:ResearchData ;
    rdfs:range xsd:boolean ;
    rirpdm:status "New" ;
    dcterms:source "EU Reg 2021 Art 14(3)" .

rirpdm:compliesWithFAIR a owl:DatatypeProperty ;
    rdfs:label "compliesWithFAIR"@en ;
    rdfs:comment "Whether the data adhere to the FAIR principles."@en ;
    rdfs:domain rirpdm:ResearchData ;
    rdfs:range xsd:boolean ;
    rirpdm:status "New" ;
    dcterms:source "EU Reg 2021 Art 14(3)" .

#################################################################
#    Object properties
#################################################################

rirpdm:hasCentralHub a owl:ObjectProperty , owl:InverseFunctionalProperty ;
    rdfs:label "hasCentralHub"@en ;
    rdfs:domain rirpdm:DistributedRI ;
    rdfs:range rirpdm:CentralHub ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

# Each distributed RI must have exactly one Central Hub.
rirpdm:DistributedRI rdfs:subClassOf [ a owl:Restriction ;
    owl:onProperty rirpdm:hasCentralHub ;
    owl:cardinality 1 ] .

rirpdm:hasNode a owl:ObjectProperty ;
    rdfs:label "hasNode"@en ;
    rdfs:domain rirpdm:DistributedRI ;
    rdfs:range rirpdm:NationalNode ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

# A distributed RI must have one or more National Nodes.
rirpdm:DistributedRI rdfs:subClassOf [ a owl:Restriction ;
    owl:onProperty rirpdm:hasNode ;
    owl:minCardinality 1 ] .

# --- Agent involvement -------------------------------------------------------
# Top-level pair, kept explicit so sub-properties inherit a domain/range anchor
# (prevents a reasoner inferring agent-to-agent participation triples).

rirpdm:involvesAgent a owl:ObjectProperty ;
    rdfs:label "involvesAgent"@en ;
    rdfs:comment "An agent is involved in this research infrastructure."@en ;
    rdfs:domain rirpdm:ResearchInfrastructure ;
    rdfs:range foaf:Agent ;
    owl:inverseOf rirpdm:participatesIn ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

rirpdm:participatesIn a owl:ObjectProperty ;
    rdfs:label "participatesIn"@en ;
    rdfs:comment "An agent participates in a research infrastructure."@en ;
    rdfs:domain foaf:Agent ;
    rdfs:range rirpdm:ResearchInfrastructure ;
    owl:inverseOf rirpdm:involvesAgent ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

rirpdm:hasLeadEntity a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "hasLeadEntity"@en ;
    rdfs:comment "The agent leading the research infrastructure."@en ;
    rdfs:subPropertyOf rirpdm:involvesAgent ;
    rdfs:domain rirpdm:ResearchInfrastructure ;
    rdfs:range foaf:Agent ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

rirpdm:hasMemberEntity a owl:ObjectProperty ;
    rdfs:label "hasMemberEntity"@en ;
    rdfs:comment "An agent that is a member of the research infrastructure."@en ;
    rdfs:subPropertyOf rirpdm:involvesAgent ;
    rdfs:domain rirpdm:ResearchInfrastructure ;
    rdfs:range foaf:Agent ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

rirpdm:hasObserver a owl:ObjectProperty ;
    rdfs:label "hasObserver"@en ;
    rdfs:comment "An agent observing the research infrastructure."@en ;
    rdfs:subPropertyOf rirpdm:involvesAgent ;
    rdfs:domain rirpdm:ResearchInfrastructure ;
    rdfs:range foaf:Agent ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

rirpdm:hasParticipant a owl:ObjectProperty ;
    rdfs:label "hasParticipant"@en ;
    rdfs:comment "An agent participating in the research infrastructure."@en ;
    rdfs:subPropertyOf rirpdm:involvesAgent ;
    rdfs:domain rirpdm:ResearchInfrastructure ;
    rdfs:range foaf:Agent ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

rirpdm:hasProspectiveMember a owl:ObjectProperty ;
    rdfs:label "hasProspectiveMember"@en ;
    rdfs:comment "An agent that is a prospective member of the research infrastructure."@en ;
    rdfs:subPropertyOf rirpdm:involvesAgent ;
    rdfs:domain rirpdm:ResearchInfrastructure ;
    rdfs:range foaf:Agent ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

# --- Assessment cases --------------------------------------------------------

rirpdm:hasScientificCase a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "hasScientificCase"@en ;
    rdfs:comment "Links a Proposal or Research Infrastructure to its Scientific Case assessment."@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( rirpdm:Proposal rirpdm:ResearchInfrastructure ) ] ;
    rdfs:range rirpdm:ScientificCase ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

rirpdm:hasImplementationCase a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "hasImplementationCase"@en ;
    rdfs:comment "Links a Proposal or Research Infrastructure to its Implementation Case assessment."@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( rirpdm:Proposal rirpdm:ResearchInfrastructure ) ] ;
    rdfs:range rirpdm:ImplementationCase ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

rirpdm:resultsInProject a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "resultsInProject"@en ;
    rdfs:comment "The transition from a Proposal to the resulting selected RI; carries ex ante to ex post."@en ;
    rdfs:domain rirpdm:Proposal ;
    rdfs:range [ a owl:Class ; owl:unionOf ( rirpdm:ESFRIProject rirpdm:ESFRILandmark ) ] ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

rirpdm:upgradesRI a owl:ObjectProperty ;
    rdfs:label "upgradesRI"@en ;
    rdfs:comment "The operational RI that a Major Upgrade proposal targets."@en ;
    rdfs:domain rirpdm:MajorUpgrade ;
    rdfs:range rirpdm:ResearchInfrastructure ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

# --- Evaluation --------------------------------------------------------------

rirpdm:hasEvaluation a owl:ObjectProperty ;
    rdfs:label "hasEvaluation"@en ;
    rdfs:comment "Links a case to one of its per-dimension evaluations."@en ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( rirpdm:ScientificCase rirpdm:ImplementationCase ) ] ;
    rdfs:range rirpdm:Evaluation ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

rirpdm:evaluatesDimension a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "evaluatesDimension"@en ;
    rdfs:comment "The scientific or implementation dimension that an Evaluation assesses."@en ;
    rdfs:domain rirpdm:Evaluation ;
    rdfs:range [ a owl:Class ; owl:unionOf ( rirpdm:ScientificDimension rirpdm:ImplementationDimension ) ] ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

rirpdm:assessedAtPhase a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "assessedAtPhase"@en ;
    rdfs:comment "The lifecycle phase at which an Evaluation was made."@en ;
    rdfs:domain rirpdm:Evaluation ;
    rdfs:range rirpdm:LifecyclePhase ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

rirpdm:hasScore a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "hasScore"@en ;
    rdfs:comment "The score attributed by an Evaluation."@en ;
    rdfs:domain rirpdm:Evaluation ;
    rdfs:range rirpdm:Score ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

# --- Outputs & lifecycle -----------------------------------------------------

rirpdm:producesResearchOutput a owl:ObjectProperty ;
    rdfs:label "producesResearchOutput"@en ;
    rdfs:comment "A research output produced by the research infrastructure."@en ;
    rdfs:domain rirpdm:ResearchInfrastructure ;
    rdfs:range rirpdm:ResearchOutput ;
    rirpdm:status "New" ;
    dcterms:source "EU Reg 2021 Art 2(22); Annex I(1)(c)" .

rirpdm:isInPhase a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:label "isInPhase"@en ;
    rdfs:comment "The current lifecycle phase of the research infrastructure."@en ;
    rdfs:domain rirpdm:ResearchInfrastructure ;
    rdfs:range rirpdm:LifecyclePhase ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

# --- Transitive funding chain ------------------------------------------------

rirpdm:isSupportedBy a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:label "isSupportedBy"@en ;
    rdfs:comment "Connects an RI (or grant) to its funding source at any level. Transitivity lets the reasoner infer the full chain: RI → Grant → FundingProgramme."@en ;
    # RI or Grant can be funded by a Grant, FundingProgramme or FundingAgency
    rdfs:domain [ a owl:Class ; owl:unionOf ( rirpdm:ResearchInfrastructure frapo:Grant ) ] ;
    rdfs:range  [ a owl:Class ; owl:unionOf ( frapo:Grant frapo:FundingProgramme frapo:FundingAgency ) ] ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

# --- Symmetric collaboration --------------------------------------------------

rirpdm:collaboratesWith a owl:ObjectProperty , owl:SymmetricProperty ;
    rdfs:label "collaboratesWith"@en ;
    rdfs:comment "Two research institutions collaborate. Symmetry means asserting A→B is enough; B→A is inferred."@en ;
    rdfs:domain rirpdm:ResearchInstitution ;
    rdfs:range  rirpdm:ResearchInstitution ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

# --- Funding (FRAPO) ---------------------------------------------------------

frapo:isFundedBy a owl:ObjectProperty , owl:AsymmetricProperty ;
    rdfs:label "is funded by"@en ;
    owl:inverseOf frapo:funds ;
    rirpdm:status "Adopted" ;
    dcterms:source "FRAPO" .

frapo:funds a owl:ObjectProperty ;
    rdfs:label "funds"@en ;
    rirpdm:status "Adopted" ;
    dcterms:source "FRAPO" .

frapo:isAwardedBy a owl:ObjectProperty ;
    rdfs:label "is awarded by"@en ;
    owl:inverseOf frapo:awards ;
    rirpdm:status "Adopted" ;
    dcterms:source "FRAPO" .

frapo:hasGrantNumber a owl:DatatypeProperty ;
    rdfs:label "has grant number"@en ;
    rirpdm:status "Adopted" ;
    dcterms:source "FRAPO" .

frapo:hasMonetaryValue a owl:DatatypeProperty ;
    rdfs:label "has monetary value"@en ;
    rirpdm:status "Adopted" ;
    dcterms:source "FRAPO" .

# --- Publications (FaBiO) ----------------------------------------------------

fabio:hasPublicationVenue a owl:ObjectProperty ;
    rdfs:label "has publication venue"@en ;
    rdfs:comment "Relates a publication to the journal or proceedings it appeared in."@en ;
    rdfs:domain rirpdm:ScientificPublication ;
    rdfs:range fabio:Journal ;
    rirpdm:status "Adopted" ;
    dcterms:source "FaBiO" .

fabio:hasDOI a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "has DOI"@en ;
    rdfs:comment "Digital Object Identifier of the research output."@en ;
    rdfs:domain rirpdm:ResearchOutput ;
    rdfs:range xsd:string ;
    rirpdm:status "Adopted" ;
    dcterms:source "FaBiO" .

rirpdm:hasAuthor a owl:ObjectProperty ;
    rdfs:label "hasAuthor"@en ;
    rdfs:comment "Relates a scientific publication to a researcher who authored it."@en ;
    rdfs:domain rirpdm:ScientificPublication ;
    rdfs:range  rirpdm:Researcher ;
    owl:inverseOf rirpdm:authorOf ;
    rdfs:seeAlso vivo:hasAuthor ;
    rirpdm:status "New" ;
    dcterms:source "VIVO" .

rirpdm:authorOf a owl:ObjectProperty ;
    rdfs:label "authorOf"@en ;
    rdfs:comment "Relates a researcher to a scientific publication they authored."@en ;
    rdfs:domain rirpdm:Researcher ;
    rdfs:range  rirpdm:ScientificPublication ;
    owl:inverseOf rirpdm:hasAuthor ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

# --- Citations (CiTO) --------------------------------------------------------

cito:cites a owl:ObjectProperty , owl:IrreflexiveProperty ;
    rdfs:label "cites"@en ;
    rdfs:comment "The citing entity cites the cited entity."@en ;
    rdfs:domain rirpdm:ScientificPublication ;
    rdfs:range rirpdm:ResearchOutput ;
    rirpdm:status "Adopted" ;
    dcterms:source "CiTO" .

cito:isCitedBy a owl:ObjectProperty ;
    rdfs:label "is cited by"@en ;
    owl:inverseOf cito:cites ;
    rirpdm:status "Adopted" ;
    dcterms:source "CiTO" .

rirpdm:isOutputOf a owl:ObjectProperty ;
    rdfs:label "isOutputOf"@en ;
    rdfs:comment "The research infrastructure that produced this output."@en ;
    owl:inverseOf rirpdm:producesResearchOutput ;
    rdfs:domain rirpdm:ResearchOutput ;
    rdfs:range rirpdm:ResearchInfrastructure ;
    rirpdm:status "New" ;
    dcterms:source "EU Reg 2021 Art 2(22)" .

rirpdm:isNodeOf a owl:ObjectProperty ;
    rdfs:label "isNodeOf"@en ;
    rdfs:comment "The distributed RI this national node belongs to."@en ;
    owl:inverseOf rirpdm:hasNode ;
    rdfs:domain rirpdm:NationalNode ;
    rdfs:range rirpdm:DistributedRI ;
    rirpdm:status "New" ;
    dcterms:source "ESFRI Roadmap 2026" .

cito:extends a owl:ObjectProperty ;
    rdfs:label "extends"@en ;
    rdfs:comment "The citing entity extends the cited work."@en ;
    rdfs:subPropertyOf cito:cites ;
    rirpdm:status "Adopted" ;
    dcterms:source "CiTO" .

cito:usesDataFrom a owl:ObjectProperty ;
    rdfs:label "uses data from"@en ;
    rdfs:comment "The citing entity uses data from the cited entity."@en ;
    rdfs:subPropertyOf cito:cites ;
    rirpdm:status "Adopted" ;
    dcterms:source "CiTO" .

cito:usesMethodIn a owl:ObjectProperty ;
    rdfs:label "uses method in"@en ;
    rdfs:comment "The citing entity uses a method described in the cited entity."@en ;
    rdfs:subPropertyOf cito:cites ;
    rirpdm:status "Adopted" ;
    dcterms:source "CiTO" .

cito:citesAsEvidence a owl:ObjectProperty ;
    rdfs:label "cites as evidence"@en ;
    rdfs:comment "The citing entity cites the cited entity as evidence."@en ;
    rdfs:subPropertyOf cito:cites ;
    rirpdm:status "Adopted" ;
    dcterms:source "CiTO" .

cito:disputes a owl:ObjectProperty ;
    rdfs:label "disputes"@en ;
    rdfs:comment "The citing entity disputes a statement in the cited entity."@en ;
    rdfs:subPropertyOf cito:cites ;
    rirpdm:status "Adopted" ;
    dcterms:source "CiTO" .
