PREFIX rirpdo: <http://www.example.org/rirpdo#>

# Which publications resulted from projects that used research infrastructure?
# Bridges Publications <-> Infrastructure via Researcher participation in Projects.

SELECT ?publicationTitle ?projectName ?infraName ?infraType
WHERE {
    ?project a rirpdo:Project ;
             rirpdo:name ?projectName ;
             rirpdo:usesInfrastructure ?infra ;
             rirpdo:hasParticipant ?researcher .
    ?infra   rirpdo:name ?infraName ;
             a ?infraType .
    ?publication rirpdo:hasAuthor ?researcher ;
                 rirpdo:title ?publicationTitle .
    FILTER(?infraType IN (rirpdo:Laboratory, rirpdo:ComputeCluster, rirpdo:CloudInfrastructure, rirpdo:ResearchDataRepository, rirpdo:GitRepository))
}
ORDER BY ?projectName ?infraName
