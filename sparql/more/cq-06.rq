# CQ06: Which specific RI produced a given publication, and which
# researchers thereby contributed to that RI?
#
# Reasoning: owl:propertyChainAxiom on contributesToRI (authorOf o isOutputOf)
# infers a researcher's contribution to the RI straight from authorship.

PREFIX rirpdm: <http://www.example.org/rirpdm#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?pub ?pubLabel ?ri ?riName ?researcher ?researcherLabel
WHERE {
    ?pub a rirpdm:ScientificPublication ;
         rdfs:label ?pubLabel ;
         rirpdm:isOutputOf ?ri .
    ?ri rirpdm:uniqueName ?riName .

    ?researcher rirpdm:contributesToRI ?ri ;
                rdfs:label ?researcherLabel .

    # Narrow to one publication, e.g.:
    # FILTER(STR(?pubLabel) = "...")
}
ORDER BY ?riName ?researcherLabel
