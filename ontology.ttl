                                            rdfs:label "Journal Article"@en ;
                                            rdfs:seeAlso <https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0001209> .


<http://purl.org/spar/fabio/ReportDocument> <http://purl.org/dc/terms/source> "FaBiO" ;
                                            :status "Adopted" ;
                                            rdfs:comment "A technical or research report."@en ;
                                            rdfs:label "Report"@en .


<http://purl.org/spar/fabio/Thesis> <http://purl.org/dc/terms/source> "FaBiO" ;
                                    :status "Adopted" ;
                                    rdfs:comment "A document submitted in support of an academic degree."@en ;
                                    rdfs:label "Thesis"@en .


:DistributedRI <http://purl.org/dc/terms/source> "ESFRI Roadmap 2026" ;
               :status "New" ;
               rdfs:comment "An RI made up of a Central Hub plus interlinked National Nodes; the Hub coordinates and manages each Node's RI-dedicated capacity under the RI Consortium's shared rules."@en ;
               rdfs:label "Distributed RI"@en .


:ResearchInfrastructure <http://purl.org/dc/terms/source> "ESFRI Roadmap 2026" ,
                                                          "EU Regulation 2021 Art 2" ;
                        :status "New" ;
                        rdfs:comment "A facility (or set of resources/services) enabling research and innovation."@en ;
                        rdfs:label "Research Infrastructure"@en .


:SingleSitedRI <http://purl.org/dc/terms/source> "ESFRI Roadmap 2026" ;
               :status "New" ;
               rdfs:comment "An RI concentrated geographically at one site (or a few complementary sites) designed for user access. (ESFRI Roadmap 2026, p.15)"@en ;
               rdfs:label "Single-sited RI"@en .


:VirtualRI <http://purl.org/dc/terms/source> "ESFRI Roadmap 2026" ;
           :status "New" ;
           rdfs:comment "An RI with no fixed physical site: its resources and services are accessed remotely rather than in person."@en ;
           rdfs:label "Virtual RI"@en .


