                                              :KPI ;
                                     :forObjective :DeliveryOfEducationAndTraining ;
                                     :unitOfMeasure "Number" ;
                                     <http://purl.org/dc/terms/source> "ESFRI WG Monitoring Report 2019, Annex 5 KPI 5" ;
                                     :status "New" ;
                                     rdfs:comment "Number of master and PhD students who have performed some of their studies at or using the services of the RI in a particular year regardless of whether they are funded/hosted by the RI or access it as a user."@en ;
                                     rdfs:label "Number of master and PhD students using the RI"@en .


