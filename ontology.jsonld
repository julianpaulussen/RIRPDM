  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Imports of fabio and cito are resolved via catalog-v001.xml to locally patched copies (ontology/fabio.owl, ontology/cito.owl): upstream published files assert untyped dcterms:created/modified literals on their own ontology IRI, violating the xsd:dateTime range they themselves declare, which makes the raw remote files OWL-inconsistent (owl:Thing SubClassOf owl:Nothing). Only those two literals were retyped; no domain classes/properties/axioms were altered."
  } ],
  "http://www.w3.org/2002/07/owl#imports" : [ {
    "@id" : "http://purl.org/cerif/frapo/"
  }, {
    "@id" : "http://purl.org/spar/cito"
  }, {
    "@id" : "http://purl.org/spar/fabio"
  }, {
    "@id" : "http://www.w3.org/2004/02/skos/core#"
  }, {
    "@id" : "http://www.w3.org/ns/org#"
  }, {
    "@id" : "http://xmlns.com/foaf/0.1/"
  } ],
  "http://www.w3.org/2002/07/owl#versionInfo" : [ {
    "@value" : "0.1.0"
  } ]
