# CQ09:
# For each operational research infrastructure, which funding agencies support it
# BOTH directly (its own grant chain) AND indirectly (through a collaborating
# partner RI's funding) -- i.e. a shared funder it is doubly exposed to -- and how
# many researchers contributed to it and how many of its outputs are open access?
#
# This single query only resolves once a DL reasoner has materialised inferences;
# it composes six reasoning features from the ontology at once:
#   (1) rdfs:subClassOf  -- ABox only asserts SingleSited/Distributed/VirtualRI;
#                           the parent type ResearchInfrastructure is inferred.
#   (2) Functional isInPhase        -- at most one lifecycle phase per RI.
#   (3) Transitive isSupportedBy    -- RI -> Grant -> Agency collapses to one hop,
#                                      so a FundingAgency is a direct funder.
#   (4) Property chain indirectlyExposedTo
#         (involvesAgent o collaboratesWith o participatesIn o isSupportedBy)
#         -- the SAME agency reached via a partner RI (collaboratesWith is
#            symmetric, participatesIn is the inverse of involvesAgent).
#   (5) Property chain contributesToRI (authorOf o isOutputOf)
#         -- authorship of an RI output infers contribution to the RI.
#   (6) Inverse producesResearchOutput/isOutputOf -- ABox asserts pub isOutputOf RI;
#         the RI -> output direction is inferred, then filtered on open access.

PREFIX rirpdm: <http://www.example.org/rirpdm#>
PREFIX frapo:  <http://purl.org/cerif/frapo/>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?riName ?funderLabel
       (COUNT(DISTINCT ?contributor) AS ?contributors)
       (COUNT(DISTINCT ?oaOutput)    AS ?openAccessOutputs)
WHERE {
    # (1) subsumption: reaches every RI through the single parent class,
    # (2) functional isInPhase: keep only those currently in Operation.
    ?ri a rirpdm:ResearchInfrastructure ;
        rirpdm:uniqueName ?riName ;
        rirpdm:isInPhase  rirpdm:Operation .

    # (3) transitive isSupportedBy: a funding agency in the RI's own chain.
    ?ri rirpdm:isSupportedBy ?funder .
    ?funder a frapo:FundingAgency ;
            rdfs:label ?funderLabel .

    # (4) property chain: the SAME funder is also reached only through a
    # collaborating partner RI's funding -> a doubly-exposed (shared) funder.
    ?ri rirpdm:indirectlyExposedTo ?funder .

    # (5) property chain: researchers inferred to contribute to this RI.
    OPTIONAL { ?contributor rirpdm:contributesToRI ?ri . }

    # (6) inverse of isOutputOf, then filter open-access outputs.
    OPTIONAL {
        ?ri rirpdm:producesResearchOutput ?oaOutput .
        ?oaOutput rirpdm:providesOpenAccess true .
    }
    # DISTINCT guards the counts against the fan-out of the two OPTIONALs.
}
GROUP BY ?riName ?funderLabel
ORDER BY DESC(?contributors) ?riName
