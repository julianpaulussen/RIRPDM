@prefix rirpdo:   <http://www.example.org/rirpdo#> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix foaf:     <http://xmlns.com/foaf/0.1/> .
@prefix dc:       <http://purl.org/dc/terms/> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix bibo:     <http://purl.org/ontology/bibo/> .
@prefix nfdicore: <https://nfdi.fiz-karlsruhe.de/ontology/> .
@prefix vivo:     <http://vivoweb.org/ontology/core#> .
@prefix cerif:    <https://w3id.org/cerif/vocab/> .
@prefix cerif-m:  <https://w3id.org/cerif/model#> .

# ── Ontology declaration ─────────────────────────────────────────────────────

<http://www.example.org/rirpdo>
    a owl:Ontology ;
    dc:title "Research Infrastructure and Research Publications Data Ontology (RIRPDO)" ;
    dc:description "Core ontology for representing research infrastructure and scientific publications." ;
    owl:versionInfo "0.4.0" .

# ── Classes ──────────────────────────────────────────────────────────────────

rirpdo:Researcher
    a owl:Class ;
    rdfs:label "Researcher" ;
    rdfs:subClassOf foaf:Person ;
    skos:definition "A person who conducts scientific research, typically affiliated with an institution." .

rirpdo:Institution
    a owl:Class ;
    rdfs:label "Institution" ;
    rdfs:subClassOf foaf:Organization ;
    skos:definition "An organization that conducts, funds, or supports research activities, such as a university or research institute." .

rirpdo:Publication
    a owl:Class ;
    rdfs:label "Publication" ;
    rdfs:subClassOf bibo:Document ;
    skos:definition "A scholarly work published and shared with the research community, such as a journal article, conference paper, or technical report." .

rirpdo:ResearchTopic
    a owl:Class ;
    rdfs:label "Research Topic" ;
    rdfs:subClassOf skos:Concept ;
    rdfs:seeAlso nfdicore:NFDI_0000100 ;       # nfdicore:academic discipline
    skos:definition "A subject area or field that a publication or research project addresses." .

rirpdo:Project
    a owl:Class ;
    rdfs:label "Project" ;
    rdfs:seeAlso nfdicore:NFDI_0000002 ;       # nfdicore:project
    skos:definition "A funded research activity with defined goals, participants, and a start and end date." .

rirpdo:ResearchInfrastructure
    a owl:Class ;
    rdfs:label "Research Infrastructure" ;
    skos:definition "A facility, equipment, or service used by research communities to conduct research and foster innovation — including physical labs, major instruments, knowledge-based resources, e-infrastructures, and distributed observatories." ;
    skos:exactMatch <https://w3id.org/cerif/vocab/ResearchInfrastructure#ResearchInfrastructure> ;
    dc:source cerif:ResearchInfrastructure .

rirpdo:Facility
    a owl:Class ;
    rdfs:label "Facility" ;
    rdfs:subClassOf rirpdo:ResearchInfrastructure ;
    rdfs:seeAlso cerif-m:cfFacility ;
    skos:definition "A physical or virtual space that hosts research activities, such as a laboratory or observatory." .

rirpdo:Laboratory
    a owl:Class ;
    rdfs:label "Laboratory" ;
    rdfs:subClassOf rirpdo:Facility ;
    rdfs:seeAlso nfdicore:NFDI_0001208 ;       # nfdicore:laboratory
    skos:definition "A physical or virtual space where researchers conduct experiments and empirical work." .

rirpdo:Equipment
    a owl:Class ;
    rdfs:label "Equipment" ;
    rdfs:subClassOf rirpdo:ResearchInfrastructure ;
    rdfs:seeAlso cerif-m:cfEquipment ;
    skos:definition "Major scientific instruments, sensors, or devices used to conduct research experiments or measurements." .

rirpdo:InfrastructureService
    a owl:Class ;
    rdfs:label "Infrastructure Service" ;
    rdfs:subClassOf rirpdo:ResearchInfrastructure ;
    rdfs:seeAlso cerif-m:cfService ;
    skos:definition "A service or digital resource provided to the research community, including computing platforms, data repositories, and communication networks." .

rirpdo:ResearchDataRepository
    a owl:Class ;
    rdfs:label "Research Data Repository" ;
    rdfs:subClassOf rirpdo:InfrastructureService ;
    rdfs:seeAlso nfdicore:NFDI_0001201 ;       # nfdicore:research data repository
    skos:definition "A storage system for archiving and sharing research datasets, typically with persistent identifiers (e.g. Zenodo, Figshare)." .

rirpdo:GitRepository
    a owl:Class ;
    rdfs:label "Git Repository" ;
    rdfs:subClassOf rirpdo:ResearchDataRepository ;
    skos:definition "A version-controlled repository hosting research code and software artifacts (e.g. GitHub, GitLab)." .

rirpdo:ComputingEnvironment
    a owl:Class ;
    rdfs:label "Computing Environment" ;
    rdfs:subClassOf rirpdo:InfrastructureService ;
    skos:definition "Any computational resource used to execute research workloads, including clusters and cloud platforms." .

rirpdo:ComputeCluster
    a owl:Class ;
    rdfs:label "High-Performance Computing (HPC) Cluster" ;
    rdfs:subClassOf rirpdo:ComputingEnvironment ;
    skos:definition "A set of linked compute nodes used for high-performance or parallel computing in research (e.g. HPC clusters)." .

rirpdo:CloudInfrastructure
    a owl:Class ;
    rdfs:label "Cloud Infrastructure" ;
    rdfs:subClassOf rirpdo:ComputingEnvironment ;
    skos:definition "On-demand cloud computing resources used for research workloads (e.g. AWS, Azure, Google Cloud)." .

rirpdo:ResearchGroup
    a owl:Class ;
    rdfs:label "Research Group" ;
    rdfs:subClassOf foaf:Group ;
    skos:definition "A team of researchers collaborating on a shared scientific topic, typically within an institution." .

rirpdo:Journal
    a owl:Class ;
    rdfs:label "Journal" ;
    owl:equivalentClass bibo:Journal ;
    skos:definition "A periodical publication in which researchers publish peer-reviewed articles." .

rirpdo:Conference
    a owl:Class ;
    rdfs:label "Conference" ;
    rdfs:seeAlso nfdicore:NFDI_0010020 ;       # nfdicore:conference
    skos:definition "An academic event where researchers present and discuss their work." .

rirpdo:Dataset
    a owl:Class ;
    rdfs:label "Dataset" ;
    rdfs:seeAlso nfdicore:NFDI_0001203 ;       # nfdicore:experimental dataset
    skos:definition "A structured collection of data produced or used in a research project." .

rirpdo:Funding
    a owl:Class ;
    rdfs:label "Funding" ;
    rdfs:seeAlso nfdicore:NFDI_0001051 ;       # nfdicore:funding specification
    skos:definition "Financial support granted to a research project, typically by a government body or foundation." .

# ── CERIF alignment ──────────────────────────────────────────────────────────

rirpdo:ResearchInfrastructure  skos:exactMatch  <https://w3id.org/cerif/vocab/ResearchInfrastructure#ResearchInfrastructure> .
rirpdo:Facility                rdfs:seeAlso     cerif-m:cfFacility .
rirpdo:Equipment               rdfs:seeAlso     cerif-m:cfEquipment .
rirpdo:InfrastructureService   rdfs:seeAlso     cerif-m:cfService .

# ── VIVO alignment ───────────────────────────────────────────────────────────

rirpdo:Researcher        rdfs:seeAlso           vivo:ResearcherRole .
rirpdo:ResearchGroup     rdfs:seeAlso           vivo:ResearchOrganization .
rirpdo:Laboratory        rdfs:seeAlso           vivo:Laboratory .
rirpdo:Project           rdfs:seeAlso           vivo:Project .

rirpdo:hasAuthor         rdfs:seeAlso           vivo:hasAuthor .
rirpdo:affiliatedWith    rdfs:seeAlso           vivo:affiliatedWith .
rirpdo:fundedBy          rdfs:seeAlso           vivo:fundedBy .
rirpdo:memberOf          rdfs:seeAlso           vivo:memberOf .

# ── Disjoint classes ──────────────────────────────────────────────────────────

rirpdo:Researcher owl:disjointWith rirpdo:Publication .
rirpdo:Researcher owl:disjointWith rirpdo:ResearchInfrastructure .
rirpdo:Researcher owl:disjointWith rirpdo:ResearchTopic .
rirpdo:Publication owl:disjointWith rirpdo:ResearchInfrastructure .
rirpdo:Publication owl:disjointWith rirpdo:Project .
rirpdo:Institution owl:disjointWith rirpdo:Publication .

# ── Cardinality restrictions ──────────────────────────────────────────────────

rirpdo:Project
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty rirpdo:hasParticipant ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass rirpdo:Researcher
    ] .

# ── Object properties ────────────────────────────────────────────────────────

rirpdo:hasAuthor
    a owl:ObjectProperty, owl:IrreflexiveProperty ;
    rdfs:label "hasAuthor" ;
    rdfs:domain rirpdo:Publication ;
    rdfs:range  rirpdo:Researcher ;
    owl:inverseOf rirpdo:authorOf .

rirpdo:authorOf
    a owl:ObjectProperty ;
    rdfs:label "authorOf" ;
    owl:inverseOf rirpdo:hasAuthor .

rirpdo:affiliatedWith
    a owl:ObjectProperty ;
    rdfs:label "affiliatedWith" ;
    rdfs:domain rirpdo:Researcher ;
    rdfs:range  rirpdo:Institution .

rirpdo:hasTopic
    a owl:ObjectProperty ;
    rdfs:label "hasTopic" ;
    rdfs:domain rirpdo:Publication ;
    rdfs:range  rirpdo:ResearchTopic .

rirpdo:hasParticipant
    a owl:ObjectProperty ;
    rdfs:label "hasParticipant" ;
    rdfs:domain rirpdo:Project ;
    rdfs:range  rirpdo:Researcher .

rirpdo:usesInfrastructure
    a owl:ObjectProperty ;
    rdfs:label "usesInfrastructure" ;
    rdfs:domain rirpdo:Project ;
    rdfs:range  rirpdo:ResearchInfrastructure .

rirpdo:memberOf
    a owl:ObjectProperty ;
    rdfs:label "memberOf" ;
    rdfs:domain rirpdo:Researcher ;
    rdfs:range  rirpdo:ResearchGroup .

rirpdo:fundedBy
    a owl:ObjectProperty, owl:AsymmetricProperty, owl:IrreflexiveProperty ;
    rdfs:label "fundedBy" ;
    rdfs:domain rirpdo:Project ;
    rdfs:range  rirpdo:Funding .

rirpdo:producedDataset
    a owl:ObjectProperty ;
    rdfs:label "producedDataset" ;
    rdfs:domain rirpdo:Project ;
    rdfs:range  rirpdo:Dataset .

rirpdo:publishedIn
    a owl:ObjectProperty ;
    rdfs:label "publishedIn" ;
    rdfs:domain rirpdo:Publication ;
    rdfs:range  rirpdo:Journal .

rirpdo:presentedAt
    a owl:ObjectProperty ;
    rdfs:label "presentedAt" ;
    rdfs:domain rirpdo:Publication ;
    rdfs:range  rirpdo:Conference .

# ── Data properties ──────────────────────────────────────────────────────────

rirpdo:name
    a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:range xsd:string ;
    owl:equivalentProperty foaf:name .

rirpdo:title
    a owl:DatatypeProperty ;
    rdfs:label "title" ;
    rdfs:range xsd:string ;
    owl:equivalentProperty dc:title .

rirpdo:year
    a owl:DatatypeProperty ;
    rdfs:label "year" ;
    rdfs:range xsd:gYear ;
    owl:equivalentProperty dc:date .

rirpdo:doi
    a owl:DatatypeProperty, owl:InverseFunctionalProperty ;
    rdfs:label "doi" ;
    rdfs:domain rirpdo:Publication ;
    rdfs:range xsd:string ;
    owl:equivalentProperty bibo:doi .

rirpdo:abstract
    a owl:DatatypeProperty ;
    rdfs:label "abstract" ;
    rdfs:domain rirpdo:Publication ;
    rdfs:range xsd:string ;
    owl:equivalentProperty dc:abstract .

rirpdo:startDate
    a owl:DatatypeProperty ;
    rdfs:label "startDate" ;
    rdfs:domain rirpdo:Project ;
    rdfs:range xsd:date .

rirpdo:endDate
    a owl:DatatypeProperty ;
    rdfs:label "endDate" ;
    rdfs:domain rirpdo:Project ;
    rdfs:range xsd:date .

rirpdo:amount
    a owl:DatatypeProperty ;
    rdfs:label "amount" ;
    rdfs:domain rirpdo:Funding ;
    rdfs:range xsd:decimal .

rirpdo:orcid
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "orcid" ;
    rdfs:domain rirpdo:Researcher ;
    rdfs:range xsd:string .

# ABox (individuals) is in rirpdo-individuals.ttl — load both files into GraphDB.