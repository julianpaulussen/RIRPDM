<http://purl.org/cerif/frapo/Grant> <http://purl.org/dc/terms/source> "FRAPO" ;
                                    :status "Adopted" ;
                                    rdfs:comment "A sum of money awarded by a funding agency to support a specific project or activity."@en ;
                                    rdfs:label "Grant"@en .


<http://purl.org/spar/fabio/ConferencePaper> <http://purl.org/dc/terms/source> "FaBiO" ;
