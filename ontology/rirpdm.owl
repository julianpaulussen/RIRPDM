    <rdf:type rdf:resource="http://www.example.org/rirpdm#KPI"/>
    <rdfs:label xml:lang="en">International trainees</rdfs:label>
    <rdfs:comment xml:lang="en">Person-hours of training opportunities provided by the RI made use of by trainees from non-ESFRI member countries.</rdfs:comment>
