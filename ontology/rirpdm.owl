    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:label xml:lang="en">isSupportedBy</rdfs:label>
    <rdfs:comment xml:lang="en">Connects an RI, national node or grant to its funding source at any level. Transitivity lets the reasoner infer the full chain: RI → Grant → FundingProgramme. The property chain hasNode o isSupportedBy additionally rolls a distributed RI's node funding up to the RI, so the funders of the nodes are inferred funders of the RI itself.</rdfs:comment>
    <rdfs:domain rdf:nodeID="n1d0daad76aea4869b9e80e485ed3dbf8b142"/>
    <rdfs:range rdf:nodeID="n1d0daad76aea4869b9e80e485ed3dbf8b146"/>
    <owl:propertyChainAxiom rdf:nodeID="n1d0daad76aea4869b9e80e485ed3dbf8b150"/>
    <rirpdm:status>New</rirpdm:status>
    <dcterms:source>ESFRI Roadmap 2026</dcterms:source>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdm#ResearchInfrastructure">
