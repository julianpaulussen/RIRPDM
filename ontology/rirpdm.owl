    <rdfs:comment xml:lang="en">A national/institutional component of a distributed RI whose RI-dedicated capacity and resources are identified, coordinated and managed by the Central Hub.</rdfs:comment>
    <rirpdm:status>New</rirpdm:status>
    <dcterms:source>ESFRI Roadmap 2026</dcterms:source>
  </rdf:Description>
