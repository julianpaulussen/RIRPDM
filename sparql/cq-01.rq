# CQ01: Which research infrastructures exist, of what type (single-sited, distributed, virtual), 
# and in which lifecycle phase?
#
# Reasoning: enumerated LifecyclePhase (owl:oneOf) + functional isInPhase -- exactly one phase per RI.

PREFIX rirpdm: <http://www.example.org/rirpdm#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?ri ?riName ?type ?phaseLabel
WHERE {
    ?ri a rirpdm:ResearchInfrastructure ;
        a ?type ;
        rirpdm:uniqueName ?riName .
    FILTER(?type IN (rirpdm:SingleSitedRI, rirpdm:DistributedRI, rirpdm:VirtualRI))

    OPTIONAL {
        ?ri rirpdm:isInPhase ?phase .
        ?phase rdfs:label ?phaseLabel .
    }
}
ORDER BY ?riName
