@prefix rirpdo:   <http://www.example.org/rirpdo#> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .

# ABox — load alongside rirpdo.ttl in GraphDB

# ── Institutions ──────────────────────────────────────────────────────────────

rirpdo:FraunhoferFOKUS
    a rirpdo:Institution ;
    rirpdo:name "Fraunhofer FOKUS" .

rirpdo:TUBerlin
    a rirpdo:Institution ;
    rirpdo:name "Technische Universität Berlin" .

# ── Research topics ───────────────────────────────────────────────────────────

rirpdo:SemanticWeb
    a rirpdo:ResearchTopic ;
    rirpdo:name "Semantic Web" .

rirpdo:KnowledgeGraphs
    a rirpdo:ResearchTopic ;
    rirpdo:name "Knowledge Graphs" .

rirpdo:LinkedData
    a rirpdo:ResearchTopic ;
    rirpdo:name "Linked Data" .

# ── Researchers ───────────────────────────────────────────────────────────────

rirpdo:Researcher_Aslam
    a rirpdo:Researcher ;
    rirpdo:name "Muhammad Ahtisham Aslam" ;
    rirpdo:affiliatedWith rirpdo:FraunhoferFOKUS .

rirpdo:Researcher_Smith
    a rirpdo:Researcher ;
    rirpdo:name "Jane Smith" ;
    rirpdo:affiliatedWith rirpdo:TUBerlin .

rirpdo:Researcher_Mueller
    a rirpdo:Researcher ;
    rirpdo:name "Hans Mueller" ;
    rirpdo:affiliatedWith rirpdo:TUBerlin .

# ── Publications ──────────────────────────────────────────────────────────────

rirpdo:Pub_LOPDF
    a rirpdo:Publication ;
    rirpdo:title "LOPDF: A Framework for Extracting and Producing Open Data of Scientific Documents" ;
    rirpdo:year "2021"^^xsd:gYear ;
    rirpdo:hasAuthor rirpdo:Researcher_Aslam ;
    rirpdo:hasTopic rirpdo:LinkedData ;
    rirpdo:hasTopic rirpdo:SemanticWeb .

rirpdo:Pub_KGSurvey
    a rirpdo:Publication ;
    rirpdo:title "A Survey on Knowledge Graph Construction" ;
    rirpdo:year "2023"^^xsd:gYear ;
    rirpdo:hasAuthor rirpdo:Researcher_Smith ;
    rirpdo:hasAuthor rirpdo:Researcher_Mueller ;
    rirpdo:hasTopic rirpdo:KnowledgeGraphs .

rirpdo:Pub_LinkedResearch
    a rirpdo:Publication ;
    rirpdo:title "Linked Open Data for Research Infrastructure" ;
    rirpdo:year "2022"^^xsd:gYear ;
    rirpdo:hasAuthor rirpdo:Researcher_Mueller ;
    rirpdo:hasTopic rirpdo:LinkedData ;
    rirpdo:hasTopic rirpdo:KnowledgeGraphs ;
    rirpdo:publishedIn rirpdo:Journal_SWJ .

# ── Infrastructure ────────────────────────────────────────────────────────────

rirpdo:Lab_FOKUS_SemanticTech
    a rirpdo:Laboratory ;
    rirpdo:name "FOKUS Semantic Technologies Lab" .

rirpdo:Repo_TUBerlin_OpenData
    a rirpdo:ResearchDataRepository ;
    rirpdo:name "TU Berlin Open Research Data Repository" .

# ── Datasets ──────────────────────────────────────────────────────────────────

rirpdo:Dataset_LOPDFCorpus
    a rirpdo:Dataset ;
    rirpdo:name "LOPDF Scientific Document Corpus" .

rirpdo:Dataset_KGBenchmark
    a rirpdo:Dataset ;
    rirpdo:name "Knowledge Graph Construction Benchmark" .

# ── Funding ───────────────────────────────────────────────────────────────────

rirpdo:Funding_BMBF_2020
    a rirpdo:Funding ;
    rirpdo:name "BMBF Open Science Grant 2020" .

# ── Projects ──────────────────────────────────────────────────────────────────

rirpdo:Project_LOPDF
    a rirpdo:Project ;
    rirpdo:name "LOPDF Project" ;
    rirpdo:hasParticipant     rirpdo:Researcher_Aslam ;
    rirpdo:usesInfrastructure rirpdo:Lab_FOKUS_SemanticTech ;
    rirpdo:usesInfrastructure rirpdo:Cloud_FOKUS_AWS ;
    rirpdo:usesInfrastructure rirpdo:Git_LOPDF ;
    rirpdo:producedDataset    rirpdo:Dataset_LOPDFCorpus ;
    rirpdo:fundedBy           rirpdo:Funding_BMBF_2020 .

rirpdo:Project_KGSurvey
    a rirpdo:Project ;
    rirpdo:name "Knowledge Graph Survey Project" ;
    rirpdo:hasParticipant     rirpdo:Researcher_Smith ;
    rirpdo:hasParticipant     rirpdo:Researcher_Mueller ;
    rirpdo:usesInfrastructure rirpdo:Repo_TUBerlin_OpenData ;
    rirpdo:usesInfrastructure rirpdo:Cluster_TUBerlin ;
    rirpdo:usesInfrastructure rirpdo:Git_KGSurvey ;
    rirpdo:producedDataset    rirpdo:Dataset_KGBenchmark .

# ── Journals ──────────────────────────────────────────────────────────────────

rirpdo:Journal_SWJ
    a rirpdo:Journal ;
    rirpdo:name "Semantic Web Journal" .

rirpdo:Journal_JODS
    a rirpdo:Journal ;
    rirpdo:name "Journal of Data Semantics" .

