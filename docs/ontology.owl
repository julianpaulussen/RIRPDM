<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.example.org/rirpdm#"
     xml:base="http://www.example.org/rirpdm"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:ns="http://www.w3.org/2003/06/sw-vocab-status/ns#"
     xmlns:mod="https://w3id.org/mod#"
     xmlns:org="http://www.w3.org/ns/org#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:wot="http://xmlns.com/wot/0.1/"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:bibo="http://purl.org/ontology/bibo/"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:owl2="http://purl.org/cerif/frapo/owl:"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vaem="http://www.linkedmodel.org/schema/vaem#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:cerro="http://purl.org/cerif/cerro/"
     xmlns:frapo="http://purl.org/cerif/frapo/"
     xmlns:skos1="http://www.w3.org/2008/05/skos#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:vocab="https://w3id.org/widoco/vocab#"
     xmlns:rirpdm="http://www.example.org/rirpdm#"
     xmlns:schema="https://schema.org/"
     xmlns:sw-vocab-status="http://www.w3.org/2003/06/sw-vocab-status/"
     xmlns:cpannotationschema="http://www.ontologydesignpatterns.org/schemas/cpannotationschema.owl#">
    <owl:Ontology rdf:about="http://www.example.org/rirpdm">
        <owl:imports rdf:resource="http://purl.org/cerif/frapo/"/>
        <owl:imports rdf:resource="http://purl.org/spar/cito"/>
        <owl:imports rdf:resource="http://purl.org/spar/fabio"/>
        <owl:imports rdf:resource="http://www.w3.org/2004/02/skos/core#"/>
        <owl:imports rdf:resource="http://www.w3.org/ns/org#"/>
        <owl:imports rdf:resource="http://xmlns.com/foaf/0.1/"/>
        <terms:creator>Julian Paulussen</terms:creator>
        <terms:description xml:lang="en">OWL 2 ontology for knowledge representation and reasoning over scientific research infrastructure and publications.</terms:description>
        <terms:title xml:lang="en">Research Infrastructure and Research Publications Data Model (RIRPDM)</terms:title>
        <rdfs:comment xml:lang="en">Imports of fabio and cito are resolved via catalog-v001.xml to locally patched copies (ontology/fabio.owl, ontology/cito.owl): upstream published files assert untyped dcterms:created/modified literals on their own ontology IRI, violating the xsd:dateTime range they themselves declare, which makes the raw remote files OWL-inconsistent (owl:Thing SubClassOf owl:Nothing). Only those two literals were retyped; no domain classes/properties/axioms were altered.</rdfs:comment>
        <owl:versionInfo>0.1.0</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.example.org/rirpdm#status -->


    <owl:AnnotationProperty rdf:about="http://www.example.org/rirpdm#status">
        <rdfs:comment xml:lang="en">Editorial status of the term: New, Extended, or Adopted.</rdfs:comment>
        <rdfs:label xml:lang="en">status</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/cerif/frapo/awards -->


    <owl:ObjectProperty rdf:about="http://purl.org/cerif/frapo/awards">
        <terms:source>FRAPO</terms:source>
        <status>Adopted</status>
        <rdfs:label xml:lang="en">awards</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/cerif/frapo/funds -->


    <owl:ObjectProperty rdf:about="http://purl.org/cerif/frapo/funds">
        <terms:source>FRAPO</terms:source>
        <status>Adopted</status>
        <rdfs:label xml:lang="en">funds</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/cerif/frapo/isAwardedBy -->


    <owl:ObjectProperty rdf:about="http://purl.org/cerif/frapo/isAwardedBy">
        <owl:inverseOf rdf:resource="http://purl.org/cerif/frapo/awards"/>
        <terms:source>FRAPO</terms:source>
        <status>Adopted</status>
        <rdfs:label xml:lang="en">is awarded by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/cerif/frapo/isFundedBy -->


    <owl:ObjectProperty rdf:about="http://purl.org/cerif/frapo/isFundedBy">
        <owl:inverseOf rdf:resource="http://purl.org/cerif/frapo/funds"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <terms:source>FRAPO</terms:source>
        <status>Adopted</status>
        <rdfs:label xml:lang="en">is funded by</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://vivoweb.org/ontology/core#fundedBy"/>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/spar/cito/cites -->


    <owl:ObjectProperty rdf:about="http://purl.org/spar/cito/cites">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/rirpdm#ScientificPublication"/>
        <rdfs:range rdf:resource="http://www.example.org/rirpdm#ResearchOutput"/>
        <terms:source>CiTO</terms:source>
        <status>Adopted</status>
        <rdfs:comment xml:lang="en">The citing entity cites the cited entity.</rdfs:comment>
        <rdfs:label xml:lang="en">cites</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/spar/cito/citesAsEvidence -->


    <owl:ObjectProperty rdf:about="http://purl.org/spar/cito/citesAsEvidence">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/spar/cito/cites"/>
        <terms:source>CiTO</terms:source>
        <status>Adopted</status>
        <rdfs:comment xml:lang="en">The citing entity cites the cited entity as evidence.</rdfs:comment>
        <rdfs:label xml:lang="en">cites as evidence</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/spar/cito/disputes -->


    <owl:ObjectProperty rdf:about="http://purl.org/spar/cito/disputes">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/spar/cito/cites"/>
        <terms:source>CiTO</terms:source>
        <status>Adopted</status>
        <rdfs:comment xml:lang="en">The citing entity disputes a statement in the cited entity.</rdfs:comment>
        <rdfs:label xml:lang="en">disputes</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/spar/cito/extends -->


    <owl:ObjectProperty rdf:about="http://purl.org/spar/cito/extends">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/spar/cito/cites"/>
        <terms:source>CiTO</terms:source>
        <status>Adopted</status>
        <rdfs:comment xml:lang="en">The citing entity extends the cited work.</rdfs:comment>
        <rdfs:label xml:lang="en">extends</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/spar/cito/isCitedBy -->


    <owl:ObjectProperty rdf:about="http://purl.org/spar/cito/isCitedBy">
        <owl:inverseOf rdf:resource="http://purl.org/spar/cito/cites"/>
        <terms:source>CiTO</terms:source>
        <status>Adopted</status>
        <rdfs:label xml:lang="en">is cited by</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/spar/cito/usesDataFrom -->


    <owl:ObjectProperty rdf:about="http://purl.org/spar/cito/usesDataFrom">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/spar/cito/cites"/>
        <terms:source>CiTO</terms:source>
        <status>Adopted</status>
        <rdfs:comment xml:lang="en">The citing entity uses data from the cited entity.</rdfs:comment>
        <rdfs:label xml:lang="en">uses data from</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/spar/cito/usesMethodIn -->


    <owl:ObjectProperty rdf:about="http://purl.org/spar/cito/usesMethodIn">
        <rdfs:subPropertyOf rdf:resource="http://purl.org/spar/cito/cites"/>
        <terms:source>CiTO</terms:source>
        <status>Adopted</status>
        <rdfs:comment xml:lang="en">The citing entity uses a method described in the cited entity.</rdfs:comment>
        <rdfs:label xml:lang="en">uses method in</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/spar/fabio/hasPublicationVenue -->


    <owl:ObjectProperty rdf:about="http://purl.org/spar/fabio/hasPublicationVenue">
        <rdfs:domain rdf:resource="http://www.example.org/rirpdm#ScientificPublication"/>
        <rdfs:range rdf:resource="http://purl.org/spar/fabio/Journal"/>
        <terms:source>FaBiO</terms:source>
        <status>Adopted</status>
        <rdfs:comment xml:lang="en">Relates a publication to the journal or proceedings it appeared in.</rdfs:comment>
        <rdfs:label xml:lang="en">has publication venue</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/rirpdm#assessedAtPhase -->


    <owl:ObjectProperty rdf:about="http://www.example.org/rirpdm#assessedAtPhase">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/rirpdm#Evaluation"/>
        <rdfs:range rdf:resource="http://www.example.org/rirpdm#LifecyclePhase"/>
        <terms:source>ESFRI Roadmap 2026</terms:source>
        <status>New</status>
        <rdfs:comment xml:lang="en">The lifecycle phase at which an Evaluation was made.</rdfs:comment>
        <rdfs:label xml:lang="en">assessedAtPhase</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/rirpdm#authorOf -->


    <owl:ObjectProperty rdf:about="http://www.example.org/rirpdm#authorOf">
        <owl:inverseOf rdf:resource="http://www.example.org/rirpdm#hasAuthor"/>
        <rdfs:domain rdf:resource="http://www.example.org/rirpdm#Researcher"/>
        <rdfs:range rdf:resource="http://www.example.org/rirpdm#ScientificPublication"/>
        <terms:source>VIVO</terms:source>
        <status>Extended</status>
        <rdfs:comment xml:lang="en">Relates a researcher to a scientific publication they authored.</rdfs:comment>
        <rdfs:label xml:lang="en">authorOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/rirpdm#collaboratesWith -->


    <owl:ObjectProperty rdf:about="http://www.example.org/rirpdm#collaboratesWith">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/rirpdm#ResearchInstitution"/>
        <rdfs:range rdf:resource="http://www.example.org/rirpdm#ResearchInstitution"/>
        <terms:source>ESFRI Roadmap 2026</terms:source>
        <status>New</status>
        <rdfs:comment xml:lang="en">Two research institutions collaborate. Symmetry means asserting A→B is enough; B→A is inferred.</rdfs:comment>
        <rdfs:label xml:lang="en">collaboratesWith</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/rirpdm#contributesToRI -->


    <owl:ObjectProperty rdf:about="http://www.example.org/rirpdm#contributesToRI">
        <rdfs:domain rdf:resource="http://www.example.org/rirpdm#Researcher"/>
        <rdfs:range rdf:resource="http://www.example.org/rirpdm#ResearchInfrastructure"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.example.org/rirpdm#authorOf"/>
            <rdf:Description rdf:about="http://www.example.org/rirpdm#isOutputOf"/>
        </owl:propertyChainAxiom>
        <terms:source>ESFRI Roadmap 2026</terms:source>
        <status>New</status>
        <rdfs:comment xml:lang="en">A researcher contributed to a research infrastructure via a publication they authored that is an output of that RI. Inferred via property chain: authorOf o isOutputOf.</rdfs:comment>
        <rdfs:label xml:lang="en">contributesToRI</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/rirpdm#evaluatesDimension -->


    <owl:ObjectProperty rdf:about="http://www.example.org/rirpdm#evaluatesDimension">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/rirpdm#Evaluation"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.example.org/rirpdm#ImplementationDimension"/>
                    <rdf:Description rdf:about="http://www.example.org/rirpdm#ScientificDimension"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <terms:source>ESFRI Roadmap 2026</terms:source>
        <status>New</status>
        <rdfs:comment xml:lang="en">The scientific or implementation dimension that an Evaluation assesses.</rdfs:comment>
        <rdfs:label xml:lang="en">evaluatesDimension</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/rirpdm#hasAuthor -->


    <owl:ObjectProperty rdf:about="http://www.example.org/rirpdm#hasAuthor">
        <rdfs:domain rdf:resource="http://www.example.org/rirpdm#ScientificPublication"/>
        <rdfs:range rdf:resource="http://www.example.org/rirpdm#Researcher"/>
        <terms:source>VIVO</terms:source>
        <status>Extended</status>
        <rdfs:comment xml:lang="en">Relates a scientific publication to a researcher who authored it.</rdfs:comment>
        <rdfs:label xml:lang="en">hasAuthor</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://vivoweb.org/ontology/core#hasAuthor"/>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/rirpdm#hasCentralHub -->


    <owl:ObjectProperty rdf:about="http://www.example.org/rirpdm#hasCentralHub">
        <rdfs:domain rdf:resource="http://www.example.org/rirpdm#DistributedRI"/>
        <rdfs:range rdf:resource="http://www.example.org/rirpdm#CentralHub"/>
        <terms:source>ESFRI Roadmap 2026</terms:source>
        <status>New</status>
        <rdfs:comment xml:lang="en">Relates a distributed RI to its Central Hub, the truly international organisation that must guarantee effective operation, attribute optimal personnel capacity and coordinating power, and mediate across different scientific cultures. (ESFRI Roadmap 2026, p.15-16)</rdfs:comment>
        <rdfs:label xml:lang="en">hasCentralHub</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/rirpdm#hasEvaluation -->


    <owl:ObjectProperty rdf:about="http://www.example.org/rirpdm#hasEvaluation">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.example.org/rirpdm#ImplementationCase"/>
                    <rdf:Description rdf:about="http://www.example.org/rirpdm#ScientificCase"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.example.org/rirpdm#Evaluation"/>
        <terms:source>ESFRI Roadmap 2026</terms:source>
        <status>New</status>
        <rdfs:comment xml:lang="en">Links a case to one of its per-dimension evaluations.</rdfs:comment>
        <rdfs:label xml:lang="en">hasEvaluation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/rirpdm#hasImplementationCase -->


    <owl:ObjectProperty rdf:about="http://www.example.org/rirpdm#hasImplementationCase">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.example.org/rirpdm#Proposal"/>
                    <rdf:Description rdf:about="http://www.example.org/rirpdm#ResearchInfrastructure"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.example.org/rirpdm#ImplementationCase"/>
        <terms:source>ESFRI Roadmap 2026</terms:source>
        <status>New</status>
        <rdfs:comment xml:lang="en">Links a Proposal or Research Infrastructure to its Implementation Case assessment.</rdfs:comment>
        <rdfs:label xml:lang="en">hasImplementationCase</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/rirpdm#hasLeadEntity -->


    <owl:ObjectProperty rdf:about="http://www.example.org/rirpdm#hasLeadEntity">
        <rdfs:subPropertyOf rdf:resource="http://www.example.org/rirpdm#involvesAgent"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/rirpdm#ResearchInfrastructure"/>
        <rdfs:range rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
        <terms:source>ESFRI Roadmap 2026</terms:source>
        <status>New</status>
        <rdfs:comment xml:lang="en">The agent leading the research infrastructure.</rdfs:comment>
        <rdfs:label xml:lang="en">hasLeadEntity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/rirpdm#hasMemberEntity -->


    <owl:ObjectProperty rdf:about="http://www.example.org/rirpdm#hasMemberEntity">
        <rdfs:subPropertyOf rdf:resource="http://www.example.org/rirpdm#involvesAgent"/>
        <rdfs:domain rdf:resource="http://www.example.org/rirpdm#ResearchInfrastructure"/>
        <rdfs:range rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
        <terms:source>ESFRI Roadmap 2026</terms:source>
        <status>New</status>
        <rdfs:comment xml:lang="en">An agent that is a member of the research infrastructure.</rdfs:comment>
        <rdfs:label xml:lang="en">hasMemberEntity</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/rirpdm#hasNode -->


    <owl:ObjectProperty rdf:about="http://www.example.org/rirpdm#hasNode">
        <rdfs:domain rdf:resource="http://www.example.org/rirpdm#DistributedRI"/>
        <rdfs:range rdf:resource="http://www.example.org/rirpdm#NationalNode"/>
        <terms:source>ESFRI Roadmap 2026</terms:source>
        <status>New</status>
        <rdfs:comment xml:lang="en">Relates a distributed RI to one of its interlinked National Nodes, whose capacity and resources devoted to the RI must be clearly identified, coordinated and managed by the Central Hub. (ESFRI Roadmap 2026, p.15)</rdfs:comment>
        <rdfs:label xml:lang="en">hasNode</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/rirpdm#hasObserver -->


    <owl:ObjectProperty rdf:about="http://www.example.org/rirpdm#hasObserver">
        <rdfs:subPropertyOf rdf:resource="http://www.example.org/rirpdm#involvesAgent"/>
        <rdfs:domain rdf:resource="http://www.example.org/rirpdm#ResearchInfrastructure"/>
        <rdfs:range rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
        <terms:source>ESFRI Roadmap 2026</terms:source>
        <status>New</status>
        <rdfs:comment xml:lang="en">An agent observing the research infrastructure.</rdfs:comment>
        <rdfs:label xml:lang="en">hasObserver</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/rirpdm#hasParticipant -->


    <owl:ObjectProperty rdf:about="http://www.example.org/rirpdm#hasParticipant">
        <rdfs:subPropertyOf rdf:resource="http://www.example.org/rirpdm#involvesAgent"/>
        <rdfs:domain rdf:resource="http://www.example.org/rirpdm#ResearchInfrastructure"/>
        <rdfs:range rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
        <terms:source>ESFRI Roadmap 2026</terms:source>
        <status>New</status>
        <rdfs:comment xml:lang="en">An agent participating in the research infrastructure.</rdfs:comment>
        <rdfs:label xml:lang="en">hasParticipant</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/rirpdm#hasProspectiveMember -->


    <owl:ObjectProperty rdf:about="http://www.example.org/rirpdm#hasProspectiveMember">
        <rdfs:subPropertyOf rdf:resource="http://www.example.org/rirpdm#involvesAgent"/>
        <rdfs:domain rdf:resource="http://www.example.org/rirpdm#ResearchInfrastructure"/>
        <rdfs:range rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
        <terms:source>ESFRI Roadmap 2026</terms:source>
        <status>New</status>
        <rdfs:comment xml:lang="en">An agent that is a prospective member of the research infrastructure.</rdfs:comment>
        <rdfs:label xml:lang="en">hasProspectiveMember</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/rirpdm#hasScientificCase -->


    <owl:ObjectProperty rdf:about="http://www.example.org/rirpdm#hasScientificCase">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.example.org/rirpdm#Proposal"/>
                    <rdf:Description rdf:about="http://www.example.org/rirpdm#ResearchInfrastructure"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.example.org/rirpdm#ScientificCase"/>
        <terms:source>ESFRI Roadmap 2026</terms:source>
        <status>New</status>
        <rdfs:comment xml:lang="en">Links a Proposal or Research Infrastructure to its Scientific Case assessment.</rdfs:comment>
        <rdfs:label xml:lang="en">hasScientificCase</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/rirpdm#hasScore -->


    <owl:ObjectProperty rdf:about="http://www.example.org/rirpdm#hasScore">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/rirpdm#Evaluation"/>
        <rdfs:range rdf:resource="http://www.example.org/rirpdm#Score"/>
        <terms:source>ESFRI Roadmap 2026</terms:source>
        <status>New</status>
        <rdfs:comment xml:lang="en">The score attributed by an Evaluation.</rdfs:comment>
        <rdfs:label xml:lang="en">hasScore</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/rirpdm#indirectlyExposedTo -->


    <owl:ObjectProperty rdf:about="http://www.example.org/rirpdm#indirectlyExposedTo">
        <rdfs:domain rdf:resource="http://www.example.org/rirpdm#ResearchInfrastructure"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.org/cerif/frapo/FundingAgency"/>
                    <rdf:Description rdf:about="http://purl.org/cerif/frapo/FundingProgramme"/>
                    <rdf:Description rdf:about="http://purl.org/cerif/frapo/Grant"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.example.org/rirpdm#involvesAgent"/>
            <rdf:Description rdf:about="http://www.example.org/rirpdm#collaboratesWith"/>
            <rdf:Description rdf:about="http://www.example.org/rirpdm#participatesIn"/>
            <rdf:Description rdf:about="http://www.example.org/rirpdm#isSupportedBy"/>
        </owl:propertyChainAxiom>
        <status>New</status>
        <rdfs:comment xml:lang="en">An RI is indirectly exposed to a funding source through a collaborating partner RI&apos;s funding chain. Inferred via property chain: involvesAgent o collaboratesWith o participatesIn o isSupportedBy.</rdfs:comment>
        <rdfs:label xml:lang="en">indirectlyExposedTo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/rirpdm#involvesAgent -->


    <owl:ObjectProperty rdf:about="http://www.example.org/rirpdm#involvesAgent">
        <owl:inverseOf rdf:resource="http://www.example.org/rirpdm#participatesIn"/>
        <rdfs:domain rdf:resource="http://www.example.org/rirpdm#ResearchInfrastructure"/>
        <rdfs:range rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
        <terms:source>ESFRI Roadmap 2026</terms:source>
        <status>New</status>
        <rdfs:comment xml:lang="en">An agent is involved in this research infrastructure.</rdfs:comment>
        <rdfs:label xml:lang="en">involvesAgent</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/rirpdm#isInPhase -->


    <owl:ObjectProperty rdf:about="http://www.example.org/rirpdm#isInPhase">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/rirpdm#ResearchInfrastructure"/>
        <rdfs:range rdf:resource="http://www.example.org/rirpdm#LifecyclePhase"/>
        <terms:source>ESFRI Roadmap 2026</terms:source>
        <status>New</status>
        <rdfs:comment xml:lang="en">The current lifecycle phase of the research infrastructure.</rdfs:comment>
        <rdfs:label xml:lang="en">isInPhase</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/rirpdm#isNodeOf -->


    <owl:ObjectProperty rdf:about="http://www.example.org/rirpdm#isNodeOf">
        <owl:inverseOf rdf:resource="http://www.example.org/rirpdm#hasNode"/>
        <rdfs:domain rdf:resource="http://www.example.org/rirpdm#NationalNode"/>
        <rdfs:range rdf:resource="http://www.example.org/rirpdm#DistributedRI"/>
        <terms:source>ESFRI Roadmap 2026</terms:source>
        <status>New</status>
        <rdfs:comment xml:lang="en">The distributed RI this national node belongs to.</rdfs:comment>
        <rdfs:label xml:lang="en">isNodeOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/rirpdm#isOutputOf -->


    <owl:ObjectProperty rdf:about="http://www.example.org/rirpdm#isOutputOf">
        <owl:inverseOf rdf:resource="http://www.example.org/rirpdm#producesResearchOutput"/>
        <rdfs:domain rdf:resource="http://www.example.org/rirpdm#ResearchOutput"/>
        <rdfs:range rdf:resource="http://www.example.org/rirpdm#ResearchInfrastructure"/>
        <terms:source>EU Reg 2021 Art 2(22)</terms:source>
        <status>New</status>
        <rdfs:comment xml:lang="en">The research infrastructure that produced this output.</rdfs:comment>
        <rdfs:label xml:lang="en">isOutputOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/rirpdm#isSupportedBy -->


    <owl:ObjectProperty rdf:about="http://www.example.org/rirpdm#isSupportedBy">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.org/cerif/frapo/Grant"/>
                    <rdf:Description rdf:about="http://www.example.org/rirpdm#ResearchInfrastructure"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.org/cerif/frapo/FundingAgency"/>
                    <rdf:Description rdf:about="http://purl.org/cerif/frapo/FundingProgramme"/>
                    <rdf:Description rdf:about="http://purl.org/cerif/frapo/Grant"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <terms:source>ESFRI Roadmap 2026</terms:source>
        <status>New</status>
        <rdfs:comment xml:lang="en">Connects an RI (or grant) to its funding source at any level. Transitivity lets the reasoner infer the full chain: RI → Grant → FundingProgramme.</rdfs:comment>
        <rdfs:label xml:lang="en">isSupportedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/rirpdm#participatesIn -->


    <owl:ObjectProperty rdf:about="http://www.example.org/rirpdm#participatesIn">
        <rdfs:domain rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
        <rdfs:range rdf:resource="http://www.example.org/rirpdm#ResearchInfrastructure"/>
        <terms:source>ESFRI Roadmap 2026</terms:source>
        <status>New</status>
        <rdfs:comment xml:lang="en">An agent participates in a research infrastructure.</rdfs:comment>
        <rdfs:label xml:lang="en">participatesIn</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/rirpdm#producesResearchOutput -->


    <owl:ObjectProperty rdf:about="http://www.example.org/rirpdm#producesResearchOutput">
        <rdfs:domain rdf:resource="http://www.example.org/rirpdm#ResearchInfrastructure"/>
        <rdfs:range rdf:resource="http://www.example.org/rirpdm#ResearchOutput"/>
        <terms:source>EU Reg 2021 Art 2(22); Annex I(1)(c)</terms:source>
        <status>New</status>
        <rdfs:comment xml:lang="en">A research output produced by the research infrastructure.</rdfs:comment>
        <rdfs:label xml:lang="en">producesResearchOutput</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/rirpdm#resultsInProject -->


    <owl:ObjectProperty rdf:about="http://www.example.org/rirpdm#resultsInProject">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.example.org/rirpdm#Proposal"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.example.org/rirpdm#ESFRILandmark"/>
                    <rdf:Description rdf:about="http://www.example.org/rirpdm#ESFRIProject"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <terms:source>ESFRI Roadmap 2026</terms:source>
        <status>New</status>
        <rdfs:comment xml:lang="en">The transition from a Proposal to the resulting selected RI; carries ex ante to ex post.</rdfs:comment>
        <rdfs:label xml:lang="en">resultsInProject</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.example.org/rirpdm#upgradesRI -->


    <owl:ObjectProperty rdf:about="http://www.example.org/rirpdm#upgradesRI">
        <rdfs:domain rdf:resource="http://www.example.org/rirpdm#MajorUpgrade"/>
        <rdfs:range rdf:resource="http://www.example.org/rirpdm#ResearchInfrastructure"/>
        <terms:source>ESFRI Roadmap 2026</terms:source>
        <status>New</status>
        <rdfs:comment xml:lang="en">The operational RI that a Major Upgrade proposal targets.</rdfs:comment>
        <rdfs:label xml:lang="en">upgradesRI</rdfs:label>
    </owl:ObjectProperty>
    


