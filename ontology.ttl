:NumberOfPubliclyAvailableDataSetsUsedExternally rdf:type owl:NamedIndividual ,
                                                          :KPI ;
                                                 :forObjective :OptimisingDataUse ;
                                                 :unitOfMeasure "Number of data users" ;
