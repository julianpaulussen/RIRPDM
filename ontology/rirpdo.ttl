@prefix rirpdo:   <http://www.example.org/rirpdo#> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix foaf:     <http://xmlns.com/foaf/0.1/> .
@prefix dc:       <http://purl.org/dc/terms/> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix bibo:     <http://purl.org/ontology/bibo/> .
@prefix nfdicore: <https://nfdi.fiz-karlsruhe.de/ontology/> .
@prefix vivo:     <http://vivoweb.org/ontology/core#> .
@prefix cerif:    <https://w3id.org/cerif/vocab/> .
@prefix cerif-m:  <https://w3id.org/cerif/model#> .
@prefix swrl:     <http://www.w3.org/2003/11/swrl#> .
@prefix swrla:    <http://swrl.stanford.edu/ontologies/3.3/swrla.owl#> .

# ── Ontology declaration ─────────────────────────────────────────────────────

<http://www.example.org/rirpdo>
    a owl:Ontology ;
    dc:title "Research Infrastructure and Research Publications Data Ontology (RIRPDO)" ;
    dc:description "Core ontology for representing research infrastructure and scientific publications." ;
    owl:versionInfo "0.5.0" .

# ── Classes ──────────────────────────────────────────────────────────────────

rirpdo:Researcher
    a owl:Class ;
    rdfs:label "Researcher" ;
    rdfs:subClassOf foaf:Person ;
    skos:definition "A person who conducts scientific research, typically affiliated with an institution." .

rirpdo:Institution
    a owl:Class ;
    rdfs:label "Institution" ;
    rdfs:subClassOf foaf:Organization ;
    skos:definition "An organization that conducts, funds, or supports research activities, such as a university or research institute." .

# Institution type subclasses — from CERIF OrganisationTypes vocab
rirpdo:University
    a owl:Class ;
    rdfs:label "University" ;
    rdfs:subClassOf rirpdo:Institution ;
    skos:exactMatch <https://w3id.org/cerif/vocab/OrganisationTypes#University> ;
    dc:source cerif:OrganisationTypes ;
    skos:definition "An institution of higher education and research which grants academic degrees in a variety of subjects." .

rirpdo:ResearchInstitute
    a owl:Class ;
    rdfs:label "Research Institute" ;
    rdfs:subClassOf rirpdo:Institution ;
    skos:exactMatch <https://w3id.org/cerif/vocab/OrganisationTypes#ResearchInstitute> ;
    dc:source cerif:OrganisationTypes ;
    skos:definition "An establishment endowed for doing research, which may specialize in basic or applied research." .

rirpdo:Company
    a owl:Class ;
    rdfs:label "Company" ;
    rdfs:subClassOf rirpdo:Institution ;
    skos:exactMatch <https://w3id.org/cerif/vocab/OrganisationTypes#Company> ;
    dc:source cerif:OrganisationTypes ;
    skos:definition "A form of business organization carrying on industrial or commercial enterprise." .

rirpdo:Government
    a owl:Class ;
    rdfs:label "Government" ;
    rdfs:subClassOf rirpdo:Institution ;
    skos:exactMatch <https://w3id.org/cerif/vocab/OrganisationTypes#Government> ;
    dc:source cerif:OrganisationTypes ;
    skos:definition "An organization through which a political unit exercises authority and administers public policy." .

rirpdo:Publication
    a owl:Class ;
    rdfs:label "Publication" ;
    rdfs:subClassOf bibo:Document ;
    rdfs:subClassOf rirpdo:ResearchProduct ;
    skos:definition "A scholarly work published and shared with the research community, such as a journal article, conference paper, or technical report." .

rirpdo:Patent
    a owl:Class ;
    rdfs:label "Patent" ;
    rdfs:subClassOf rirpdo:Publication ;
    skos:exactMatch cerif-m:cfResPat ;
    skos:definition "A form of intellectual property consisting of exclusive rights granted to an inventor for a limited period in exchange for public disclosure of an invention." ;
    dc:source cerif-m:cfResPat .

# Publication subclasses — from CERIF OutputTypes vocab
rirpdo:JournalArticle
    a owl:Class ;
    rdfs:label "Journal Article" ;
    rdfs:subClassOf rirpdo:Publication ;
    skos:exactMatch <https://w3id.org/cerif/vocab/OutputTypes#JournalArticle> ;
    skos:exactMatch bibo:AcademicArticle ;
    dc:source cerif:OutputTypes ;
    skos:definition "A self-contained nonfiction prose composition on a fairly narrow topic published in a journal." .

rirpdo:ConferencePaper
    a owl:Class ;
    rdfs:label "Conference Paper" ;
    rdfs:subClassOf rirpdo:Publication ;
    skos:exactMatch <https://w3id.org/cerif/vocab/OutputTypes#ConferenceProceedingsArticle> ;
    dc:source cerif:OutputTypes ;
    skos:definition "An article presented at a conference and published in conference proceedings." .

rirpdo:Thesis
    a owl:Class ;
    rdfs:label "Thesis" ;
    rdfs:subClassOf rirpdo:Publication ;
    skos:exactMatch <https://w3id.org/cerif/vocab/OutputTypes#PhDThesis> ;
    dc:source cerif:OutputTypes ;
    skos:definition "A dissertation or thesis submitted for an academic degree, such as a PhD or doctoral degree." .

rirpdo:WorkingPaper
    a owl:Class ;
    rdfs:label "Working Paper" ;
    rdfs:subClassOf rirpdo:Publication ;
    skos:exactMatch <https://w3id.org/cerif/vocab/OutputTypes#WorkingPaper> ;
    dc:source cerif:OutputTypes ;
    skos:definition "A preliminary version of an article that has not undergone peer review but is shared for comment." .

rirpdo:Report
    a owl:Class ;
    rdfs:label "Report" ;
    rdfs:subClassOf rirpdo:Publication ;
    skos:exactMatch <https://w3id.org/cerif/vocab/OutputTypes#Report> ;
    dc:source cerif:OutputTypes ;
    skos:definition "A separately published record of research findings, research still in progress, or other technical findings." .

rirpdo:ResearchTopic
    a owl:Class ;
    rdfs:label "Research Topic" ;
    skos:closeMatch skos:Concept ;
    rdfs:seeAlso nfdicore:NFDI_0000100 ;       # nfdicore:academic discipline
    skos:definition "A subject area or field that a publication or research project addresses." .

rirpdo:Keyword
    a owl:Class ;
    rdfs:label "Keyword" ;
    skos:definition "A free-text term or phrase assigned by an author to characterize the content of a publication or dataset." .

rirpdo:Domain
    a owl:Class ;
    rdfs:label "Domain" ;
    skos:closeMatch skos:Concept ;
    skos:definition "A broad scientific or academic discipline to which a publication, project, or researcher belongs (e.g. Computer Science, Biology)." .

rirpdo:Project
    a owl:Class ;
    rdfs:label "Project" ;
    rdfs:seeAlso nfdicore:NFDI_0000002 ;       # nfdicore:project
    skos:definition "A funded research activity with defined goals, participants, and a start and end date." .

rirpdo:ResearchInfrastructure
    a owl:Class ;
    rdfs:label "Research Infrastructure" ;
    skos:definition "A facility or (virtual) platform that provides the scientific community with resources and services to conduct top-level research in their respective fields. These research infrastructures can be single-sited or distributed or an e-infrastructure, and can be part of a national or international network of facilities, or of interconnected scientific instrument networks." ;
    skos:exactMatch <https://w3id.org/cerif/vocab/ResearchInfrastructure#ResearchInfrastructure> ;
    dc:source cerif:ResearchInfrastructure .

rirpdo:Facility
    a owl:Class ;
    rdfs:label "Facility" ;
    rdfs:subClassOf rirpdo:ResearchInfrastructure ;
    skos:exactMatch cerif-m:cfFacil ;
    skos:definition "A space or equipment necessary for conducting research, such as a laboratory or observatory." ;
    dc:source cerif-m:cfFacil .

rirpdo:Laboratory
    a owl:Class ;
    rdfs:label "Laboratory" ;
    rdfs:subClassOf rirpdo:Facility ;
    rdfs:seeAlso nfdicore:NFDI_0001208 ;       # nfdicore:laboratory
    skos:definition "A physical or virtual space where researchers conduct experiments and empirical work." .

rirpdo:Equipment
    a owl:Class ;
    rdfs:label "Equipment" ;
    rdfs:subClassOf rirpdo:ResearchInfrastructure ;
    skos:exactMatch cerif-m:cfEquip ;
    skos:definition "An instrumentality needed for an undertaking or to perform a service, such as scientific instruments and devices used in research." ;
    dc:source cerif-m:cfEquip .

rirpdo:InfrastructureService
    a owl:Class ;
    rdfs:label "Infrastructure Service" ;
    rdfs:subClassOf rirpdo:ResearchInfrastructure ;
    skos:exactMatch cerif-m:cfSrv ;
    skos:definition "A service or digital resource provided to the research community, including computing platforms, data repositories, and communication networks." ;
    dc:source cerif-m:cfSrv .

rirpdo:ResearchDataRepository
    a owl:Class ;
    rdfs:label "Research Data Repository" ;
    rdfs:subClassOf rirpdo:InfrastructureService ;
    rdfs:seeAlso nfdicore:NFDI_0001201 ;       # nfdicore:research data repository
    skos:definition "A storage system for archiving and sharing research datasets, typically with persistent identifiers (e.g. Zenodo, Figshare)." .

rirpdo:GitRepository
    a owl:Class ;
    rdfs:label "Git Repository" ;
    rdfs:subClassOf rirpdo:ResearchDataRepository ;
    skos:definition "A version-controlled repository hosting research code and software artifacts (e.g. GitHub, GitLab)." .

rirpdo:ComputingEnvironment
    a owl:Class ;
    rdfs:label "Computing Environment" ;
    rdfs:subClassOf rirpdo:InfrastructureService ;
    skos:definition "Any computational resource used to execute research workloads, including clusters and cloud platforms." .

rirpdo:ComputeCluster
    a owl:Class ;
    rdfs:label "High-Performance Computing (HPC) Cluster" ;
    rdfs:subClassOf rirpdo:ComputingEnvironment ;
    skos:definition "A set of linked compute nodes used for high-performance or parallel computing in research (e.g. HPC clusters)." .

rirpdo:CloudInfrastructure
    a owl:Class ;
    rdfs:label "Cloud Infrastructure" ;
    rdfs:subClassOf rirpdo:ComputingEnvironment ;
    skos:definition "On-demand cloud computing resources used for research workloads (e.g. AWS, Azure, Google Cloud)." .

# ── RI Type concepts (CERIF ResearchInfrastructureTypes) ─────────────────────

rirpdo:RITypeDistributed
    a skos:Concept ;
    rdfs:label "Distributed" ;
    skos:exactMatch <https://w3id.org/cerif/vocab/ResearchInfrastructureTypes#Distributed> ;
    skos:inScheme cerif:ResearchInfrastructureTypes ;
    skos:definition "A distributed RI constituted by geographically distributed implementations or facilities but managed by a single body." .

rirpdo:RITypeNetwork
    a skos:Concept ;
    rdfs:label "Network" ;
    skos:exactMatch <https://w3id.org/cerif/vocab/ResearchInfrastructureTypes#Network> ;
    skos:inScheme cerif:ResearchInfrastructureTypes ;
    skos:definition "A network of RIs comprising several RIs connected in some respect, but each with its own governance or management body." .

rirpdo:RITypeVirtual
    a skos:Concept ;
    rdfs:label "Virtual" ;
    skos:exactMatch <https://w3id.org/cerif/vocab/ResearchInfrastructureTypes#Virtual> ;
    skos:inScheme cerif:ResearchInfrastructureTypes ;
    skos:definition "A virtual RI defined as e-infrastructure, either a distributed e-infrastructure that connects several RIs or a single-sited electronic RI." .

rirpdo:RITypeCluster
    a skos:Concept ;
    rdfs:label "Cluster" ;
    skos:exactMatch <https://w3id.org/cerif/vocab/ResearchInfrastructureTypes#Cluster> ;
    skos:inScheme cerif:ResearchInfrastructureTypes ;
    skos:definition "A grouping of RIs based on certain similarities such as scientific domain or geographical region." .

rirpdo:RITypeSingleLocation
    a skos:Concept ;
    rdfs:label "Single Location" ;
    skos:exactMatch <https://w3id.org/cerif/vocab/ResearchInfrastructureTypes#SingleLocation> ;
    skos:inScheme cerif:ResearchInfrastructureTypes ;
    skos:definition "A research infrastructure located at a single physical site." .

rirpdo:ResearchGroup
    a owl:Class ;
    rdfs:label "Research Group" ;
    rdfs:subClassOf foaf:Group ;
    skos:definition "A team of researchers collaborating on a shared scientific topic, typically within an institution." .

rirpdo:Journal
    a owl:Class ;
    rdfs:label "Journal" ;
    owl:equivalentClass bibo:Journal ;
    skos:definition "A periodical publication in which researchers publish peer-reviewed articles." .

rirpdo:Conference
    a owl:Class ;
    rdfs:label "Conference" ;
    rdfs:seeAlso nfdicore:NFDI_0010020 ;       # nfdicore:conference
    skos:definition "An academic event where researchers present and discuss their work." .

rirpdo:ResearchProduct
    a owl:Class ;
    rdfs:label "Research Product" ;
    skos:exactMatch cerif-m:cfResProd ;
    skos:definition "Any digital or physical output of a research activity, including datasets, software, and other artefacts." ;
    dc:source cerif-m:cfResProd .

rirpdo:Dataset
    a owl:Class ;
    rdfs:label "Dataset" ;
    rdfs:subClassOf rirpdo:ResearchProduct ;
    rdfs:seeAlso nfdicore:NFDI_0001203 ;       # nfdicore:experimental dataset
    skos:definition "A structured collection of data produced or used in a research project." .

rirpdo:Software
    a owl:Class ;
    rdfs:label "Software" ;
    rdfs:subClassOf rirpdo:ResearchProduct ;
    skos:exactMatch <https://w3id.org/cerif/vocab/OutputTypes#Software> ;
    dc:source cerif:OutputTypes ;
    skos:definition "A research software artefact — computer programs and associated documentation produced as part of a research activity." .

rirpdo:Funding
    a owl:Class ;
    rdfs:label "Funding" ;
    rdfs:seeAlso nfdicore:NFDI_0001051 ;       # nfdicore:funding specification
    skos:definition "Financial support granted to a research project, typically by a government body or foundation." .

# Funding type subclasses — from CERIF ActivityFundingTypes vocab
rirpdo:Grant
    a owl:Class ;
    rdfs:label "Grant" ;
    rdfs:subClassOf rirpdo:Funding ;
    skos:exactMatch <https://w3id.org/cerif/vocab/ActivityFundingTypes#Grant> ;
    dc:source cerif:ActivityFundingTypes ;
    skos:definition "A funding mechanism where a proposed activity is submitted for consideration and funding is approved upon merit." .

rirpdo:Award
    a owl:Class ;
    rdfs:label "Award" ;
    rdfs:subClassOf rirpdo:Funding ;
    skos:exactMatch <https://w3id.org/cerif/vocab/ActivityFundingTypes#Award> ;
    dc:source cerif:ActivityFundingTypes ;
    skos:definition "Discretionary funds awarded based on an achievement or recognized contribution." .

rirpdo:Contract
    a owl:Class ;
    rdfs:label "Contract" ;
    rdfs:subClassOf rirpdo:Funding ;
    skos:exactMatch <https://w3id.org/cerif/vocab/ActivityFundingTypes#Contract> ;
    dc:source cerif:ActivityFundingTypes ;
    skos:definition "A funding mechanism where funding is approved and allocated upon successful delivery of proposed outputs." .

# ── VIVO alignment ───────────────────────────────────────────────────────────

rirpdo:Researcher        rdfs:seeAlso           vivo:ResearcherRole .
rirpdo:ResearchGroup     rdfs:seeAlso           vivo:ResearchOrganization .
rirpdo:Laboratory        rdfs:seeAlso           vivo:Laboratory .
rirpdo:Project           rdfs:seeAlso           vivo:Project .

rirpdo:hasAuthor         rdfs:seeAlso           vivo:hasAuthor .
rirpdo:affiliatedWith    rdfs:seeAlso           vivo:affiliatedWith .
rirpdo:fundedBy          rdfs:seeAlso           vivo:fundedBy .
rirpdo:memberOf          rdfs:seeAlso           vivo:memberOf .

# ── Disjoint classes ──────────────────────────────────────────────────────────

rirpdo:Researcher owl:disjointWith rirpdo:Publication .
rirpdo:Researcher owl:disjointWith rirpdo:ResearchInfrastructure .
rirpdo:Researcher owl:disjointWith rirpdo:ResearchTopic .
rirpdo:Researcher owl:disjointWith rirpdo:Institution .
rirpdo:Publication owl:disjointWith rirpdo:ResearchInfrastructure .
rirpdo:Publication owl:disjointWith rirpdo:Project .
rirpdo:Institution owl:disjointWith rirpdo:Publication .
rirpdo:Project owl:disjointWith rirpdo:ResearchInfrastructure .
rirpdo:Funding owl:disjointWith rirpdo:Publication .
rirpdo:Funding owl:disjointWith rirpdo:Researcher .

# ── Cardinality restrictions ──────────────────────────────────────────────────

rirpdo:Project
    rdfs:subClassOf [
        a owl:Restriction ;
        owl:onProperty rirpdo:hasParticipant ;
        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        owl:onClass rirpdo:Researcher
    ] .

# ── Object properties ────────────────────────────────────────────────────────

rirpdo:hasAuthor
    a owl:ObjectProperty, owl:IrreflexiveProperty ;
    rdfs:label "hasAuthor" ;
    rdfs:domain rirpdo:Publication ;
    rdfs:range  rirpdo:Researcher ;
    owl:inverseOf rirpdo:authorOf .

rirpdo:authorOf
    a owl:ObjectProperty, owl:IrreflexiveProperty ;
    rdfs:label "authorOf" ;
    rdfs:domain rirpdo:Researcher ;
    rdfs:range  rirpdo:Publication ;
    owl:inverseOf rirpdo:hasAuthor .

rirpdo:affiliatedWith
    a owl:ObjectProperty ;
    rdfs:label "affiliatedWith" ;
    rdfs:domain rirpdo:Researcher ;
    rdfs:range  rirpdo:Institution ;
    owl:inverseOf rirpdo:hasAffiliate .

rirpdo:hasAffiliate
    a owl:ObjectProperty ;
    rdfs:label "hasAffiliate" ;
    rdfs:domain rirpdo:Institution ;
    rdfs:range  rirpdo:Researcher ;
    owl:inverseOf rirpdo:affiliatedWith .

rirpdo:hasTopic
    a owl:ObjectProperty ;
    rdfs:label "hasTopic" ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( rirpdo:Publication rirpdo:Project ) ] ;
    rdfs:range  rirpdo:ResearchTopic .

rirpdo:hasParticipant
    a owl:ObjectProperty ;
    rdfs:label "hasParticipant" ;
    rdfs:domain rirpdo:Project ;
    rdfs:range  rirpdo:Researcher .

rirpdo:usesInfrastructure
    a owl:ObjectProperty ;
    rdfs:label "usesInfrastructure" ;
    rdfs:domain rirpdo:Project ;
    rdfs:range  rirpdo:ResearchInfrastructure .

rirpdo:producedUsing
    a owl:ObjectProperty ;
    rdfs:label "producedUsing" ;
    skos:definition "Relates a publication to the research infrastructure that enabled its production." ;
    rdfs:domain rirpdo:Publication ;
    rdfs:range  rirpdo:ResearchInfrastructure ;
    # Chain instead of direct property
    # the same researcher authored the paper AND participated in the project using the infrastructure.
    # Publication -> [inv hasAuthor] -> Researcher -> [inv hasParticipant] -> Project -> [usesInfrastructure] -> Infrastructure
    owl:propertyChainAxiom (
        [ owl:inverseOf rirpdo:hasAuthor ]
        [ owl:inverseOf rirpdo:hasParticipant ]
        rirpdo:usesInfrastructure
    ) .

rirpdo:memberOf
    a owl:ObjectProperty ;
    rdfs:label "memberOf" ;
    rdfs:domain rirpdo:Researcher ;
    rdfs:range  rirpdo:ResearchGroup .

rirpdo:fundedBy
    # Asymmetric Property: A->B does not imply B->A
    # Irreflexive Property: A->A is not allowed
    a owl:ObjectProperty, owl:AsymmetricProperty, owl:IrreflexiveProperty ;
    rdfs:label "fundedBy" ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( rirpdo:Project rirpdo:ResearchInfrastructure ) ] ;
    rdfs:range  rirpdo:Funding ;
    owl:inverseOf rirpdo:funds ;
    skos:narrowMatch cerif-m:cfProj_Fund ;
    skos:narrowMatch cerif-m:cfOrgUnit_Fund .

rirpdo:funds
    # Asymmetric Property: A->B does not imply B->A
    # Irreflexive Property: A->A is not allowed
    a owl:ObjectProperty, owl:AsymmetricProperty, owl:IrreflexiveProperty ;
    rdfs:label "funds" ;
    rdfs:domain rirpdo:Institution ;
    rdfs:range  rirpdo:Funding ;
    owl:inverseOf rirpdo:fundedBy ;
    skos:definition "An institution provides financial support for a project or research infrastructure." .

rirpdo:producedOutput
    a owl:ObjectProperty ;
    rdfs:label "producedOutput" ;
    rdfs:domain rirpdo:Project ;
    rdfs:range  rirpdo:ResearchProduct ;
    skos:narrowMatch cerif-m:cfProj_ResProd .

rirpdo:publishedIn
    a owl:ObjectProperty ;
    rdfs:label "publishedIn" ;
    rdfs:domain rirpdo:Publication ;
    rdfs:range  rirpdo:Journal .

rirpdo:presentedAt
    a owl:ObjectProperty ;
    rdfs:label "presentedAt" ;
    rdfs:domain rirpdo:Publication ;
    rdfs:range  rirpdo:Conference .

# Researcher project role subproperties — from CERIF PersonProjectEngagements
rirpdo:hasPrincipalInvestigator
    a owl:ObjectProperty ;
    rdfs:label "hasPrincipalInvestigator" ;
    rdfs:subPropertyOf rirpdo:hasParticipant ;
    rdfs:domain rirpdo:Project ;
    rdfs:range  rirpdo:Researcher ;
    skos:exactMatch <https://w3id.org/cerif/vocab/PersonProjectEngagements#PrincipalInvestigator> ;
    dc:source cerif:PersonProjectEngagements ;
    skos:definition "The lead researcher directing the project and responsible for reporting to funders." .

rirpdo:hasCoInvestigator
    a owl:ObjectProperty ;
    rdfs:label "hasCoInvestigator" ;
    rdfs:subPropertyOf rirpdo:hasParticipant ;
    rdfs:domain rirpdo:Project ;
    rdfs:range  rirpdo:Researcher ;
    skos:exactMatch <https://w3id.org/cerif/vocab/PersonProjectEngagements#Co-Investigator> ;
    dc:source cerif:PersonProjectEngagements ;
    skos:definition "A fellow researcher collaborating on the project, often from a different organization." .

rirpdo:hasCollaborator
    a owl:ObjectProperty ;
    rdfs:label "hasCollaborator" ;
    rdfs:subPropertyOf rirpdo:hasParticipant ;
    rdfs:domain rirpdo:Project ;
    rdfs:range  rirpdo:Researcher ;
    skos:exactMatch <https://w3id.org/cerif/vocab/PersonProjectEngagements#Collaborator> ;
    dc:source cerif:PersonProjectEngagements ;
    skos:definition "A researcher formally participating in the project consortium." .

rirpdo:containsEquipment
    a owl:ObjectProperty ;
    rdfs:label "containsEquipment" ;
    rdfs:domain rirpdo:Facility ;
    rdfs:range  rirpdo:Equipment ;
    skos:exactMatch cerif-m:cfFacil_Equip .

rirpdo:providesService
    a owl:ObjectProperty ;
    rdfs:label "providesService" ;
    rdfs:domain rirpdo:ResearchInfrastructure ;
    rdfs:range  rirpdo:InfrastructureService ;
    skos:narrowMatch cerif-m:cfFacil_Srv ;
    skos:narrowMatch cerif-m:cfEquip_Srv .

rirpdo:owns
    a owl:ObjectProperty ;
    rdfs:label "owns" ;
    rdfs:domain rirpdo:Institution ;
    rdfs:range  rirpdo:ResearchInfrastructure ;
    owl:inverseOf rirpdo:ownedBy ;
    skos:narrowMatch cerif-m:cfOrgUnit_Equip ;
    skos:narrowMatch cerif-m:cfOrgUnit_Facil ;
    skos:narrowMatch cerif-m:cfOrgUnit_Srv .

rirpdo:ownedBy
    a owl:ObjectProperty ;
    rdfs:label "ownedBy" ;
    rdfs:domain rirpdo:ResearchInfrastructure ;
    rdfs:range  rirpdo:Institution ;
    owl:inverseOf rirpdo:owns .

rirpdo:usedInfrastructure
    a owl:ObjectProperty ;
    rdfs:label "usedInfrastructure" ;
    rdfs:domain rirpdo:Publication ;
    rdfs:range  rirpdo:ResearchInfrastructure ;
    skos:narrowMatch cerif-m:cfResPubl_Equip ;
    skos:narrowMatch cerif-m:cfResPubl_Facil .

rirpdo:hostedBy
    a owl:ObjectProperty ;
    rdfs:label "hostedBy" ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( rirpdo:ResearchGroup rirpdo:Laboratory ) ] ;
    rdfs:range  rirpdo:Institution ;
    skos:definition "The institution at which a research group or laboratory is located and operates." .

rirpdo:hasKeyword
    a owl:ObjectProperty ;
    rdfs:label "hasKeyword" ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( rirpdo:Publication rirpdo:Dataset ) ] ;
    rdfs:range  rirpdo:Keyword ;
    skos:definition "Associates a free-text keyword with a publication or dataset." .

rirpdo:belongsToDomain
    a owl:ObjectProperty ;
    rdfs:label "belongsToDomain" ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( rirpdo:Publication rirpdo:Project rirpdo:Researcher ) ] ;
    rdfs:range  rirpdo:Domain ;
    skos:definition "The broad scientific domain to which a publication, project, or researcher belongs." .

rirpdo:isPartOf
    a owl:ObjectProperty, owl:TransitiveProperty, owl:IrreflexiveProperty ;
    rdfs:label "isPartOf" ;
    rdfs:domain rirpdo:ResearchInfrastructure ;
    rdfs:range  rirpdo:ResearchInfrastructure ;
    owl:inverseOf rirpdo:hasPart ;
    skos:definition "A research infrastructure is a component of a larger research infrastructure." .

rirpdo:hasPart
    a owl:ObjectProperty, owl:TransitiveProperty, owl:IrreflexiveProperty ;
    rdfs:label "hasPart" ;
    rdfs:domain rirpdo:ResearchInfrastructure ;
    rdfs:range  rirpdo:ResearchInfrastructure ;
    owl:inverseOf rirpdo:isPartOf ;
    skos:definition "A research infrastructure contains another as a component part." .

rirpdo:storedIn
    a owl:ObjectProperty ;
    rdfs:label "storedIn" ;
    rdfs:domain rirpdo:Dataset ;
    rdfs:range  rirpdo:ResearchDataRepository ;
    skos:definition "The repository in which a dataset is archived and made accessible." .

# ── Data properties ──────────────────────────────────────────────────────────

rirpdo:name
    a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:range xsd:string .

rirpdo:title
    a owl:DatatypeProperty ;
    rdfs:label "title" ;
    rdfs:domain rirpdo:Publication ;
    rdfs:range xsd:string .

rirpdo:year
    a owl:DatatypeProperty ;
    rdfs:label "year" ;
    rdfs:domain rirpdo:Publication ;
    rdfs:range xsd:gYear .

rirpdo:doi
    a owl:DatatypeProperty ;
    rdfs:label "doi" ;
    rdfs:domain rirpdo:Publication ;
    rdfs:range xsd:string .

rirpdo:abstract
    a owl:DatatypeProperty ;
    rdfs:label "abstract" ;
    rdfs:domain rirpdo:Publication ;
    rdfs:range xsd:string .

rirpdo:startDate
    a owl:DatatypeProperty ;
    rdfs:label "startDate" ;
    rdfs:domain rirpdo:Project ;
    rdfs:range xsd:date .

rirpdo:endDate
    a owl:DatatypeProperty ;
    rdfs:label "endDate" ;
    rdfs:domain rirpdo:Project ;
    rdfs:range xsd:date .

rirpdo:amount
    a owl:DatatypeProperty ;
    rdfs:label "amount" ;
    rdfs:domain rirpdo:Funding ;
    rdfs:range xsd:decimal .

rirpdo:currency
    a owl:DatatypeProperty ;
    rdfs:label "currency" ;
    rdfs:domain rirpdo:Funding ;
    rdfs:range xsd:string ;
    skos:definition "ISO 4217 currency code for the funding amount (e.g. EUR, USD)." .

rirpdo:orcid
    a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "orcid" ;
    rdfs:domain rirpdo:Researcher ;
    rdfs:range xsd:string .

rirpdo:hasType
    a owl:ObjectProperty ;
    rdfs:label "hasType" ;
    rdfs:domain rirpdo:ResearchInfrastructure ;
    rdfs:range skos:Concept ;
    dc:source cerif:ResearchInfrastructureTypes ;
    skos:definition "The deployment topology or organisational type of a research infrastructure (e.g. Distributed, Virtual, Network)." .

rirpdo:hasStatus
    a owl:ObjectProperty ;
    rdfs:label "hasStatus" ;
    rdfs:domain rirpdo:ResearchInfrastructure ;
    rdfs:range skos:Concept ;
    dc:source cerif:ResearchInfrastructureStatuses ;
    skos:definition "Operational status of a research infrastructure." .

# ── RI Status concepts (CERIF ResearchInfrastructureStatuses) ────────────────

rirpdo:UnderConstruction
    a skos:Concept ;
    rdfs:label "Under Construction" ;
    skos:exactMatch <https://w3id.org/cerif/vocab/ResearchInfrastructureStatuses#UnderConstruction> ;
    skos:inScheme cerif:ResearchInfrastructureStatuses ;
    skos:definition "A research infrastructure that is currently being built or developed and not yet available for use." .

rirpdo:BeingUpgraded
    a skos:Concept ;
    rdfs:label "Being Upgraded" ;
    skos:exactMatch <https://w3id.org/cerif/vocab/ResearchInfrastructureStatuses#BeingUpgraded> ;
    skos:inScheme cerif:ResearchInfrastructureStatuses ;
    skos:definition "A research infrastructure undergoing major updates or improvements, possibly with limited availability." .

rirpdo:InOperation
    a skos:Concept ;
    rdfs:label "In Operation" ;
    skos:exactMatch <https://w3id.org/cerif/vocab/ResearchInfrastructureStatuses#InOperation> ;
    skos:inScheme cerif:ResearchInfrastructureStatuses ;
    skos:definition "A research infrastructure that is currently active and available to the research community." .

# ABox (individuals) is in rirpdo-individuals.ttl — load both files into GraphDB.

# ── SWRL Rules ───────────────────────────────────────────────────────────────

# producedUsing bridge: Publication ← hasAuthor ← Researcher ← hasParticipant ← Project → usesInfrastructure → Infrastructure
# Mirrors the owl:propertyChainAxiom above; needed for GraphDB (OWL2-RL doesn't support property chains).
rirpdo:rule_producedUsing
    a swrl:Imp ;
    swrla:isRuleEnabled "true"^^xsd:boolean ;
    rdfs:label "producedUsing bridge" ;
    swrl:body [
        a swrl:AtomList ;
        rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:propertyPredicate rirpdo:usesInfrastructure ;
                    swrl:argument1 rirpdo:p ; swrl:argument2 rirpdo:i ] ;
        rdf:rest [ a swrl:AtomList ;
            rdf:first [ a swrl:IndividualPropertyAtom ;
                        swrl:propertyPredicate rirpdo:hasParticipant ;
                        swrl:argument1 rirpdo:p ; swrl:argument2 rirpdo:r ] ;
            rdf:rest [ a swrl:AtomList ;
                rdf:first [ a swrl:IndividualPropertyAtom ;
                            swrl:propertyPredicate rirpdo:hasAuthor ;
                            swrl:argument1 rirpdo:pub ; swrl:argument2 rirpdo:r ] ;
                rdf:rest rdf:nil ] ] ] ;
    swrl:head [
        a swrl:AtomList ;
        rdf:first [ a swrl:IndividualPropertyAtom ;
                    swrl:propertyPredicate rirpdo:producedUsing ;
                    swrl:argument1 rirpdo:pub ; swrl:argument2 rirpdo:i ] ;
        rdf:rest rdf:nil ] .