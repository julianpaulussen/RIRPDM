<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:rirpdm="http://www.example.org/rirpdm#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="http://www.example.org/rirpdm#hasAuthor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">hasAuthor</rdfs:label>
    <rdfs:comment xml:lang="en">Relates a scientific publication to a researcher who authored it.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.example.org/rirpdm#ScientificPublication"/>
    <rdfs:range rdf:resource="http://www.example.org/rirpdm#Researcher"/>
    <owl:inverseOf rdf:resource="http://www.example.org/rirpdm#authorOf"/>
    <rdfs:seeAlso rdf:resource="http://vivoweb.org/ontology/core#hasAuthor"/>
    <rirpdm:status>Extended</rirpdm:status>
    <dcterms:source>VIVO</dcterms:source>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdm#ShareOfUsersAndPublicationsPerESFRICountry">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.example.org/rirpdm#KPI"/>
    <rdfs:label xml:lang="en">Share of users and publications per ESFRI member country</rdfs:label>
    <rdfs:comment xml:lang="en">Share of RI users and RI-enabled publications attributable to each ESFRI member country, per host institution of the user/author.</rdfs:comment>
    <rirpdm:forObjective rdf:resource="http://www.example.org/rirpdm#EnhancingTransnationalCollaboration"/>
    <rirpdm:unitOfMeasure>Number and %</rirpdm:unitOfMeasure>
    <rirpdm:status>New</rirpdm:status>
    <dcterms:source>ESFRI WG Monitoring Report 2019, Annex 5 KPI 8</dcterms:source>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1d0daad76aea4869b9e80e485ed3dbf8b81">
    <rdf:first rdf:resource="http://www.example.org/rirpdm#EngagementByDirectContact"/>
    <rdf:rest rdf:nodeID="n1d0daad76aea4869b9e80e485ed3dbf8b82"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdm#RPO">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Research Performing Organisation (RPO)</rdfs:label>
    <rdfs:comment xml:lang="en">Legal entity from a MS/AC/third country that performs research and can take binding decisions to support an RI.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/org#Organization"/>
    <rirpdm:status>Extended</rirpdm:status>
    <dcterms:source>ESFRI Roadmap 2026</dcterms:source>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdm#isOutputOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">isOutputOf</rdfs:label>
    <rdfs:comment xml:lang="en">The research infrastructure that produced this output.</rdfs:comment>
    <owl:inverseOf rdf:resource="http://www.example.org/rirpdm#producesResearchOutput"/>
    <rdfs:domain rdf:resource="http://www.example.org/rirpdm#ResearchOutput"/>
    <rdfs:range rdf:resource="http://www.example.org/rirpdm#ResearchInfrastructure"/>
    <rirpdm:status>New</rirpdm:status>
    <dcterms:source>EU Reg 2021 Art 2(22)</dcterms:source>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdm#NumberOfESFRIMembers">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.example.org/rirpdm#KPI"/>
    <rdfs:label xml:lang="en">Number of members of the RI from ESFRI countries</rdfs:label>
    <rdfs:comment xml:lang="en">Number of organisations/countries with a formal engagement (member, associated member, observer) based in an ESFRI member country.</rdfs:comment>
    <rirpdm:forObjective rdf:resource="http://www.example.org/rirpdm#EnhancingTransnationalCollaboration"/>
    <rirpdm:unitOfMeasure>Number</rirpdm:unitOfMeasure>
    <rirpdm:status>New</rirpdm:status>
    <dcterms:source>ESFRI WG Monitoring Report 2019, Annex 5 KPI 7</dcterms:source>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdm#DistributedRI">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Distributed RI</rdfs:label>
    <rdfs:comment xml:lang="en">An RI made up of a Central Hub plus interlinked National Nodes; the Hub coordinates and manages each Node's RI-dedicated capacity under the RI Consortium's shared rules.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.example.org/rirpdm#ResearchInfrastructure"/>
    <rdfs:subClassOf rdf:nodeID="n1d0daad76aea4869b9e80e485ed3dbf8b117"/>
    <rdfs:subClassOf rdf:nodeID="n1d0daad76aea4869b9e80e485ed3dbf8b118"/>
    <skos:exactMatch rdf:resource="https://w3id.org/cerif/vocab/ResearchInfrastructureTypes#Distributed"/>
    <rirpdm:status>New</rirpdm:status>
    <dcterms:source>ESFRI Roadmap 2026</dcterms:source>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1d0daad76aea4869b9e80e485ed3dbf8b112">
    <rdf:first rdf:resource="http://www.example.org/rirpdm#ExtentOfResourcesMadeAvailable"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdm#CitationsInPolicyRelatedPublications">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.example.org/rirpdm#KPI"/>
    <rdfs:label xml:lang="en">Citations in policy related publications</rdfs:label>
    <rdfs:comment xml:lang="en">Number of times the RI or its projects are cited in policy related publications.</rdfs:comment>
    <rirpdm:forObjective rdf:resource="http://www.example.org/rirpdm#ProvisionOfScientificAdvice"/>
    <rirpdm:unitOfMeasure>Number of citations</rirpdm:unitOfMeasure>
    <rirpdm:status>New</rirpdm:status>
    <dcterms:source>ESFRI WG Monitoring Report 2019, Annex 5 KPI 16</dcterms:source>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdm#IncomeFromCommercialActivities">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.example.org/rirpdm#KPI"/>
    <rdfs:label xml:lang="en">Income from commercial activities and the number of entities paying for service</rdfs:label>
    <rdfs:comment xml:lang="en">Share of revenue from the RI's economic activities (sale of services/goods, access provision) reported in the annual accounts.</rdfs:comment>
    <rirpdm:forObjective rdf:resource="http://www.example.org/rirpdm#FacilitatingEconomicActivities"/>
    <rirpdm:unitOfMeasure>Currency amount; number of entities</rirpdm:unitOfMeasure>
    <rirpdm:status>New</rirpdm:status>
    <dcterms:source>ESFRI WG Monitoring Report 2019, Annex 5 KPI 10</dcterms:source>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdm#terminationCosts">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">terminationCosts</rdfs:label>
    <rdfs:comment xml:lang="en">Decommissioning and environmental-mitigation costs at end of a lifecycle of an RI.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.example.org/rirpdm#ResearchInfrastructure"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rirpdm:status>New</rirpdm:status>
    <dcterms:source>ESFRI Roadmap 2026</dcterms:source>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/spar/fabio/Dataset">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Dataset</rdfs:label>
    <rdfs:comment xml:lang="en">A published, citable collection of research data.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.example.org/rirpdm#ResearchData"/>
    <rdfs:seeAlso rdf:resource="https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0001203"/>
    <rirpdm:status>Adopted</rirpdm:status>
    <dcterms:source>FaBiO</dcterms:source>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdm#governanceStructure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">governanceStructure</rdfs:label>
    <rdfs:comment xml:lang="en">The RI's governance structure with defined responsibilities, reporting lines and advisory/supervisory bodies.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.example.org/rirpdm#ResearchInfrastructure"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rirpdm:status>New</rirpdm:status>
    <dcterms:source>ESFRI Roadmap 2026</dcterms:source>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdm#hasScientificCase">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">hasScientificCase</rdfs:label>
    <rdfs:comment xml:lang="en">Links a Proposal or Research Infrastructure to its Scientific Case assessment.</rdfs:comment>
    <rdfs:domain rdf:nodeID="n1d0daad76aea4869b9e80e485ed3dbf8b125"/>
    <rdfs:range rdf:resource="http://www.example.org/rirpdm#ScientificCase"/>
    <rirpdm:status>New</rirpdm:status>
    <dcterms:source>ESFRI Roadmap 2026</dcterms:source>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/cerif/frapo/funds">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">funds</rdfs:label>
    <rirpdm:status>Adopted</rirpdm:status>
    <dcterms:source>FRAPO</dcterms:source>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdm#ESFRIProject">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">ESFRI Project</rdfs:label>
    <rdfs:comment xml:lang="en">A selected RI in its Preparation Phase, expected to reach Implementation within ten years.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.example.org/rirpdm#ResearchInfrastructure"/>
    <owl:disjointWith rdf:resource="http://www.example.org/rirpdm#ESFRILandmark"/>
    <rirpdm:status>New</rirpdm:status>
    <dcterms:source>ESFRI Roadmap 2026</dcterms:source>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdm#VirtualRI">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Virtual RI</rdfs:label>
    <rdfs:comment xml:lang="en">An RI with no fixed physical site: its resources and services are accessed remotely rather than in person.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.example.org/rirpdm#ResearchInfrastructure"/>
    <skos:exactMatch rdf:resource="https://w3id.org/cerif/vocab/ResearchInfrastructureTypes#Virtual"/>
    <rirpdm:status>New</rirpdm:status>
    <dcterms:source>ESFRI Roadmap 2026</dcterms:source>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1d0daad76aea4869b9e80e485ed3dbf8b49">
    <rdf:first rdf:resource="http://www.example.org/rirpdm#Medium"/>
    <rdf:rest rdf:nodeID="n1d0daad76aea4869b9e80e485ed3dbf8b50"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/spar/fabio/AcademicProceedings">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Conference Proceedings</rdfs:label>
    <rdfs:comment xml:lang="en">The published collection of papers from a conference.</rdfs:comment>
    <rdfs:seeAlso rdf:resource="https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0010020"/>
    <rirpdm:status>Adopted</rirpdm:status>
    <dcterms:source>FaBiO</dcterms:source>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdm#OutreachViaOwnWebAndSocialMedia">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="http://www.example.org/rirpdm#KPI"/>
    <rdfs:label xml:lang="en">Outreach via the RI's own web and social media activities</rdfs:label>
    <rdfs:comment xml:lang="en">Website popularity and level of social media engagement: Web (e.g. Google analytics) analytics and social media analytic tools (Twitter, Linkedin, Youtube, Flickr, Facebook, etc.)</rdfs:comment>
    <rirpdm:forObjective rdf:resource="http://www.example.org/rirpdm#OutreachToThePublic"/>
    <rirpdm:unitOfMeasure>Web/social media analytics (users, followers, interactions)</rirpdm:unitOfMeasure>
    <rirpdm:status>New</rirpdm:status>
    <dcterms:source>ESFRI WG Monitoring Report 2019, Annex 5 KPI 13</dcterms:source>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdm#involvesAgent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">involvesAgent</rdfs:label>
    <rdfs:comment xml:lang="en">An agent is involved in this research infrastructure.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.example.org/rirpdm#ResearchInfrastructure"/>
    <rdfs:range rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
    <owl:inverseOf rdf:resource="http://www.example.org/rirpdm#participatesIn"/>
    <rirpdm:status>New</rirpdm:status>
    <dcterms:source>ESFRI Roadmap 2026</dcterms:source>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1d0daad76aea4869b9e80e485ed3dbf8b25">
    <rdf:first rdf:resource="http://www.example.org/rirpdm#SocioEconomicImpact"/>
    <rdf:rest rdf:nodeID="n1d0daad76aea4869b9e80e485ed3dbf8b26"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdm#unitOfMeasure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">unitOfMeasure</rdfs:label>
    <rdfs:comment xml:lang="en">The unit in which a KPI's numericValue is expressed (e.g. Number, Percentage, Person hours).</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.example.org/rirpdm#KPI"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rirpdm:status>New</rirpdm:status>
    <dcterms:source>ESFRI WG Monitoring Report 2019</dcterms:source>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1d0daad76aea4869b9e80e485ed3dbf8b42">
    <rdf:first rdf:resource="http://www.example.org/rirpdm#VeryHigh"/>
    <rdf:rest rdf:nodeID="n1d0daad76aea4869b9e80e485ed3dbf8b43"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/spar/fabio/Thesis">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Thesis</rdfs:label>
    <rdfs:comment xml:lang="en">A document submitted in support of an academic degree.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.example.org/rirpdm#ScientificPublication"/>
    <skos:closeMatch rdf:resource="https://w3id.org/cerif/vocab/OutputTypes#PhDThesis"/>
    <rirpdm:status>Adopted</rirpdm:status>
    <dcterms:source>FaBiO</dcterms:source>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/cerif/frapo/isAwardedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">is awarded by</rdfs:label>
    <owl:inverseOf rdf:resource="http://purl.org/cerif/frapo/awards"/>
    <rirpdm:status>Adopted</rirpdm:status>
    <dcterms:source>FRAPO</dcterms:source>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdm#ResearchInstitution">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Research Institution</rdfs:label>
    <rdfs:comment xml:lang="en">Organization that participates as a partner in an RI Consortium.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/org#Organization"/>
    <rirpdm:status>Extended</rirpdm:status>
    <dcterms:source>ESFRI Roadmap 2026</dcterms:source>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1d0daad76aea4869b9e80e485ed3dbf8b27">
    <rdf:first rdf:resource="http://www.example.org/rirpdm#ENeedsAndData"/>
    <rdf:rest rdf:nodeID="n1d0daad76aea4869b9e80e485ed3dbf8b28"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdm#KPIObjective">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">KPI Objective</rdfs:label>
    <rdfs:comment xml:lang="en">One of the nine commonly held objectives against which RIs monitor performance.</rdfs:comment>
    <owl:equivalentClass rdf:nodeID="n1d0daad76aea4869b9e80e485ed3dbf8b51"/>
    <rirpdm:status>New</rirpdm:status>
    <dcterms:source>ESFRI WG Monitoring Report 2019</dcterms:source>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdm#designCosts">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">designCosts</rdfs:label>
    <rdfs:comment xml:lang="en">Costs of conceptual design, technical design, feasibility study and proposal drafting.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.example.org/rirpdm#ResearchInfrastructure"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rirpdm:status>New</rirpdm:status>
    <dcterms:source>ESFRI Roadmap 2026</dcterms:source>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdm#KPI">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">KPI</rdfs:label>
    <rdfs:comment xml:lang="en">One of the 21 key performance indicators, each belonging to exactly one KPIObjective.</rdfs:comment>
    <owl:equivalentClass rdf:nodeID="n1d0daad76aea4869b9e80e485ed3dbf8b70"/>
    <rirpdm:status>New</rirpdm:status>
    <dcterms:source>ESFRI WG Monitoring Report 2019</dcterms:source>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdm#humanResourcesPolicy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">humanResourcesPolicy</rdfs:label>
    <rdfs:comment xml:lang="en">HR policy ensuring competences via equal-opportunity hiring, secondments, education and training.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.example.org/rirpdm#ResearchInfrastructure"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rirpdm:status>New</rirpdm:status>
    <dcterms:source>ESFRI Roadmap 2026</dcterms:source>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/spar/fabio/hasDOI">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label xml:lang="en">has DOI</rdfs:label>
    <rdfs:comment xml:lang="en">Digital Object Identifier of the research output.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.example.org/rirpdm#ResearchOutput"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rirpdm:status>Adopted</rirpdm:status>
    <dcterms:source>FaBiO</dcterms:source>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdm#uniqueName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">uniqueName</rdfs:label>
    <rdfs:comment xml:lang="en">The RI's unique specific name.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.example.org/rirpdm#ResearchInfrastructure"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rirpdm:status>New</rirpdm:status>
    <dcterms:source>ESFRI Roadmap 2026</dcterms:source>
  </rdf:Description>
  <rdf:Description rdf:about="http://purl.org/spar/fabio/ReportDocument">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Report</rdfs:label>
    <rdfs:comment xml:lang="en">A technical or research report.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.example.org/rirpdm#ScientificPublication"/>
    <skos:exactMatch rdf:resource="https://w3id.org/cerif/vocab/OutputTypes#Report"/>
    <rirpdm:status>Adopted</rirpdm:status>
    <dcterms:source>FaBiO</dcterms:source>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1d0daad76aea4869b9e80e485ed3dbf8b142">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:unionOf rdf:nodeID="n1d0daad76aea4869b9e80e485ed3dbf8b143"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdm#averageAnnualOperationCosts">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">averageAnnualOperationCosts</rdfs:label>
    <rdfs:comment xml:lang="en">Annual cost of running the RI, operating access and delivering services.</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.example.org/rirpdm#ResearchInfrastructure"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rirpdm:status>New</rirpdm:status>
    <dcterms:source>ESFRI Roadmap 2026</dcterms:source>
  </rdf:Description>
