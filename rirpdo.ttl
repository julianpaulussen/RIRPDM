@prefix rirpdo:   <http://www.example.org/rirpdo#> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix foaf:     <http://xmlns.com/foaf/0.1/> .
@prefix dc:       <http://purl.org/dc/terms/> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix bibo:     <http://purl.org/ontology/bibo/> .
@prefix nfdicore: <https://nfdi.fiz-karlsruhe.de/ontology/> .

# ── Ontology declaration ─────────────────────────────────────────────────────

<http://www.example.org/rirpdo>
    a owl:Ontology ;
    dc:title "Research Infrastructure and Research Publications Data Ontology (RIRPDO)" ;
    dc:description "Core ontology for representing research infrastructure and scientific publications." ;
    owl:versionInfo "0.3.0" .

# ── Classes ──────────────────────────────────────────────────────────────────

rirpdo:Researcher
    a owl:Class ;
    rdfs:label "Researcher" ;
    rdfs:subClassOf foaf:Person .

rirpdo:Institution
    a owl:Class ;
    rdfs:label "Institution" ;
    rdfs:subClassOf foaf:Organization .

rirpdo:Publication
    a owl:Class ;
    rdfs:label "Publication" ;
    rdfs:subClassOf bibo:Document .

rirpdo:ResearchTopic
    a owl:Class ;
    rdfs:label "Research Topic" ;
    rdfs:subClassOf skos:Concept ;
    rdfs:seeAlso nfdicore:NFDI_0000100 .       # nfdicore:academic discipline

rirpdo:Project
    a owl:Class ;
    rdfs:label "Project" ;
    rdfs:seeAlso nfdicore:NFDI_0000002 .       # nfdicore:project

rirpdo:ResearchInfrastructure
    a owl:Class ;
    rdfs:label "Research Infrastructure" ;
    skos:definition "A facility or resource supporting research — covers labs, repositories, and large-scale facilities." .

rirpdo:Laboratory
    a owl:Class ;
    rdfs:label "Laboratory" ;
    rdfs:subClassOf rirpdo:ResearchInfrastructure ;
    rdfs:seeAlso nfdicore:NFDI_0001208 .       # nfdicore:laboratory

rirpdo:ResearchDataRepository
    a owl:Class ;
    rdfs:label "Research Data Repository" ;
    rdfs:subClassOf rirpdo:ResearchInfrastructure ;
    rdfs:seeAlso nfdicore:NFDI_0001201 .       # nfdicore:research data repository

rirpdo:ResearchGroup
    a owl:Class ;
    rdfs:label "Research Group" ;
    rdfs:subClassOf foaf:Group .

rirpdo:Journal
    a owl:Class ;
    rdfs:label "Journal" ;
    rdfs:subClassOf bibo:Journal .

rirpdo:Conference
    a owl:Class ;
    rdfs:label "Conference" ;
    rdfs:seeAlso nfdicore:NFDI_0010020 .       # nfdicore:conference

rirpdo:Dataset
    a owl:Class ;
    rdfs:label "Dataset" ;
    rdfs:seeAlso nfdicore:NFDI_0001203 .       # nfdicore:experimental dataset

rirpdo:Funding
    a owl:Class ;
    rdfs:label "Funding" ;
    rdfs:seeAlso nfdicore:NFDI_0001051 .       # nfdicore:funding specification

# ── Object properties ────────────────────────────────────────────────────────

rirpdo:hasAuthor
    a owl:ObjectProperty ;
    rdfs:label "hasAuthor" ;
    rdfs:domain rirpdo:Publication ;
    rdfs:range  rirpdo:Researcher .

rirpdo:affiliatedWith
    a owl:ObjectProperty ;
    rdfs:label "affiliatedWith" ;
    rdfs:domain rirpdo:Researcher ;
    rdfs:range  rirpdo:Institution .

rirpdo:hasTopic
    a owl:ObjectProperty ;
    rdfs:label "hasTopic" ;
    rdfs:domain rirpdo:Publication ;
    rdfs:range  rirpdo:ResearchTopic .

rirpdo:hasParticipant
    a owl:ObjectProperty ;
    rdfs:label "hasParticipant" ;
    rdfs:domain rirpdo:Project ;
    rdfs:range  rirpdo:Researcher .

rirpdo:usesInfrastructure
    a owl:ObjectProperty ;
    rdfs:label "usesInfrastructure" ;
    rdfs:domain rirpdo:Project ;
    rdfs:range  rirpdo:ResearchInfrastructure .

rirpdo:memberOf
    a owl:ObjectProperty ;
    rdfs:label "memberOf" ;
    rdfs:domain rirpdo:Researcher ;
    rdfs:range  rirpdo:ResearchGroup .

rirpdo:fundedBy
    a owl:ObjectProperty ;
    rdfs:label "fundedBy" ;
    rdfs:domain rirpdo:Project ;
    rdfs:range  rirpdo:Funding .

rirpdo:producedDataset
    a owl:ObjectProperty ;
    rdfs:label "producedDataset" ;
    rdfs:domain rirpdo:Project ;
    rdfs:range  rirpdo:Dataset .

rirpdo:publishedIn
    a owl:ObjectProperty ;
    rdfs:label "publishedIn" ;
    rdfs:domain rirpdo:Publication ;
    rdfs:range  rirpdo:Journal .

rirpdo:presentedAt
    a owl:ObjectProperty ;
    rdfs:label "presentedAt" ;
    rdfs:domain rirpdo:Publication ;
    rdfs:range  rirpdo:Conference .

# ── Data properties ──────────────────────────────────────────────────────────

rirpdo:name
    a owl:DatatypeProperty ;
    rdfs:label "name" ;
    rdfs:range xsd:string .

rirpdo:title
    a owl:DatatypeProperty ;
    rdfs:label "title" ;
    rdfs:range xsd:string .

rirpdo:year
    a owl:DatatypeProperty ;
    rdfs:label "year" ;
    rdfs:range xsd:gYear .

# ── Sample individuals ───────────────────────────────────────────────────────

rirpdo:FraunhoferFOKUS
    a rirpdo:Institution ;
    rirpdo:name "Fraunhofer FOKUS" .

rirpdo:TUBerlin
    a rirpdo:Institution ;
    rirpdo:name "Technische Universität Berlin" .

rirpdo:SemanticWeb
    a rirpdo:ResearchTopic ;
    rirpdo:name "Semantic Web" .

rirpdo:KnowledgeGraphs
    a rirpdo:ResearchTopic ;
    rirpdo:name "Knowledge Graphs" .

rirpdo:LinkedData
    a rirpdo:ResearchTopic ;
    rirpdo:name "Linked Data" .

rirpdo:Researcher_Aslam
    a rirpdo:Researcher ;
    rirpdo:name "Muhammad Ahtisham Aslam" ;
    rirpdo:affiliatedWith rirpdo:FraunhoferFOKUS .

rirpdo:Researcher_Smith
    a rirpdo:Researcher ;
    rirpdo:name "Jane Smith" ;
    rirpdo:affiliatedWith rirpdo:TUBerlin .

rirpdo:Researcher_Mueller
    a rirpdo:Researcher ;
    rirpdo:name "Hans Mueller" ;
    rirpdo:affiliatedWith rirpdo:TUBerlin .

rirpdo:Pub_LOPDF
    a rirpdo:Publication ;
    rirpdo:title "LOPDF: A Framework for Extracting and Producing Open Data of Scientific Documents" ;
    rirpdo:year "2021"^^xsd:gYear ;
    rirpdo:hasAuthor rirpdo:Researcher_Aslam ;
    rirpdo:hasTopic rirpdo:LinkedData ;
    rirpdo:hasTopic rirpdo:SemanticWeb .

rirpdo:Pub_KGSurvey
    a rirpdo:Publication ;
    rirpdo:title "A Survey on Knowledge Graph Construction" ;
    rirpdo:year "2023"^^xsd:gYear ;
    rirpdo:hasAuthor rirpdo:Researcher_Smith ;
    rirpdo:hasAuthor rirpdo:Researcher_Mueller ;
    rirpdo:hasTopic rirpdo:KnowledgeGraphs .

rirpdo:Pub_LinkedResearch
    a rirpdo:Publication ;
    rirpdo:title "Linked Open Data for Research Infrastructure" ;
    rirpdo:year "2022"^^xsd:gYear ;
    rirpdo:hasAuthor rirpdo:Researcher_Mueller ;
    rirpdo:hasTopic rirpdo:LinkedData ;
    rirpdo:hasTopic rirpdo:KnowledgeGraphs .

# ── Infrastructure individuals ────────────────────────────────────────────────

rirpdo:Lab_FOKUS_SemanticTech
    a rirpdo:Laboratory ;
    rirpdo:name "FOKUS Semantic Technologies Lab" .

rirpdo:Repo_TUBerlin_OpenData
    a rirpdo:ResearchDataRepository ;
    rirpdo:name "TU Berlin Open Research Data Repository" .

# ── Dataset individuals ───────────────────────────────────────────────────────

rirpdo:Dataset_LOPDFCorpus
    a rirpdo:Dataset ;
    rirpdo:name "LOPDF Scientific Document Corpus" .

rirpdo:Dataset_KGBenchmark
    a rirpdo:Dataset ;
    rirpdo:name "Knowledge Graph Construction Benchmark" .

# ── Funding individuals ───────────────────────────────────────────────────────

rirpdo:Funding_BMBF_2020
    a rirpdo:Funding ;
    rirpdo:name "BMBF Open Science Grant 2020" .

# ── Project individuals ───────────────────────────────────────────────────────

rirpdo:Project_LOPDF
    a rirpdo:Project ;
    rirpdo:name "LOPDF Project" ;
    rirpdo:hasParticipant    rirpdo:Researcher_Aslam ;
    rirpdo:usesInfrastructure rirpdo:Lab_FOKUS_SemanticTech ;
    rirpdo:producedDataset   rirpdo:Dataset_LOPDFCorpus ;
    rirpdo:fundedBy          rirpdo:Funding_BMBF_2020 .

rirpdo:Project_KGSurvey
    a rirpdo:Project ;
    rirpdo:name "Knowledge Graph Survey Project" ;
    rirpdo:hasParticipant    rirpdo:Researcher_Smith ;
    rirpdo:hasParticipant    rirpdo:Researcher_Mueller ;
    rirpdo:usesInfrastructure rirpdo:Repo_TUBerlin_OpenData ;
    rirpdo:producedDataset   rirpdo:Dataset_KGBenchmark .

# ── Journal individuals ───────────────────────────────────────────────────────

rirpdo:Journal_SWJ
    a rirpdo:Journal ;
    rirpdo:name "Semantic Web Journal" .

rirpdo:Pub_LinkedResearch rirpdo:publishedIn rirpdo:Journal_SWJ .