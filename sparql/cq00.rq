PREFIX rirpdm: <http://www.example.org/rirpdm#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>

# CQ00 — Simple test: list every Research Infrastructure, its label and current lifecycle phase.

SELECT ?ri ?label ?phase
WHERE {
    ?ri   a                rirpdm:ResearchInfrastructure ;
          rdfs:label       ?label ;
          rirpdm:isInPhase ?phase .
}
ORDER BY ?label
