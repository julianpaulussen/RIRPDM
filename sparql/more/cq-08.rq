# CQ08: For a participating institution, which umbrella / parent
# organisation does it ultimately belong to?
#
# Reasoning: org:subOrganizationOf (imported W3C ORG vocabulary) is transitive
# -- the top-level parent is reached through any depth of sub-organisation
# links, so it is never asserted directly.

PREFIX org:  <http://www.w3.org/ns/org#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?inst ?instLabel ?parent ?parentLabel
WHERE {
    ?inst org:subOrganizationOf ?parent .
    OPTIONAL { ?inst rdfs:label ?instLabel }
    OPTIONAL { ?parent rdfs:label ?parentLabel }
}
ORDER BY ?instLabel
