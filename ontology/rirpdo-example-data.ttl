# rirpdo: prefix label -> expands to full namespace
# <http:...>: namespace#[localname]
@prefix rirpdo:   <http://www.example.org/rirpdo#> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix foaf:     <http://xmlns.com/foaf/0.1/> .
@prefix dc:       <http://purl.org/dc/terms/> .
@prefix bibo:     <http://purl.org/ontology/bibo/> .

# ABox — load alongside rirpdo.ttl in GraphDB

# ── Institutions ──────────────────────────────────────────────────────────────

rirpdo:FraunhoferFOKUS # subject: prefix:localname -> identifier 
    a rirpdo:Institution ; # predicate: "a" = rdf:type -> instace of a class    
    foaf:name "Fraunhofer FOKUS" . # prefix:name -> name attached to subject

rirpdo:TUBerlin
    a rirpdo:Institution ;
    foaf:name "Technische Universität Berlin" .

# ── Research topics ───────────────────────────────────────────────────────────

rirpdo:SemanticWeb
    a rirpdo:ResearchTopic ;
    foaf:name "Semantic Web" .

rirpdo:KnowledgeGraphs
    a rirpdo:ResearchTopic ;
    foaf:name "Knowledge Graphs" .

rirpdo:LinkedData
    a rirpdo:ResearchTopic ;
    foaf:name "Linked Data" .

# ── Researchers ───────────────────────────────────────────────────────────────

rirpdo:Researcher_Aslam
    a rirpdo:Researcher ;
    foaf:name "Muhammad Ahtisham Aslam" ;
    rirpdo:affiliatedWith rirpdo:FraunhoferFOKUS .

rirpdo:Researcher_Smith
    a rirpdo:Researcher ;
    foaf:name "Jane Smith" ;
    rirpdo:affiliatedWith rirpdo:TUBerlin .

rirpdo:Researcher_Mueller
    a rirpdo:Researcher ;
    foaf:name "Hans Mueller" ;
    rirpdo:affiliatedWith rirpdo:TUBerlin .

# ── Publications ──────────────────────────────────────────────────────────────

rirpdo:Pub_LOPDF
    a rirpdo:Publication ;
    dc:title "LOPDF: A Framework for Extracting and Producing Open Data of Scientific Documents" ;
    rirpdo:year "2021"^^xsd:gYear ;
    rirpdo:hasAuthor rirpdo:Researcher_Aslam ;
    rirpdo:hasTopic rirpdo:LinkedData ;
    rirpdo:hasTopic rirpdo:SemanticWeb .

rirpdo:Pub_KGSurvey
    a rirpdo:Publication ;
    dc:title "A Survey on Knowledge Graph Construction" ;
    rirpdo:year "2023"^^xsd:gYear ;
    rirpdo:hasAuthor rirpdo:Researcher_Smith ;
    rirpdo:hasAuthor rirpdo:Researcher_Mueller ;
    rirpdo:hasTopic rirpdo:KnowledgeGraphs .

rirpdo:Pub_LinkedResearch
    a rirpdo:Publication ;
    dc:title "Linked Open Data for Research Infrastructure" ;
    rirpdo:year "2022"^^xsd:gYear ;
    rirpdo:hasAuthor rirpdo:Researcher_Mueller ;
    rirpdo:hasTopic rirpdo:LinkedData ;
    rirpdo:hasTopic rirpdo:KnowledgeGraphs ;
    rirpdo:publishedIn rirpdo:Journal_SWJ .

