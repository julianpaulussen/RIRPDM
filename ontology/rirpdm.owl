    <rdfs:comment xml:lang="en">A facility (or set of resources/services) enabling research and innovation.</rdfs:comment>
    <skos:exactMatch rdf:resource="https://w3id.org/cerif/vocab/ResearchInfrastructure#ResearchInfrastructure"/>
    <rirpdm:status>New</rirpdm:status>
