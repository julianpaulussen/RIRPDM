<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:dc1="http://purl.org/dc/terms/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="http://www.example.org/rirpdo#hasAuthor">
    <owl:equivalentProperty rdf:resource="http://vivoweb.org/ontology/core#hasAuthor"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>hasAuthor</rdfs:label>
    <rdfs:domain rdf:resource="http://www.example.org/rirpdo#Publication"/>
    <rdfs:range rdf:resource="http://www.example.org/rirpdo#Researcher"/>
    <owl:inverseOf rdf:resource="http://www.example.org/rirpdo#authorOf"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdo#CloudInfrastructure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Cloud Infrastructure</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.example.org/rirpdo#ComputingEnvironment"/>
    <skos:definition>On-demand cloud computing resources used for research workloads (e.g. AWS, Azure, Google Cloud).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdo#ResearchDataRepository">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Research Data Repository</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.example.org/rirpdo#ResearchInfrastructure"/>
    <rdfs:seeAlso rdf:resource="https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0001201"/>
    <skos:definition>A storage system for archiving and sharing research datasets, typically with persistent identifiers (e.g. Zenodo, Figshare).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdo#endDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>endDate</rdfs:label>
    <rdfs:domain rdf:resource="http://www.example.org/rirpdo#Project"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdo#ResearchInfrastructure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Research Infrastructure</rdfs:label>
    <skos:definition>A facility or resource supporting research — covers labs, repositories, and large-scale facilities.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdo#title">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>title</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <owl:equivalentProperty rdf:resource="http://purl.org/dc/terms/title"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdo#doi">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>doi</rdfs:label>
    <rdfs:domain rdf:resource="http://www.example.org/rirpdo#Publication"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <owl:equivalentProperty rdf:resource="http://purl.org/ontology/bibo/doi"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdo#Laboratory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Laboratory</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.example.org/rirpdo#ResearchInfrastructure"/>
    <rdfs:seeAlso rdf:resource="https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0001208"/>
    <skos:definition>A physical or virtual space where researchers conduct experiments and empirical work.</skos:definition>
    <owl:equivalentClass rdf:resource="http://vivoweb.org/ontology/core#Laboratory"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdo#ResearchTopic">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Research Topic</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:seeAlso rdf:resource="https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0000100"/>
    <skos:definition>A subject area or field that a publication or research project addresses.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdo#publishedIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>publishedIn</rdfs:label>
    <rdfs:domain rdf:resource="http://www.example.org/rirpdo#Publication"/>
    <rdfs:range rdf:resource="http://www.example.org/rirpdo#Journal"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdo#Researcher">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Researcher</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
    <skos:definition>A person who conducts scientific research, typically affiliated with an institution.</skos:definition>
    <owl:equivalentClass rdf:resource="http://vivoweb.org/ontology/core#Researcher"/>
    <owl:disjointWith rdf:resource="http://www.example.org/rirpdo#Publication"/>
    <owl:disjointWith rdf:resource="http://www.example.org/rirpdo#ResearchInfrastructure"/>
    <owl:disjointWith rdf:resource="http://www.example.org/rirpdo#ResearchTopic"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdo#affiliatedWith">
    <owl:equivalentProperty rdf:resource="http://vivoweb.org/ontology/core#affiliatedWith"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>affiliatedWith</rdfs:label>
    <rdfs:domain rdf:resource="http://www.example.org/rirpdo#Researcher"/>
    <rdfs:range rdf:resource="http://www.example.org/rirpdo#Institution"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdo#producedDataset">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>producedDataset</rdfs:label>
    <rdfs:domain rdf:resource="http://www.example.org/rirpdo#Project"/>
    <rdfs:range rdf:resource="http://www.example.org/rirpdo#Dataset"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdo#Publication">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Publication</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.org/ontology/bibo/Document"/>
    <skos:definition>A scholarly work published and shared with the research community, such as a journal article, conference paper, or technical report.</skos:definition>
    <owl:disjointWith rdf:resource="http://www.example.org/rirpdo#ResearchInfrastructure"/>
    <owl:disjointWith rdf:resource="http://www.example.org/rirpdo#Project"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdo#amount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>amount</rdfs:label>
    <rdfs:domain rdf:resource="http://www.example.org/rirpdo#Funding"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdo#fundedBy">
    <owl:equivalentProperty rdf:resource="http://vivoweb.org/ontology/core#fundedBy"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>fundedBy</rdfs:label>
    <rdfs:domain rdf:resource="http://www.example.org/rirpdo#Project"/>
    <rdfs:range rdf:resource="http://www.example.org/rirpdo#Funding"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdo#ComputeCluster">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>High-Performance Computing (HPC) Cluster</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.example.org/rirpdo#ComputingEnvironment"/>
    <skos:definition>A set of linked compute nodes used for high-performance or parallel computing in research (e.g. HPC clusters).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n917b74a2f685425bac08d88552778702b1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://www.example.org/rirpdo#hasParticipant"/>
    <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
    <owl:onClass rdf:resource="http://www.example.org/rirpdo#Researcher"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdo#presentedAt">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>presentedAt</rdfs:label>
    <rdfs:domain rdf:resource="http://www.example.org/rirpdo#Publication"/>
    <rdfs:range rdf:resource="http://www.example.org/rirpdo#Conference"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdo#ResearchGroup">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Research Group</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://xmlns.com/foaf/0.1/Group"/>
    <skos:definition>A team of researchers collaborating on a shared scientific topic, typically within an institution.</skos:definition>
    <owl:equivalentClass rdf:resource="http://vivoweb.org/ontology/core#ResearchGroup"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdo#year">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>year</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#gYear"/>
    <owl:equivalentProperty rdf:resource="http://purl.org/dc/terms/date"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdo#orcid">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>orcid</rdfs:label>
    <rdfs:domain rdf:resource="http://www.example.org/rirpdo#Researcher"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdo#GitRepository">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Git Repository</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.example.org/rirpdo#ResearchDataRepository"/>
    <skos:definition>A version-controlled repository hosting research code and software artifacts (e.g. GitHub, GitLab).</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdo#startDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>startDate</rdfs:label>
    <rdfs:domain rdf:resource="http://www.example.org/rirpdo#Project"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdo#hasParticipant">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>hasParticipant</rdfs:label>
    <rdfs:domain rdf:resource="http://www.example.org/rirpdo#Project"/>
    <rdfs:range rdf:resource="http://www.example.org/rirpdo#Researcher"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdo#hasTopic">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>hasTopic</rdfs:label>
    <rdfs:domain rdf:resource="http://www.example.org/rirpdo#Publication"/>
    <rdfs:range rdf:resource="http://www.example.org/rirpdo#ResearchTopic"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdo#Journal">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Journal</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://purl.org/ontology/bibo/Journal"/>
    <skos:definition>A periodical publication in which researchers publish peer-reviewed articles.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdo#name">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>name</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <owl:equivalentProperty rdf:resource="http://xmlns.com/foaf/0.1/name"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdo#ComputingEnvironment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Computing Environment</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.example.org/rirpdo#ResearchInfrastructure"/>
    <skos:definition>Any computational resource used to execute research workloads, including clusters and cloud platforms.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdo#abstract">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>abstract</rdfs:label>
    <rdfs:domain rdf:resource="http://www.example.org/rirpdo#Publication"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <owl:equivalentProperty rdf:resource="http://purl.org/dc/terms/abstract"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdo#Funding">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Funding</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0001051"/>
    <skos:definition>Financial support granted to a research project, typically by a government body or foundation.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dc1:title>Research Infrastructure and Research Publications Data Ontology (RIRPDO)</dc1:title>
    <dc1:description>Core ontology for representing research infrastructure and scientific publications.</dc1:description>
    <owl:versionInfo>0.3.0</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdo#authorOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>authorOf</rdfs:label>
    <owl:inverseOf rdf:resource="http://www.example.org/rirpdo#hasAuthor"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdo#usesInfrastructure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>usesInfrastructure</rdfs:label>
    <rdfs:domain rdf:resource="http://www.example.org/rirpdo#Project"/>
    <rdfs:range rdf:resource="http://www.example.org/rirpdo#ResearchInfrastructure"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdo#memberOf">
    <owl:equivalentProperty rdf:resource="http://vivoweb.org/ontology/core#memberOf"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>memberOf</rdfs:label>
    <rdfs:domain rdf:resource="http://www.example.org/rirpdo#Researcher"/>
    <rdfs:range rdf:resource="http://www.example.org/rirpdo#ResearchGroup"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdo#Project">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Project</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0000002"/>
    <skos:definition>A funded research activity with defined goals, participants, and a start and end date.</skos:definition>
    <owl:equivalentClass rdf:resource="http://vivoweb.org/ontology/core#Project"/>
    <rdfs:subClassOf rdf:nodeID="n917b74a2f685425bac08d88552778702b1"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdo#Dataset">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Dataset</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0001203"/>
    <skos:definition>A structured collection of data produced or used in a research project.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdo#Conference">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Conference</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0010020"/>
    <skos:definition>An academic event where researchers present and discuss their work.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.example.org/rirpdo#Institution">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Institution</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://xmlns.com/foaf/0.1/Organization"/>
    <skos:definition>An organization that conducts, funds, or supports research activities, such as a university or research institute.</skos:definition>
    <owl:disjointWith rdf:resource="http://www.example.org/rirpdo#Publication"/>
  </rdf:Description>
</rdf:RDF>
