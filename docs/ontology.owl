    <rdf:Description rdf:about="http://purl.org/cerif/frapo/Grant">
        <terms:source>FRAPO</terms:source>
        <status>Adopted</status>
        <rdfs:comment xml:lang="en">A sum of money awarded by a funding agency to support a specific project or activity.</rdfs:comment>
        <rdfs:label xml:lang="en">Grant</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://purl.org/spar/fabio/ConferencePaper">
        <terms:source>FaBiO</terms:source>
        <status>Adopted</status>
        <rdfs:comment xml:lang="en">A paper presented at a conference and published in its proceedings.</rdfs:comment>
        <rdfs:label xml:lang="en">Conference Paper</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0001105"/>
    </rdf:Description>
    <rdf:Description rdf:about="http://purl.org/spar/fabio/JournalArticle">
        <terms:source>FaBiO</terms:source>
        <status>Adopted</status>
        <rdfs:comment xml:lang="en">A research article published in a journal issue.</rdfs:comment>
        <rdfs:label xml:lang="en">Journal Article</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0001209"/>
    </rdf:Description>
    <rdf:Description rdf:about="http://purl.org/spar/fabio/ReportDocument">
        <terms:source>FaBiO</terms:source>
        <status>Adopted</status>
        <rdfs:comment xml:lang="en">A technical or research report.</rdfs:comment>
        <rdfs:label xml:lang="en">Report</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://purl.org/spar/fabio/Thesis">
        <terms:source>FaBiO</terms:source>
        <status>Adopted</status>
        <rdfs:comment xml:lang="en">A document submitted in support of an academic degree.</rdfs:comment>
        <rdfs:label xml:lang="en">Thesis</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.example.org/rirpdm#DistributedRI">
        <terms:source>ESFRI Roadmap 2026</terms:source>
        <status>New</status>
        <rdfs:comment xml:lang="en">An RI made up of a Central Hub plus interlinked National Nodes; the Hub coordinates and manages each Node&apos;s RI-dedicated capacity under the RI Consortium&apos;s shared rules.</rdfs:comment>
        <rdfs:label xml:lang="en">Distributed RI</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.example.org/rirpdm#ResearchInfrastructure">
        <terms:source>ESFRI Roadmap 2026</terms:source>
        <terms:source>EU Regulation 2021 Art 2</terms:source>
        <status>New</status>
        <rdfs:comment xml:lang="en">A facility (or set of resources/services) enabling research and innovation.</rdfs:comment>
        <rdfs:label xml:lang="en">Research Infrastructure</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.example.org/rirpdm#SingleSitedRI">
        <terms:source>ESFRI Roadmap 2026</terms:source>
        <status>New</status>
        <rdfs:comment xml:lang="en">An RI concentrated geographically at one site (or a few complementary sites) designed for user access. (ESFRI Roadmap 2026, p.15)</rdfs:comment>
        <rdfs:label xml:lang="en">Single-sited RI</rdfs:label>
    </rdf:Description>
    <rdf:Description rdf:about="http://www.example.org/rirpdm#VirtualRI">
        <terms:source>ESFRI Roadmap 2026</terms:source>
        <status>New</status>
        <rdfs:comment xml:lang="en">An RI with no fixed physical site: its resources and services are accessed remotely rather than in person.</rdfs:comment>
        <rdfs:label xml:lang="en">Virtual RI</rdfs:label>
    </rdf:Description>
    


