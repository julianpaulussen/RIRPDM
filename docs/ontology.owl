    <!-- http://purl.org/cerif/frapo/Budget -->


    <owl:Class rdf:about="http://purl.org/cerif/frapo/Budget">
        <terms:source>FRAPO</terms:source>
        <status>Adopted</status>
        <rdfs:comment xml:lang="en">A planned allocation of financial resources for a project or infrastructure.</rdfs:comment>
        <rdfs:label xml:lang="en">Budget</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/cerif/frapo/Expenditure -->


    <owl:Class rdf:about="http://purl.org/cerif/frapo/Expenditure">
        <terms:source>FRAPO</terms:source>
        <status>Adopted</status>
        <rdfs:comment xml:lang="en">Money actually spent against a budget.</rdfs:comment>
        <rdfs:label xml:lang="en">Expenditure</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/cerif/frapo/Funding -->


    <owl:Class rdf:about="http://purl.org/cerif/frapo/Funding">
        <terms:source>FRAPO</terms:source>
        <status>Adopted</status>
        <rdfs:comment xml:lang="en">Financial support provided to undertake research or operate an infrastructure.</rdfs:comment>
        <rdfs:label xml:lang="en">Funding</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0001051"/>
    </owl:Class>
    


    <!-- http://purl.org/cerif/frapo/FundingAgency -->


    <owl:Class rdf:about="http://purl.org/cerif/frapo/FundingAgency">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/org#Organization"/>
        <terms:source>FRAPO</terms:source>
        <status>Adopted</status>
        <rdfs:comment xml:lang="en">An organisation that provides funding for research projects or infrastructures.</rdfs:comment>
        <rdfs:label xml:lang="en">Funding Agency</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0000139"/>
    </owl:Class>
    


    <!-- http://purl.org/cerif/frapo/FundingProgramme -->


    <owl:Class rdf:about="http://purl.org/cerif/frapo/FundingProgramme">
        <terms:source>FRAPO</terms:source>
        <status>Adopted</status>
        <rdfs:comment xml:lang="en">A structured scheme under which a funding agency awards grants.</rdfs:comment>
        <rdfs:label xml:lang="en">Funding Programme</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/cerif/frapo/Grant -->


    <owl:Class rdf:about="http://purl.org/cerif/frapo/Grant">
        <rdfs:subClassOf rdf:resource="http://purl.org/cerif/frapo/Funding"/>
    </owl:Class>
    


    <!-- http://purl.org/cerif/frapo/Project -->


    <owl:Class rdf:about="http://purl.org/cerif/frapo/Project">
        <terms:source>FRAPO</terms:source>
        <status>Adopted</status>
        <rdfs:comment xml:lang="en">An activity undertaken to achieve defined objectives, optionally funded by one or more sources.</rdfs:comment>
        <rdfs:label xml:lang="en">Project</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://vivoweb.org/ontology/core#Project"/>
        <rdfs:seeAlso rdf:resource="https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0000002"/>
    </owl:Class>
    


    <!-- http://purl.org/spar/fabio/AcademicProceedings -->


    <owl:Class rdf:about="http://purl.org/spar/fabio/AcademicProceedings">
        <terms:source>FaBiO</terms:source>
        <status>Adopted</status>
        <rdfs:comment xml:lang="en">The published collection of papers from a conference.</rdfs:comment>
        <rdfs:label xml:lang="en">Conference Proceedings</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0010020"/>
    </owl:Class>
    


    <!-- http://purl.org/spar/fabio/ConferencePaper -->


    <owl:Class rdf:about="http://purl.org/spar/fabio/ConferencePaper">
        <rdfs:subClassOf rdf:resource="http://www.example.org/rirpdm#ScientificPublication"/>
    </owl:Class>
    


    <!-- http://purl.org/spar/fabio/Dataset -->


    <owl:Class rdf:about="http://purl.org/spar/fabio/Dataset">
        <rdfs:subClassOf rdf:resource="http://www.example.org/rirpdm#ResearchData"/>
        <terms:source>FaBiO</terms:source>
        <status>Adopted</status>
        <rdfs:comment xml:lang="en">A published, citable collection of research data.</rdfs:comment>
        <rdfs:label xml:lang="en">Dataset</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0001203"/>
    </owl:Class>
    


    <!-- http://purl.org/spar/fabio/Expression -->


    <owl:Class rdf:about="http://purl.org/spar/fabio/Expression">
        <terms:source>FaBiO</terms:source>
        <status>Adopted</status>
        <rdfs:comment xml:lang="en">A FaBiO/FRBR expression — the intellectual realisation of a work, the bibliographic superclass of all publication types.</rdfs:comment>
        <rdfs:label xml:lang="en">Expression</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/spar/fabio/Journal -->


    <owl:Class rdf:about="http://purl.org/spar/fabio/Journal">
        <terms:source>FaBiO</terms:source>
        <status>Adopted</status>
        <rdfs:comment xml:lang="en">A periodical publishing scholarly articles.</rdfs:comment>
        <rdfs:label xml:lang="en">Journal</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.org/spar/fabio/JournalArticle -->


    <owl:Class rdf:about="http://purl.org/spar/fabio/JournalArticle">
        <rdfs:subClassOf rdf:resource="http://www.example.org/rirpdm#ScientificPublication"/>
    </owl:Class>
    


    <!-- http://purl.org/spar/fabio/ReportDocument -->


    <owl:Class rdf:about="http://purl.org/spar/fabio/ReportDocument">
        <rdfs:subClassOf rdf:resource="http://www.example.org/rirpdm#ScientificPublication"/>
    </owl:Class>
    


    <!-- http://purl.org/spar/fabio/Thesis -->


    <owl:Class rdf:about="http://purl.org/spar/fabio/Thesis">
        <rdfs:subClassOf rdf:resource="http://www.example.org/rirpdm#ScientificPublication"/>
    </owl:Class>
    


    <!-- http://www.example.org/rirpdm#AssociatedCountry -->


    <owl:Class rdf:about="http://www.example.org/rirpdm#AssociatedCountry">
        <rdfs:subClassOf rdf:resource="http://www.example.org/rirpdm#Country"/>
        <terms:source>ESFRI Roadmap 2026</terms:source>
        <status>Extended</status>
        <rdfs:comment xml:lang="en">Country associated to the Framework Programme (FP).</rdfs:comment>
        <rdfs:label xml:lang="en">Associated Country</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/rirpdm#CentralHub -->


    <owl:Class rdf:about="http://www.example.org/rirpdm#CentralHub">
        <terms:source>ESFRI Roadmap 2026</terms:source>
        <status>New</status>
        <rdfs:comment xml:lang="en">The coordinating international organisation of a distributed RI that mediates between the nodes.</rdfs:comment>
        <rdfs:label xml:lang="en">Central Hub</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/rirpdm#Country -->


    <owl:Class rdf:about="http://www.example.org/rirpdm#Country">
        <rdfs:subClassOf rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
        <terms:source>ESFRI Roadmap 2026</terms:source>
        <status>Extended</status>
        <rdfs:comment xml:lang="en">A nation eligible to participate in an RI.</rdfs:comment>
        <rdfs:label xml:lang="en">Country</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/rirpdm#DistributedRI -->


    <owl:Class rdf:about="http://www.example.org/rirpdm#DistributedRI">
        <rdfs:subClassOf rdf:resource="http://www.example.org/rirpdm#ResearchInfrastructure"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/rirpdm#hasNode"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/rirpdm#hasCentralHub"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.example.org/rirpdm#SingleSitedRI"/>
    </owl:Class>
    


    <!-- http://www.example.org/rirpdm#ESFRILandmark -->


    <owl:Class rdf:about="http://www.example.org/rirpdm#ESFRILandmark">
        <rdfs:subClassOf rdf:resource="http://www.example.org/rirpdm#ResearchInfrastructure"/>
        <owl:disjointWith rdf:resource="http://www.example.org/rirpdm#ESFRIProject"/>
        <terms:source>ESFRI Roadmap 2026</terms:source>
        <status>New</status>
        <rdfs:comment xml:lang="en">An implemented (or near-implemented) RI established as a major asset of the European Research Area, periodically monitored.</rdfs:comment>
        <rdfs:label xml:lang="en">ESFRI Landmark</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/rirpdm#ESFRIProject -->


    <owl:Class rdf:about="http://www.example.org/rirpdm#ESFRIProject">
        <rdfs:subClassOf rdf:resource="http://www.example.org/rirpdm#ResearchInfrastructure"/>
        <terms:source>ESFRI Roadmap 2026</terms:source>
        <status>New</status>
        <rdfs:comment xml:lang="en">A selected RI in its Preparation Phase, expected to reach Implementation within ten years.</rdfs:comment>
        <rdfs:label xml:lang="en">ESFRI Project</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/rirpdm#Evaluation -->


    <owl:Class rdf:about="http://www.example.org/rirpdm#Evaluation">
        <terms:source>ESFRI Roadmap 2026</terms:source>
        <status>New</status>
        <rdfs:comment xml:lang="en">An assessment of a case dimension, producing a score at a given lifecycle phase.</rdfs:comment>
        <rdfs:label xml:lang="en">Evaluation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/rirpdm#ImplementationCase -->


    <owl:Class rdf:about="http://www.example.org/rirpdm#ImplementationCase">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/rirpdm#hasEvaluation"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">5</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source>ESFRI Roadmap 2026</terms:source>
        <status>New</status>
        <rdfs:comment xml:lang="en">The five-dimension assessment of an RI&apos;s feasibility and delivery, attached to a Proposal or Research Infrastructure.</rdfs:comment>
        <rdfs:label xml:lang="en">Implementation Case</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/rirpdm#ImplementationDimension -->


    <owl:Class rdf:about="http://www.example.org/rirpdm#ImplementationDimension">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.example.org/rirpdm#Finances"/>
                    <rdf:Description rdf:about="http://www.example.org/rirpdm#GovernanceManagementAndHR"/>
                    <rdf:Description rdf:about="http://www.example.org/rirpdm#PreparatoryWorkAndPlanning"/>
                    <rdf:Description rdf:about="http://www.example.org/rirpdm#Risks"/>
                    <rdf:Description rdf:about="http://www.example.org/rirpdm#StakeholderCommitment"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <terms:source>ESFRI Roadmap 2026</terms:source>
        <status>New</status>
        <rdfs:comment xml:lang="en">One of the five dimensions along which an Implementation Case is assessed.</rdfs:comment>
        <rdfs:label xml:lang="en">Implementation Dimension</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/rirpdm#LifecyclePhase -->


    <owl:Class rdf:about="http://www.example.org/rirpdm#LifecyclePhase">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.example.org/rirpdm#Concept"/>
                    <rdf:Description rdf:about="http://www.example.org/rirpdm#Design"/>
                    <rdf:Description rdf:about="http://www.example.org/rirpdm#Implementation"/>
                    <rdf:Description rdf:about="http://www.example.org/rirpdm#Operation"/>
                    <rdf:Description rdf:about="http://www.example.org/rirpdm#Preparation"/>
                    <rdf:Description rdf:about="http://www.example.org/rirpdm#Termination"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <terms:source>ESFRI Roadmap 2026</terms:source>
        <status>New</status>
        <rdfs:comment xml:lang="en">Reference to understand the needs and targets of RIs at a given time and at various levels.</rdfs:comment>
        <rdfs:label xml:lang="en">Lifecycle Phase</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/rirpdm#MajorUpgrade -->


    <owl:Class rdf:about="http://www.example.org/rirpdm#MajorUpgrade">
        <rdfs:subClassOf rdf:resource="http://www.example.org/rirpdm#Proposal"/>
        <owl:disjointWith rdf:resource="http://www.example.org/rirpdm#NewProposal"/>
        <terms:source>ESFRI Roadmap 2026</terms:source>
        <status>New</status>
        <rdfs:comment xml:lang="en">A transformative (not routine) upgrade to an operational RI.</rdfs:comment>
        <rdfs:label xml:lang="en">Major Upgrade</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://w3id.org/cerif/vocab/ResearchInfrastructureStatuses#BeingUpgraded"/>
    </owl:Class>
    


    <!-- http://www.example.org/rirpdm#MemberState -->


    <owl:Class rdf:about="http://www.example.org/rirpdm#MemberState">
        <rdfs:subClassOf rdf:resource="http://www.example.org/rirpdm#Country"/>
        <terms:source>ESFRI Roadmap 2026</terms:source>
        <status>Extended</status>
        <rdfs:comment xml:lang="en">Member state of the European Union.</rdfs:comment>
        <rdfs:label xml:lang="en">Member State</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/rirpdm#NationalNode -->


    <owl:Class rdf:about="http://www.example.org/rirpdm#NationalNode">
        <terms:source>ESFRI Roadmap 2026</terms:source>
        <status>New</status>
        <rdfs:comment xml:lang="en">A national/institutional component of a distributed RI whose RI-dedicated capacity and resources are identified, coordinated and managed by the Central Hub.</rdfs:comment>
        <rdfs:label xml:lang="en">National Node</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/rirpdm#NewProposal -->


    <owl:Class rdf:about="http://www.example.org/rirpdm#NewProposal">
        <rdfs:subClassOf rdf:resource="http://www.example.org/rirpdm#Proposal"/>
        <terms:source>ESFRI Roadmap 2026</terms:source>
        <status>New</status>
        <rdfs:comment xml:lang="en">A candidate RI project submitted for selection onto the Roadmap.</rdfs:comment>
        <rdfs:label xml:lang="en">New Proposal</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/rirpdm#Proposal -->


    <owl:Class rdf:about="http://www.example.org/rirpdm#Proposal">
        <terms:source>ESFRI Roadmap 2026</terms:source>
        <status>New</status>
        <rdfs:comment xml:lang="en">Abstract parent for candidate submissions to the Roadmap.</rdfs:comment>
        <rdfs:label xml:lang="en">Proposal</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/rirpdm#RFO -->


    <owl:Class rdf:about="http://www.example.org/rirpdm#RFO">
        <rdfs:subClassOf rdf:resource="http://purl.org/cerif/frapo/FundingAgency"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/org#Organization"/>
        <terms:source>ESFRI Roadmap 2026</terms:source>
        <status>Extended</status>
        <rdfs:comment xml:lang="en">Legal entity that can take binding decisions to financially support an RI.</rdfs:comment>
        <rdfs:label xml:lang="en">Research Funding Organisation (RFO)</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/rirpdm#RIConsortium -->


    <owl:Class rdf:about="http://www.example.org/rirpdm#RIConsortium">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/org#Organization"/>
        <terms:source>ESFRI Roadmap 2026</terms:source>
        <status>Extended</status>
        <rdfs:comment xml:lang="en">The consortium of core partners governing a distributed RI, whose agreed statutes and common rules and procedures the Central Hub applies to coordinate and manage the National Nodes&apos; RI-dedicated capacity. (ESFRI Roadmap 2026, p.15)</rdfs:comment>
        <rdfs:label xml:lang="en">RI Consortium</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0001039"/>
    </owl:Class>
    


    <!-- http://www.example.org/rirpdm#RPO -->


    <owl:Class rdf:about="http://www.example.org/rirpdm#RPO">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/org#Organization"/>
        <terms:source>ESFRI Roadmap 2026</terms:source>
        <status>Extended</status>
        <rdfs:comment xml:lang="en">Legal entity from a MS/AC/third country that performs research and can take binding decisions to support an RI.</rdfs:comment>
        <rdfs:label xml:lang="en">Research Performing Organisation (RPO)</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/rirpdm#ResearchData -->


    <owl:Class rdf:about="http://www.example.org/rirpdm#ResearchData">
        <rdfs:subClassOf rdf:resource="http://www.example.org/rirpdm#ResearchOutput"/>
        <owl:disjointWith rdf:resource="http://www.example.org/rirpdm#ScientificPublication"/>
        <terms:source>EU Reg 2021 Art 14(1)(b), Art 39(4)</terms:source>
        <status>New</status>
        <rdfs:comment xml:lang="en">Data, including those underlying scientific publications, managed per FAIR principles.</rdfs:comment>
        <rdfs:label xml:lang="en">Research Data</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
    </owl:Class>
    


    <!-- http://www.example.org/rirpdm#ResearchInfrastructure -->


    <owl:Class rdf:about="http://www.example.org/rirpdm#ResearchInfrastructure"/>
    


    <!-- http://www.example.org/rirpdm#ResearchInstitution -->


    <owl:Class rdf:about="http://www.example.org/rirpdm#ResearchInstitution">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/org#Organization"/>
        <terms:source>ESFRI Roadmap 2026</terms:source>
        <status>Extended</status>
        <rdfs:comment xml:lang="en">Organization that participates as a partner in an RI Consortium.</rdfs:comment>
        <rdfs:label xml:lang="en">Research Institution</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/rirpdm#ResearchOutput -->


    <owl:Class rdf:about="http://www.example.org/rirpdm#ResearchOutput">
        <terms:source>EU Reg 2021 Art 2(22)</terms:source>
        <status>New</status>
        <rdfs:comment xml:lang="en">Results of an action accessible as scientific publications, data, software, algorithms, protocols, etc.</rdfs:comment>
        <rdfs:label xml:lang="en">Research Output</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/rirpdm#Researcher -->


    <owl:Class rdf:about="http://www.example.org/rirpdm#Researcher">
        <rdfs:subClassOf rdf:resource="http://xmlns.com/foaf/0.1/Person"/>
        <terms:source>VIVO</terms:source>
        <status>Extended</status>
        <rdfs:comment xml:lang="en">An agent who conducts scientific research, typically as a participant in a research infrastructure.</rdfs:comment>
        <rdfs:label xml:lang="en">Researcher</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://vivoweb.org/ontology/core#ResearcherRole"/>
        <rdfs:seeAlso rdf:resource="https://nfdi.fiz-karlsruhe.de/ontology/NFDI_0000004"/>
    </owl:Class>
    


    <!-- http://www.example.org/rirpdm#ScientificCase -->


    <owl:Class rdf:about="http://www.example.org/rirpdm#ScientificCase">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.example.org/rirpdm#hasEvaluation"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">6</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <terms:source>ESFRI Roadmap 2026</terms:source>
        <status>New</status>
        <rdfs:comment xml:lang="en">The six-dimension assessment of an RI&apos;s scientific merit, attached to a Proposal or Research Infrastructure.</rdfs:comment>
        <rdfs:label xml:lang="en">Scientific Case</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/rirpdm#ScientificDimension -->


    <owl:Class rdf:about="http://www.example.org/rirpdm#ScientificDimension">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.example.org/rirpdm#ENeedsAndData"/>
                    <rdf:Description rdf:about="http://www.example.org/rirpdm#EnvironmentalConsiderations"/>
                    <rdf:Description rdf:about="http://www.example.org/rirpdm#PanEuropeanRelevance"/>
                    <rdf:Description rdf:about="http://www.example.org/rirpdm#ScientificExcellence"/>
                    <rdf:Description rdf:about="http://www.example.org/rirpdm#SocioEconomicImpact"/>
                    <rdf:Description rdf:about="http://www.example.org/rirpdm#UserStrategyAndAccessPolicy"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <terms:source>ESFRI Roadmap 2026</terms:source>
        <status>New</status>
        <rdfs:comment xml:lang="en">One of the six dimensions along which a Scientific Case is assessed.</rdfs:comment>
        <rdfs:label xml:lang="en">Scientific Dimension</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/rirpdm#ScientificPublication -->


    <owl:Class rdf:about="http://www.example.org/rirpdm#ScientificPublication">
        <rdfs:subClassOf rdf:resource="http://purl.org/spar/fabio/Expression"/>
        <rdfs:subClassOf rdf:resource="http://www.example.org/rirpdm#ResearchOutput"/>
        <owl:hasKey rdf:parseType="Collection">
            <rdf:Description rdf:about="http://purl.org/spar/fabio/hasDOI"/>
        </owl:hasKey>
        <terms:source>EU Reg 2021 Art 2(22), Art 14(1)(a), Art 39(3)</terms:source>
        <status>New</status>
        <rdfs:comment xml:lang="en">A peer-reviewed publication output to which open access applies.</rdfs:comment>
        <rdfs:label xml:lang="en">Scientific Publication</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/IAO_0000311"/>
    </owl:Class>
    


    <!-- http://www.example.org/rirpdm#Score -->


    <owl:Class rdf:about="http://www.example.org/rirpdm#Score">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.example.org/rirpdm#High"/>
                    <rdf:Description rdf:about="http://www.example.org/rirpdm#Low"/>
                    <rdf:Description rdf:about="http://www.example.org/rirpdm#Medium"/>
                    <rdf:Description rdf:about="http://www.example.org/rirpdm#VeryHigh"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <terms:source>ESFRI Roadmap 2026</terms:source>
        <status>New</status>
        <rdfs:comment xml:lang="en">Grading attributed to a dimension.</rdfs:comment>
        <rdfs:label xml:lang="en">Score</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/rirpdm#SingleSitedRI -->


    <owl:Class rdf:about="http://www.example.org/rirpdm#SingleSitedRI">
        <rdfs:subClassOf rdf:resource="http://www.example.org/rirpdm#ResearchInfrastructure"/>
    </owl:Class>
    


    <!-- http://www.example.org/rirpdm#ThirdCountry -->


    <owl:Class rdf:about="http://www.example.org/rirpdm#ThirdCountry">
        <rdfs:subClassOf rdf:resource="http://www.example.org/rirpdm#Country"/>
        <terms:source>ESFRI Roadmap 2026</terms:source>
        <status>Extended</status>
        <rdfs:comment xml:lang="en">Country outside Member State / Associated Country.</rdfs:comment>
        <rdfs:label xml:lang="en">Third Country</rdfs:label>
    </owl:Class>
    


    <!-- http://www.example.org/rirpdm#VirtualRI -->


    <owl:Class rdf:about="http://www.example.org/rirpdm#VirtualRI">
        <rdfs:subClassOf rdf:resource="http://www.example.org/rirpdm#ResearchInfrastructure"/>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/org#Organization -->


    <owl:Class rdf:about="http://www.w3.org/ns/org#Organization">
        <rdfs:subClassOf rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
        <terms:source>W3C ORG</terms:source>
        <status>Adopted</status>
        <rdfs:label xml:lang="en">Organization</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://purl.obolibrary.org/obo/OBI_0000245"/>
    </owl:Class>
    


    <!-- http://xmlns.com/foaf/0.1/Agent -->


    <owl:Class rdf:about="http://xmlns.com/foaf/0.1/Agent">
        <terms:source>FOAF</terms:source>
        <status>Adopted</status>
        <rdfs:label xml:lang="en">Agent</rdfs:label>
